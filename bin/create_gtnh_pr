step_7() {
  local out="$TMPDIR_PRP/step7.out" sel
  while :; do
    sel=$(ui_menu "$(step_dtitle 7)" \
      "origin: ${C_C}$(git remote get-url origin 2>/dev/null || echo '-')${C_N}\nRepo:   ${REPO_SLUG:-unbekannt}\n\nNur beim allerersten PR pro Repo nötig — sonst überspringen." \
      "f" "7a) ✔ Fork anlegen / Remote einrichten (gh repo fork --remote=true)" \
      "s" "7b) Fork auf GitHub syncen (gh repo sync)" \
      "a" "7c) gh-Konto prüfen (gh auth status / login)" \
      "r" "7d) Remotes + Repo-Info anzeigen" \
      "k" "7e) Überspringen (Fork existiert schon) → Schritt 8" \
      "z" "↩ Zurück") || return 1
    case $sel in
      f)
        run_live "gh repo fork --remote=true" gh repo fork --remote=true && {
          refresh_state
          : >"$out"; cap "$out" git remote -v
          ui_textbox "$(step_dtitle 7) — Remotes jetzt" "$out"
          ui_msgbox "$(step_dtitle 7)" "${C_G}${ICON_OK} Fork/Remote eingerichtet.${C_N}" "Weiter"
          return 0
        }
        ui_msgbox "Fork" "Es lief nicht durch (siehe Terminal).\n\nOft hilft: Extras → gh-Konto → 'gh auth login'." "OK"
        continue ;;
      s) cmd_confirm_run "$(step_dtitle 7)" "$out" gh repo sync && return 0; continue ;;
      a)
        : >"$out"; cap "$out" gh auth status
        ui_textbox "gh auth status" "$out"
        if ui_yesno "Jetzt 'gh auth login' starten?" "gh-Konto" "Login starten" "Nein"; then
          run_live "gh auth login" gh auth login; refresh_state
        fi
        continue ;;
      r) : >"$out"; cap "$out" git remote -v; cap "$out" gh repo view; ui_textbox "Repo-Info" "$out"; continue ;;
      k) return 0 ;;
      z) return 1 ;;
    esac
  done
}

step_8() {
  local out="$TMPDIR_PRP/step8.out" sel branch="$CURRENT_BRANCH"
  if [[ $branch == "$DEFAULT_BRANCH" ]]; then
    ui_msgbox "Push" "${C_R}Du bist auf $DEFAULT_BRANCH!${C_N}\n\nPRs brauchen einen Feature-Branch — erst Schritt 2 ausführen." "OK"
    return 1
  fi
  while :; do
    sel=$(ui_menu "$(step_dtitle 8)" "Branch: ${C_C}$branch${C_N}\nUpstream: ${UPSTREAM:-keiner}   $AHEAD_BEHIND" \
      "p" "8a) ✔ Branch pushen (git push -u origin $branch)" \
      "u" "8b) Was ist gepusht, was nicht? (Status)" \
      "b" "8c) Branch auf GitHub im Browser öffnen (gh browse)" \
      "z" "↩ Zurück") || return 1
    case $sel in
      p)
        if has_changes && ! ui_yesno "Es gibt uncommittete Änderungen — die werden ${C_Y}NICHT${C_N} gepusht.\n\nTrotzdem pushen?" "Push" "Trotzdem" "Abbrechen"; then continue; fi
        run_live "git push -u origin $branch" git push -u origin "$branch" && {
          refresh_state
          ui_msgbox "$(step_dtitle 8)" "${C_G}${ICON_OK} Gepusht!${C_N}\n\nDank -u reicht ab jetzt 'git push'.\nWeiter mit Schritt 9 (gh pr create)." "Weiter"
          return 0
        }
        ui_msgbox "Push" "Fehlgeschlagen.\n\nPrüfe:\n• gh-Konto eingeloggt? (Extras → gh-Konto)\n• Fork vorhanden? (Schritt 7)\n• Netzwerk / SSH-Key" "OK"
        continue ;;
      u)
        : >"$out"; cap "$out" git status -sb
        cap "$out" git log --oneline '@{u}..HEAD' 2>/dev/null
        ui_textbox "Was ist (noch) nicht gepusht?" "$out"; continue ;;
      b) run_live "gh browse -b $branch" gh browse -b "$branch"; continue ;;
      z) return 1 ;;
    esac
  done
}

# ---------------------------------------------------------------- PR-Templates --
pr_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd
}

pr_template_files() {
  local root; root=$(pr_repo_root)
  local -a found=()
  local p f
  # GitHub unterstützt sowohl einen einzelnen Template-File als auch einen Ordner
  # mit mehreren Templates (dann kann man hier eines auswählen).
  for p in "$root/.github/PULL_REQUEST_TEMPLATE" "$root/.github/pull_request_template"; do
    [[ -d "$p" ]] || continue
    for f in "$p"/*; do
      [[ -f "$f" ]] && found+=("$f")
    done
  done
  for p in \
    "$root/.github/PULL_REQUEST_TEMPLATE.md" \
    "$root/.github/pull_request_template.md" \
    "$root/PULL_REQUEST_TEMPLATE.md" \
    "$root/pull_request_template.md" \
    "$root/docs/PULL_REQUEST_TEMPLATE.md" \
    "$root/docs/pull_request_template.md"; do
    [[ -f "$p" ]] && found+=("$p")
  done
  local -A seen=()
  for f in "${found[@]}"; do
    [[ -n "${seen[$f]:-}" ]] && continue
    seen[$f]=1
    printf '%s\n' "$f"
  done
}

pr_template_load() {  # $1=Quelle $2=Ziel; entfernt YAML-Frontmatter (wie GitHub)
  local src=$1 dst=$2
  if [[ $(head -n1 -- "$src") == "---" ]] && \
     awk 'NR>1 && $0=="---" {ok=1; exit} END {exit !ok}' "$src"; then
    awk 'NR>1 && $0=="---" && !done {done=1; next} done {print}' "$src" >"$dst"
    sed -i '1{/^$/d}' "$dst"
  else
    cp -- "$src" "$dst"
  fi
}

pr_template_meta() {  # $1=Datei $2=Key (labels/assignees) -> Wert, kommasepariert
  local file=$1 key=$2
  [[ $(head -n1 -- "$file") == "---" ]] || return 0
  awk -v k="$key" '
    NR == 1 { next }
    $0 == "---" { exit }
    {
      line = $0
      if (line ~ ("^" k "[ \t]*:")) {
        sub("^" k "[ \t]*:[ \t]*", "", line)
        print line
        exit
      }
    }
  ' "$file" | sed -e 's/^[[:space:]]*\[//' -e 's/\][[:space:]]*$//' -e "s/[\"']//g" \
                   -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
                   -e 's/[[:space:]]*,[[:space:]]*/,/g'
}

pr_org_template_fetch() {  # $1 = Zieldatei; 0 = Org-Template geladen
  local dest=$1 slug owner cache
  slug=${REPO_SLUG:-$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)}
  [[ -n "$slug" ]] || return 1
  # Bei einem Fork das Org-Template des Upstream-Repos nehmen.
  owner=$(gh api "repos/$slug" --jq '.parent.owner.login // .owner.login' 2>/dev/null)
  [[ -n "$owner" ]] || owner=${slug%%/*}
  [[ -n "$owner" ]] || return 1
  PR_ORG_LABEL="$owner/.github"
  cache="$TMPDIR_PRP/org_pr_template_${owner//\//_}.md"
  if [[ -s "$cache" ]]; then
    cp -- "$cache" "$dest"
    return 0
  fi
  if gh api "repos/$owner/.github/contents/.github/pull_request_template.md" \
       -H "Accept: application/vnd.github.raw" >"$cache" 2>/dev/null && [[ -s "$cache" ]]; then
    cp -- "$cache" "$dest"
    return 0
  fi
  rm -f "$cache" "$dest"
  return 1
}

pick_pr_template() {  # $1 = Body-Datei; setzt PR_TEMPLATE / PR_TEMPLATE_NAME
  local body=$1 root; root=$(pr_repo_root)
  local -a templates=()
  mapfile -t templates < <(pr_template_files)
  # Zusätzlich das Org-weite Default-Template aus <owner>/.github anbieten.
  local org_file="$TMPDIR_PRP/org_pr_template.md" org_ok=0
  pr_org_template_fetch "$org_file" && org_ok=1
  if (( ${#templates[@]} == 0 && !org_ok )); then
    ui_msgbox "PR-Template" "Keine PR-Templates gefunden.\n\nUnterstützt werden:\n• .github/PULL_REQUEST_TEMPLATE.md\n• .github/PULL_REQUEST_TEMPLATE/*.md\n• PULL_REQUEST_TEMPLATE.md\n• docs/PULL_REQUEST_TEMPLATE.md\n• Org-Template aus <owner>/.github" "OK"
    return 1
  fi
  local -a menu=("__none__" "Kein Template — Body unverändert lassen" "__empty__" "Body leeren")
  local i=0 f rel
  for f in "${templates[@]}"; do
    rel=${f#"$root"/}
    menu+=("$i" "$rel")
    ((i++))
  done
  if (( org_ok )); then
    menu+=("__org__" "Org-Template (remote: ${PR_ORG_LABEL:-${REPO_SLUG%%/*}/.github})")
  fi
  local sel
  sel=$(ui_menu "PR-Template wählen" "Template für den PR-Body (Repo: ${REPO_NAME:-?}):" "${menu[@]}") || return 1
  case $sel in
    __none__) return 1 ;;
    __empty__)
      : >"$body"; PR_TEMPLATE=""; PR_TEMPLATE_NAME=""
      PR_TEMPLATE_LABELS=""; PR_TEMPLATE_ASSIGNEES=""
      ui_msgbox "PR-Template" "Body geleert." "OK"
      return 0 ;;
    __org__)
      f="$org_file"; rel="Org-Template (remote: ${PR_ORG_LABEL:-${REPO_SLUG%%/*}/.github})" ;;
    *)
      f=${templates[$sel]}; rel=${f#"$root"/} ;;
  esac
  local preview="$TMPDIR_PRP/pr_template_preview.out" tmpbody="$TMPDIR_PRP/pr_template_body.md"
  local tlabels tassignees
  pr_template_load "$f" "$tmpbody"
  tlabels=$(pr_template_meta "$f" labels)
  tassignees=$(pr_template_meta "$f" assignees)
  { echo "Template: $rel"
    [[ -n "$tlabels" ]] && echo "Labels aus dem Template: $tlabels"
    [[ -n "$tassignees" ]] && echo "Assignees aus dem Template: $tassignees"
    echo; cat "$tmpbody"; } >"$preview"
  ui_textbox "PR-Template — Vorschau" "$preview" || return 1
  ui_yesno "Template '$rel' in den PR-Body übernehmen?\n\nDer aktuelle Body wird ersetzt." "PR-Template" "Übernehmen" "Abbrechen" || return 1
  cp -- "$tmpbody" "$body"
  PR_TEMPLATE="$f"
  PR_TEMPLATE_NAME="$rel"
  PR_TEMPLATE_LABELS="$tlabels"
  PR_TEMPLATE_ASSIGNEES="$tassignees"
  ui_msgbox "PR-Template" "${C_G}${ICON_OK} Template geladen:${C_N}\n$rel\n\nBody mit 9d/9e bearbeiten." "Weiter"
  return 0
}

step_9() {
  local title="" body="$TMPDIR_PRP/pr_body.md" out="$TMPDIR_PRP/step9.out"
  local sel osel BASE="$DEFAULT_BRANCH" DRAFT=0 ASSIGNEES="" REVIEWERS="" LABELS="" PR_TEMPLATE="" PR_TEMPLATE_NAME="" edited url
  if [[ $CURRENT_BRANCH == "$DEFAULT_BRANCH" ]]; then
    ui_msgbox "PR erstellen" "${C_R}Du bist auf $DEFAULT_BRANCH!${C_N}\n\nErst Schritt 2 (Branch) ausführen." "OK"; return 1
  fi
  if [[ ! -f "$body" ]]; then
    cat >"$body" <<'EOF'
Beschreibung der Änderung:

-

Test:

-

Closes #
EOF
  fi
  while [[ -z "${title// }" ]]; do
    title=$(ui_inputbox "$(step_dtitle 9)" "PR-Titel (kurz + beschreibend):" "$title") || return 1
    [[ -n "${title// }" ]] || ui_msgbox "PR" "Titel darf nicht leer sein." "OK"
  done
  while :; do
    local st="Basis: $BASE   ${SEP}   Draft: $([[ $DRAFT == 1 ]] && echo ja || echo nein)   ${SEP}   Template: ${PR_TEMPLATE_NAME:--}
Assignees: ${ASSIGNEES:--}   ${SEP}   Reviewer: ${REVIEWERS:--}   ${SEP}   Labels: ${LABELS:--}"
    sel=$(ui_menu "$(step_dtitle 9)" "Titel: ${C_C}$title${C_N}\n$st" \
      "k" "9a) ✔ PR jetzt erstellen (gh pr create)" \
      "v" "9b) Vorschau: Titel + Body + Befehl" \
      "t" "9c) Titel ändern" \
      "b" "9d) Body bearbeiten (TUI-Editor)" \
      "e" "9e) Body bearbeiten (nnvim/Editor — mehr Komfort)" \
      "d" "9f) Diff seit $BASE ansehen (das kommt in den PR)" \
      "o" "9g) Optionen: Basis / Draft / Assignees / Reviewer / Labels" \
      "p" "9h) PR-Template wählen${PR_TEMPLATE_NAME:+ (aktuell: $PR_TEMPLATE_NAME)}" \
      "z" "9i) ↩ Zurück") || return 1
    case $sel in
      t) title=$(ui_inputbox "$(step_dtitle 9)" "Neuer PR-Titel:" "$title") || continue ;;
      b) edited=$(dlg --title "PR-Body (TUI-Editor) — fertig: OK" --editbox "$body" "$(ui_h)" "$(ui_w)") \
           && printf '%s\n' "$edited" >"$body" ;;
      e) open_editor "$body" ;;
      d)
        { echo "══ Commits seit $BASE ══"; git --no-pager log --oneline "$BASE"..HEAD 2>/dev/null || git --no-pager log --oneline -10
          echo; echo "══ diff --stat ($BASE...HEAD) ══"; git --no-pager diff --stat "$BASE"...HEAD 2>/dev/null
          echo; echo "══ voller Diff ══"; git --no-pager diff --color=never "$BASE"...HEAD 2>/dev/null; } >"$out"
        ui_textbox "Was seit $BASE passiert ist" "$out" ;;
      o)
        while :; do
          osel=$(ui_menu "$(step_dtitle 9) — Optionen" "$st" \
            "b" "Basis-Branch ändern (aktuell: $BASE)" \
            "t" "Draft umschalten (aktuell: $([[ $DRAFT == 1 ]] && echo AN || echo aus))" \
            "a" "Assignees setzen (GitHub-Logins, kommasepariert)" \
            "r" "Reviewer setzen (GitHub-Logins/Teams, kommasepariert)" \
            "l" "Labels setzen (Namen, kommasepariert)" \
            "z" "↩ zurück") || break
          case $osel in
            b) BASE=$(ui_inputbox "Optionen" "Basis-Branch:" "$BASE") || true ;;
            t) DRAFT=$(( 1 - DRAFT )) ;;
            a) ASSIGNEES=$(ui_inputbox "Optionen" "Assignees (kommasepariert, @me erlaubt, leer = keine):" "$ASSIGNEES") || true
               ASSIGNEES=${ASSIGNEES//[[:space:]]/} ;;
            r) REVIEWERS=$(ui_inputbox "Optionen" "Reviewer (kommasepariert, org/team erlaubt, leer = keine):" "$REVIEWERS") || true
               REVIEWERS=${REVIEWERS//[[:space:]]/} ;;
            l) LABELS=$(ui_inputbox "Optionen" "Labels (kommasepariert, leer = keine):" "$LABELS") || true ;;
            z) break ;;
          esac
        done ;;
      p) pick_pr_template "$body" && {
           [[ -z "$ASSIGNEES" && -n "${PR_TEMPLATE_ASSIGNEES:-}" ]] && ASSIGNEES=$PR_TEMPLATE_ASSIGNEES
           [[ -z "$LABELS" && -n "${PR_TEMPLATE_LABELS:-}" ]] && LABELS=$PR_TEMPLATE_LABELS
           true
         } ;;
      v)
        { echo "══ TITEL ══"; echo "$title"; echo
          echo "══ TEMPLATE ══"; echo "${PR_TEMPLATE_NAME:--}"; echo
          echo "══ BODY ══"; cat "$body"; echo
          echo "══ BEFEHL ══"
          echo "gh pr create --title \"$title\" --body-file $body --base $BASE$([[ $DRAFT == 1 ]] && echo ' --draft')$([[ -n $ASSIGNEES ]] && echo " --assignee $ASSIGNEES")$([[ -n $REVIEWERS ]] && echo " --reviewer $REVIEWERS")"
          [[ -n "$LABELS" ]] && echo "gh pr edit --add-label \"$LABELS\"   (nach dem Erstellen)"
          echo; echo "══ Branch ══"; echo "$CURRENT_BRANCH  →  $BASE"; } >"$out"
        ui_textbox "PR-Vorschau" "$out" ;;
      k)
        if [[ -z "$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null)" ]]; then
          ui_yesno "Dein Branch hat keinen Upstream (noch nicht gepusht).\n\nErst Schritt 8 (Push) ausführen?" "Push nötig" "Zu Schritt 8" "Abbrechen" || continue
          step_8 || continue
        fi
        local args=(gh pr create --title "$title" --body-file "$body" --base "$BASE")
        [[ $DRAFT == 1 ]] && args+=(--draft)
        [[ -n "$ASSIGNEES" ]] && args+=(--assignee "$ASSIGNEES")
        [[ -n "$REVIEWERS" ]] && args+=(--reviewer "$REVIEWERS")
        ui_yesno "PR jetzt erstellen?\n\n${C_C}$(cmdline "${args[@]}")${C_N}" "$(step_dtitle 9)" "Erstellen" "Abbrechen" || continue
        if ! run_live "gh pr create" "${args[@]}"; then
          ui_msgbox "gh pr create" "Fehlgeschlagen (siehe Terminal).\n\nHäufig: Branch noch nicht gepusht (Schritt 8), gh nicht eingeloggt, oder für diesen Branch existiert schon ein PR (dann Schritt 10)." "OK"
          continue
        fi
        refresh_state
        if [[ -n "$LABELS" ]]; then
          : >"$out"; cap "$out" gh pr edit --add-label "$LABELS"
          ui_textbox "$(step_dtitle 9) — Labels setzen" "$out"
        fi
        url=$(gh pr view --json url -q .url 2>/dev/null)
        ui_msgbox "$(step_dtitle 9)" "${C_G}${ICON_OK} PR erstellt!${C_N}\n\n${url:-URL in Schritt 10 ansehen}" "Weiter"
        if ui_yesno "PR jetzt im Browser öffnen?" "PR" "Öffnen" "Nein"; then
          run_live "gh pr view --web" gh pr view --web
        fi
        return 0 ;;
      z) return 1 ;;
    esac
  done
}

STEP10_MERGED=0

step_10() {
  local out="$TMPDIR_PRP/step10.out" sel msel mode mfile="$TMPDIR_PRP/review.md"
  while :; do
    sel=$(ui_menu "$(step_dtitle 10)" "PR: ${C_C}$(pr_state_text)${C_N}   Branch: $CURRENT_BRANCH" \
      "v" "10a) PR ansehen (gh pr view)" \
      "k" "10b) Mit Kommentaren ansehen (gh pr view --comments)" \
      "d" "10c) Exakter PR-Diff von GitHub (gh pr diff)" \
      "s" "10d) Nur die Dateiliste im PR (gh pr diff --name-only)" \
      "c" "10e) CI-Checks ansehen (gh pr checks)" \
      "w" "10f) CI-Checks LIVE beobachten (gh pr checks --watch)" \
      "a" "10g) Actions/Workflows dieses Branches (gh run list)" \
      "r" "10h) Review abgeben (approve / comment / request-changes)" \
      "m" "10i) Kommentar schreiben (gh pr comment)" \
      "l" "10j) Labels / Assignees / Reviewer ändern (gh pr edit)" \
      "y" "10k) Ready / Draft umschalten (gh pr ready)" \
      "b" "10l) Im Browser öffnen (gh pr view --web)" \
      "S" "10m) gh pr status (deine PRs in diesem Repo)" \
      "M" "10n) ★ PR MERGEN (gh pr merge) — erst nach dem Review!" \
      "x" "10o) PR schließen / wieder öffnen" \
      "f" "10p) ✔ Fertig – weiter zu Schritt 11" \
      "z" "↩ Zurück") || return 1
    case $sel in
      v) : >"$out"; cap "$out" gh pr view; ui_textbox "gh pr view" "$out" ;;
      k) : >"$out"; cap "$out" gh pr view --comments; ui_textbox "PR + Kommentare" "$out" ;;
      d) : >"$out"; cap "$out" gh pr diff; ui_textbox "PR-Diff (von GitHub — exakt das, was der PR ändert)" "$out" ;;
      s) : >"$out"; cap "$out" gh pr diff --name-only; ui_textbox "Dateien im PR" "$out" ;;
      c) : >"$out"; cap "$out" gh pr checks; ui_textbox "CI-Checks (grün = ok, - = pending, X = fail)" "$out" ;;
      w) run_live "gh pr checks --watch (Ctrl-C beendet)" gh pr checks --watch ;;
      a) : >"$out"; cap "$out" gh run list --branch "$CURRENT_BRANCH" --limit 15; ui_textbox "Actions für $CURRENT_BRANCH" "$out" ;;
      r)
        msel=$(ui_menu "$(step_dtitle 10) — Review" "Was für ein Review willst du abgeben?" \
          "a" "Approven (gh pr review --approve)" \
          "c" "Nur kommentieren (gh pr review --comment)" \
          "r" "Changes anfordern (gh pr review --request-changes)" \
          "z" "↩ zurück") || continue
        case $msel in
          a) mode=--approve ;; c) mode=--comment ;; r) mode=--request-changes ;; z) continue ;; esac
        printf 'Dein Review-Text (leer lassen = ohne Text):\n' >"$mfile"
        open_editor "$mfile"
        run_live "gh pr review $mode" gh pr review "$mode" -F "$mfile" ;;
      m)
        printf 'Dein Kommentar:\n' >"$mfile"
        open_editor "$mfile"
        run_live "gh pr comment" gh pr comment -F "$mfile" ;;
      l)
        msel=$(ui_menu "$(step_dtitle 10) — Labels / Assignees / Reviewer" "Was ändern?" \
          "a" "Label hinzufügen" \
          "r" "Label entfernen" \
          "A" "Assignee hinzufügen (Login oder @me)" \
          "R" "Assignee entfernen (Login oder @me)" \
          "v" "Reviewer anfordern (Login oder org/team)" \
          "V" "Reviewer entfernen (Login oder org/team)" \
          "m" "Mir selbst zuweisen (--add-assignee @me)" \
          "z" "↩ zurück") || continue
        case $msel in
          a) local lb; lb=$(label_picker multi) || continue
             [[ -n $lb ]] && { : >"$out"; cap "$out" gh pr edit --add-label "$lb"; ui_textbox "Labels hinzugefügt" "$out"; } ;;
          r) local lb2; lb2=$(label_picker multi) || continue
             [[ -n $lb2 ]] && { : >"$out"; cap "$out" gh pr edit --remove-label "$lb2"; ui_textbox "Labels entfernt" "$out"; } ;;
          A) local as; as=$(ui_inputbox "Assignee hinzufügen" "GitHub-Login (oder @me):" "") || continue
             as=${as//[[:space:]]/}
             [[ -n $as ]] && { : >"$out"; cap "$out" gh pr edit --add-assignee "$as"; ui_textbox "Assignee hinzugefügt" "$out"; } ;;
          R) local as2; as2=$(ui_inputbox "Assignee entfernen" "GitHub-Login (oder @me):" "") || continue
             as2=${as2//[[:space:]]/}
             [[ -n $as2 ]] && { : >"$out"; cap "$out" gh pr edit --remove-assignee "$as2"; ui_textbox "Assignee entfernt" "$out"; } ;;
          v) local rv; rv=$(ui_inputbox "Reviewer anfordern" "GitHub-Login oder org/team (kommasepariert):" "") || continue
             rv=${rv//[[:space:]]/}
             [[ -n $rv ]] && { : >"$out"; cap "$out" gh pr edit --add-reviewer "$rv"; ui_textbox "Reviewer angefordert" "$out"; } ;;
          V) local rv2; rv2=$(ui_inputbox "Reviewer entfernen" "GitHub-Login oder org/team (kommasepariert):" "") || continue
             rv2=${rv2//[[:space:]]/}
             [[ -n $rv2 ]] && { : >"$out"; cap "$out" gh pr edit --remove-reviewer "$rv2"; ui_textbox "Reviewer entfernt" "$out"; } ;;
          m) : >"$out"; cap "$out" gh pr edit --add-assignee @me; ui_textbox "Assignee" "$out" ;;
          z) continue ;;
        esac ;;
      y)
        if pr_state_text | grep -q '\[OPEN\]'; then
          msel=$(ui_menu "$(step_dtitle 10)" "Ready/Draft umschalten" "r" "Review-ready markieren (gh pr ready)" "d" "Zurück in Draft (gh pr ready --undo)" "z" "↩ zurück") || continue
          case $msel in
            r) run_live "gh pr ready" gh pr ready ;;
            d) run_live "gh pr ready --undo" gh pr ready --undo ;;
            z) continue ;;
          esac
        else
          ui_msgbox "Ready/Draft" "Kein offener PR für diesen Branch gefunden." "OK"
        fi ;;
      b) run_live "gh pr view --web" gh pr view --web ;;
      S) : >"$out"; cap "$out" gh pr status; ui_textbox "gh pr status" "$out" ;;
      M)
        msel=$(ui_menu "$(step_dtitle 10) — Merge" "Merge-Methode wählen?" \
          "m" "Merge-Commit (--merge)" \
          "s" "Squash (--squash)" \
          "r" "Rebase (--rebase)" \
          "z" "↩ zurück") || continue
        case $msel in
          m) mode=--merge ;; s) mode=--squash ;; r) mode=--rebase ;; z) continue ;; esac
        local dargs=()
        if ui_yesno "Branch nach dem Merge löschen?\n\n(gh macht das mit --delete-branch)" "Merge" "Ja, löschen" "Nein, behalten"; then
          dargs+=(--delete-branch)
        fi
        if ui_yesno "PR jetzt mit '${mode#--}' mergen?\n\nDanach: Schritt 11 wird übersprungen, in Schritt 12 wird aufgeräumt." "Merge bestätigen" "MERGEN" "Abbrechen"; then
          if run_live "gh pr merge $mode" gh pr merge "$mode" "${dargs[@]}"; then
            STEP10_MERGED=1; refresh_state
            ui_msgbox "$(step_dtitle 10)" "${C_G}${ICON_OK} PR gemergt!${C_N}\n\nSchritt 11 (update-branch) ist damit hinfällig — es geht direkt zu Schritt 12." "Weiter"
            return 0
          fi
          ui_msgbox "Merge" "Merge abgebrochen/fehlgeschlagen (siehe Terminal).\n\nHäufig: Checks noch rot, Review fehlt, oder Konflikte (dann Schritt 11)." "OK"
        fi ;;
      x)
        msel=$(ui_menu "$(step_dtitle 10)" "PR-Zustand ändern" "c" "Schließen (gh pr close)" "o" "Wieder öffnen (gh pr reopen)" "z" "↩ zurück") || continue
        case $msel in
          c) cmd_confirm_run "$(step_dtitle 10)" "$out" gh pr close ;;
          o) cmd_confirm_run "$(step_dtitle 10)" "$out" gh pr reopen ;;
          z) continue ;;
        esac ;;
      f) return 0 ;;
      z) return 1 ;;
    esac
  done
}

step_11() {
  local out="$TMPDIR_PRP/step11.out" sel fsel
  if [[ ${STEP10_MERGED:-0} == 1 ]]; then
    ui_msgbox "$(step_dtitle 11)" "Der PR wurde in dieser Sitzung gemergt — Schritt 11 ist damit erledigt." "Weiter"
    return 0
  fi
  while :; do
    sel=$(ui_menu "$(step_dtitle 11)" "PR: ${C_C}$(pr_state_text)${C_N}   Branch: $CURRENT_BRANCH   $AHEAD_BEHIND" \
      "u" "11a) gh pr update-branch — $DEFAULT_BRANCH in den PR mergen (auf GitHub)" \
      "r" "11b) gh pr update-branch --rebase — Rebase (sauber, History wird umgeschrieben)" \
      "l" "11c) Lokalen Branch an den Remote-Stand angleichen (nach 11a/11b)" \
      "g" "11d) Klassisch lokal: merge/rebase + push (Fallback ohne PR)" \
      "s" "11e) Status: lokal / remote / Basis vergleichen" \
      "z" "↩ Zurück") || return 1
    case $sel in
      u)
        : >"$out"
        if ! cap "$out" gh pr update-branch; then
          ui_textbox "gh pr update-branch" "$out"
          ui_msgbox "Update-Branch" "Fehlgeschlagen.\n\nHäufig: Konflikte (dann 11b oder 11d), keine Berechtigung, oder der Branch ist schon aktuell." "OK"
          continue
        fi
        ui_textbox "gh pr update-branch — Ausgabe" "$out"
        if ui_yesno "Lokalen Branch jetzt angleichen (git pull --ff-only)?" "Lokal angleichen" "Ja" "Später"; then
          sync_local_branch ff && return 0 || continue
        fi
        return 0 ;;
      r)
        : >"$out"
        if ! cap "$out" gh pr update-branch --rebase; then
          ui_textbox "gh pr update-branch --rebase" "$out"
          ui_msgbox "Rebase" "Fehlgeschlagen (oft Konflikte).\n\nAlternative: 11d (klassisch lokal rebasen) — dann bleiben Konflikte lokal und du kannst sie in Ruhe lösen." "OK"
          continue
        fi
        ui_textbox "Rebase auf GitHub — Ausgabe" "$out"
        if ui_yesno "Lokalen Branch jetzt angleichen?\n\nAchtung: nach dem Rebase wurde die History umgeschrieben → ${C_R}git reset --hard${C_N} (nur wenn nichts Uncommittetes da ist)." "Lokal angleichen" "Ja" "Später"; then
          sync_local_branch reset && return 0 || continue
        fi
        return 0 ;;
      l)
        fsel=$(ui_menu "$(step_dtitle 11)" "Wie angleichen?" \
          "f" "Fast-forward (git pull --ff-only) — normaler Fall" \
          "r" "Hart (git fetch + git reset --hard origin/$CURRENT_BRANCH) — nach Rebase" \
          "z" "↩ zurück") || continue
        case $fsel in
          f) sync_local_branch ff && return 0 ;;
          r) sync_local_branch reset && return 0 ;;
          z) continue ;;
        esac ;;
      g)
        fsel=$(ui_menu "$(step_dtitle 11) — klassisch lokal" "Was tun? (alles lokal, ohne gh)" \
          "m" "git merge $DEFAULT_BRANCH → push (harmlos, kein Force)" \
          "r" "git rebase $DEFAULT_BRANCH → push --force-with-lease (saubere History)" \
          "z" "↩ zurück") || continue
        case $fsel in
          m) local_update_merge && return 0 ;;
          r) local_update_rebase && return 0 ;;
          z) continue ;;
        esac ;;
      s)
        { echo "══ lokal ══"; git_status_short; echo
          echo "══ Branch-Stände ══"; git --no-pager branch -vv | head -n 20; echo
          echo "══ PR ══"; gh pr view --json number,state,mergeable,baseRefName,headRefName -q '"#\(.number) [\(.state)] \(.headRefName) → \(.baseRefName)  mergeable: \(.mergeable)"' 2>&1
          echo; echo "══ Commits im Branch, die $DEFAULT_BRANCH nicht hat ══"
          git --no-pager log --oneline "origin/$DEFAULT_BRANCH..HEAD" 2>/dev/null | head -n 20; } >"$out"
        ui_textbox "Status Schritt 11" "$out" ;;
      z) return 1 ;;
    esac
  done
}

sync_local_branch() {  # ff|reset
  local out="$TMPDIR_PRP/sync11.out" mode=$1
  if [[ $mode == ff ]]; then
    cmd_confirm_run "Lokal angleichen (ff-only)" "$out" git pull --ff-only origin "$CURRENT_BRANCH" && { refresh_state; ui_msgbox "Lokal angleichen" "${C_G}${ICON_OK} Lokaler Branch ist wieder synchron.${C_N}" "OK"; return 0; }
    ui_msgbox "Lokal angleichen" "Fast-forward ging nicht (z. B. nach Rebase nötig: 11c → hart)." "OK"
    return 1
  fi
  if has_changes; then
    ui_msgbox "Hart angleichen" "${C_R}Geht nicht:${C_N} du hast uncommittete Änderungen.\n\nErst committen (Schritt 6) oder verwerfen, danach erneut versuchen." "OK"
    return 1
  fi
  if ui_yesno "${C_R}ACHTUNG:${C_N} git reset --hard origin/$CURRENT_BRANCH\n\nLokale Commits/Änderungen auf diesem Branch gehen VERLOREN (nur die vom Remote bleiben).\n\nWirklich?" "Hart angleichen" "Ja, hart" "Abbrechen"; then
    : >"$out"
    cap "$out" git fetch origin
    cap "$out" git reset --hard "origin/$CURRENT_BRANCH"
    refresh_state
    ui_textbox "git reset --hard — Ausgabe" "$out"
    return 0
  fi
  return 1
}

local_update_merge() {
  local out="$TMPDIR_PRP/merge11.out"
  : >"$out"
  cap "$out" git fetch origin || { ui_textbox "Merge (lokal)" "$out"; ui_msgbox "Merge" "fetch fehlgeschlagen." "OK"; return 1; }
  refresh_state
  cap "$out" git checkout "$DEFAULT_BRANCH" || { ui_textbox "Merge (lokal)" "$out"; return 1; }
  cap "$out" git pull origin "$DEFAULT_BRANCH" || { ui_textbox "Merge (lokal)" "$out"; return 1; }
  cap "$out" git checkout "$CURRENT_BRANCH" || { ui_textbox "Merge (lokal)" "$out"; return 1; }
  if ! cap "$out" git merge "$DEFAULT_BRANCH"; then
    ui_textbox "Merge-Konflikt!" "$out"
    ui_msgbox "Merge-Konflikt" "Konflikte lösen:\n\n1. Schritt 3: in nnvim bearbeiten\n2. Schritt 4: Dateien stagen\n3. Schritt 6: Commit — schließt den Merge ab\n\nAbbrechen: git merge --abort (Terminal über Schritt 3e)" "OK"
    return 1
  fi
  ui_textbox "Merge erfolgreich" "$out"
  if ui_yesno "Jetzt pushen? (harmlos, kein Force)" "Push" "Pushen" "Nein"; then
    run_live "git push" git push || return 1
  fi
  refresh_state
  return 0
}

local_update_rebase() {
  local out="$TMPDIR_PRP/rebase11.out"
  : >"$out"
  cap "$out" git fetch origin || { ui_textbox "Rebase (lokal)" "$out"; return 1; }
  refresh_state
  cap "$out" git checkout "$DEFAULT_BRANCH" || { ui_textbox "Rebase (lokal)" "$out"; return 1; }
  cap "$out" git pull origin "$DEFAULT_BRANCH" || { ui_textbox "Rebase (lokal)" "$out"; return 1; }
  cap "$out" git checkout "$CURRENT_BRANCH" || { ui_textbox "Rebase (lokal)" "$out"; return 1; }
  if ! cap "$out" git rebase "$DEFAULT_BRANCH"; then
    ui_textbox "Rebase angehalten (Konflikte)" "$out"
    ui_msgbox "Rebase-Konflikt" "Konflikte lösen:\n\n• Schritt 3e: Shell öffnen\n• git status zeigt die Dateien\n• lösen → git add <datei> → git rebase --continue\n• ganz abbrechen: git rebase --abort" "OK"
    return 1
  fi
  ui_textbox "Rebase erfolgreich" "$out"
  if ui_yesno "Jetzt pushen? ${C_Y}--force-with-lease${C_N} (NIEMALS --force pur!)" "Force-with-lease" "Pushen" "Nein"; then
    run_live "git push --force-with-lease" git push --force-with-lease || return 1
  fi
  refresh_state
  return 0
}

step_12() {
  local out="$TMPDIR_PRP/step12.out" sel b args=() rem
  while :; do
    sel=$(ui_menu "$(step_dtitle 12)" "PR: ${C_C}$(pr_state_text)${C_N}   Branch: $CURRENT_BRANCH" \
      "s" "12a) Status: PR gemergt? Branch-Stände? anzeigen" \
      "y" "12b) Fork mit Upstream synchronisieren (gh repo sync)" \
      "d" "12c) Standard-Branch lokal aktualisieren (fetch/checkout/pull)" \
      "l" "12d) Feature-Branch lokal löschen" \
      "r" "12e) Feature-Branch im Fork (remote) löschen" \
      "w" "12f) ✔ Fertig – Aufräumen abgeschlossen" \
      "z" "↩ Zurück") || return 1
    case $sel in
      s)
        { echo "══ PR ══"
          gh pr view --json number,state,mergedAt,url -q 'if .number then "#\(.number) [\(.state)]  merged: \(.mergedAt // "nein")\n\(.url)" else "kein PR für diesen Branch" end' 2>&1
          echo; echo "══ Branches ══"; git --no-pager branch -vv | head -n 20
          echo; echo "══ Status ══"; git_status_short; } >"$out"
        ui_textbox "Status Schritt 12" "$out" ;;
      y) cmd_confirm_run "$(step_dtitle 12)" "$out" gh repo sync; refresh_state ;;
      d)
        if ui_yesno "Standard-Branch lokal aktualisieren (fetch → checkout $DEFAULT_BRANCH → pull)?" "$(step_dtitle 12)" "Ausführen" "Abbrechen"; then
          if run_local_update "$out"; then
            ui_textbox "Update-Ausgabe" "$out"
            ui_msgbox "$(step_dtitle 12)" "${C_G}${ICON_OK} $DEFAULT_BRANCH ist aktuell.${C_N}" "Weiter"
          else
            ui_textbox "Update-Ausgabe" "$out"
            ui_msgbox "Update" "Fehlgeschlagen — Ausgabe lesen (uncommittete Änderungen? Konflikt?)." "OK"
          fi
        fi ;;
      l)
        args=()
        while IFS= read -r b; do
          [[ $b == "$DEFAULT_BRANCH" || $b == main || $b == "$CURRENT_BRANCH" ]] && continue
          args+=("$b" "$b")
        done < <(git for-each-ref --format='%(refname:short)' refs/heads | sort)
        if (( ${#args[@]} == 0 )); then
          ui_msgbox "Branch löschen" "Kein Feature-Branch zum Löschen gefunden (nur $DEFAULT_BRANCH vorhanden)." "OK"; continue
        fi
        b=$(ui_menu "$(step_dtitle 12)" "Welchen Branch lokal löschen?" "${args[@]}") || continue
        if ! cap "$out" git branch -d "$b"; then
          ui_textbox "git branch -d $b" "$out"
          if ui_yesno "Der Branch ist ${C_Y}nicht vollständig gemergt${C_N}.\n\nMit -D trotzdem löschen? (ungemergte Commits gehen verloren!)" "Löschen erzwingen" "Ja, -D" "Nein"; then
            cmd_confirm_run "$(step_dtitle 12)" "$out" git branch -D "$b"
          fi
        else
          ui_textbox "Branch gelöscht" "$out"
        fi ;;
      r)
        args=()
        rem=$(git ls-remote --heads origin 2>/dev/null | sed 's#.*refs/heads/##' | grep -v "^$DEFAULT_BRANCH$" || true)
        while IFS= read -r b; do [[ -n "$b" ]] && args+=("$b" "$b"); done <<<"$rem"
        if (( ${#args[@]} == 0 )); then ui_msgbox "Remote-Branch" "Im Fork (origin) gibt es keinen passenden Remote-Branch mehr." "OK"; continue; fi
        b=$(ui_menu "$(step_dtitle 12)" "Welchen Branch im Fork (origin) löschen?" "${args[@]}") || continue
        if [[ -z "$REPO_SLUG" ]]; then
          ui_msgbox "Remote-Branch" "Repo-Slug unbekannt (gh nicht eingeloggt?).\n\nAlternative per git:\n  git push origin --delete $b" "OK"; continue
        fi
        if ui_yesno "Remote-Branch ${C_C}$b${C_N} in ${REPO_SLUG} löschen?" "Remote-Branch löschen" "Löschen" "Abbrechen"; then
          cmd_confirm_run "$(step_dtitle 12)" "$out" gh api --method DELETE "repos/$REPO_SLUG/git/refs/heads/$b" \
            || ui_msgbox "Remote-Branch" "gh api ging nicht (Rechte? schon weg?).\n\nAlternative: git push origin --delete $b" "OK"
        fi ;;
      w) return 0 ;;
      z) return 1 ;;
    esac
  done
}

# ============================================================================
#  GH-ALLROUNDER  (Extras)
# ============================================================================

extras_menu() {
  local sel
  while :; do
    sel=$(ui_menu "Extras — GitHub-Allrounder" "Repo: ${REPO_SLUG:-?}   ${SEP}   Branch: $CURRENT_BRANCH   ${SEP}   Basis: $DEFAULT_BRANCH" \
      "i" "Issues: browsen, ansehen, kommentieren, Labels, Meilensteine" \
      "p" "Pull Requests: browsen, ansehen, auschecken, bearbeiten, mergen" \
      "a" "Actions/CI: Runs, Logs, LIVE watch, rerun, Artefakte" \
      "W" "★ Workflows: manuell starten (mit Inputs), aktivieren/deaktivieren" \
      "E" "★ Releases: ansehen, erstellen, bearbeiten, Assets" \
      "G" "★ Gists: ansehen, erstellen, bearbeiten, klonen" \
      "N" "★ Benachrichtigungen (GitHub-Postfach)" \
      "l" "Labels: verwalten (Liste, erstellen, bearbeiten)" \
      "b" "🌿 Branches (wechseln, mergen, löschen, Upstream)" \
      "T" "🏷️ Tags (pushen, löschen, Release anlegen)" \
      "j" "★ git-Werkzeuge: Stash, Reflog, Reparatur, Worktrees, Historie" \
      "U" "★ GitHub vertieft: PR-Analyse, Dashboards, Security, API" \
      "H" "★ Commit-/History-Browser (show, cherry-pick, checkout)" \
      "V" "★ Zwei Refs vergleichen (Diff A ↔ B)" \
      "F" "★ Text finden: git grep, Pickaxe (git log -S), Dateisuche" \
      "X" "★ Secrets & Variablen (Actions)" \
      "Y" "★ gh-Setup: SSH/GPG-Keys, Aliases, Extensions, Config" \
      "R" "Remote-Tree: Dateien im Repo auf GitHub browsen" \
      "o" "Lokaler Datei-Browser (mit nnvim-Integration)" \
      "M" "Markdown-Viewer (.md lokal + remote, mit Vorschau)" \
      "S" "Suche: Issues / PRs / Code / Repos (gh search)" \
      "D" "Übersicht: Status, Diffs, Commits, Branches (lokal)" \
      "K" "gh-Konto: auth status / login" \
      "C" "PR-Checkliste anzeigen ($(basename "$CHECKLIST"))" \
      "!" "Shell im Repo öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      i) issues_menu ;;
      p) prs_menu ;;
      a) actions_menu ;;
      W) workflow_menu ;;
      E) releases_menu ;;
      G) gists_menu ;;
      N) notifications_menu ;;
      l) labels_menu ;;
      b) branches_menu ;;
      T) tags_menu ;;
      j) git_tools_menu ;;
      U) github_deep_menu ;;
      H) commit_browser ;;
      V) ref_compare ;;
      F) git_find ;;
      X) secrets_menu ;;
      Y) gh_setup_menu ;;
      R) remote_browser ;;
      o) local_browser ;;
      M) md_viewer ;;
      S) search_menu ;;
      D) local_overview ;;
      K) auth_menu ;;
      C) show_checklist ;;
      "!") run_live "Shell im Repo ($PWD) — 'exit' kommt zurück" "${SHELL:-/bin/bash}" ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Issues
# ----------------------------------------------------------------------------

issue_browse() {
  local sel n
  sel=$(gh issue list --limit 60 "$@" --json number,title,labels \
        --jq '.[] | "\(.number)\t[\(.labels|map(.name)|join(","))] \(.title)"' 2>/dev/null \
      | fzf_num 'ENTER = Issue ansehen  |  CTRL-C = zurück' 'GH_PAGER=cat gh issue view {1} --comments')
  [[ -z "$sel" ]] && return
  n=${sel%%$'\t'*}
  [[ $n =~ ^[0-9]+$ ]] && issue_detail "$n"
}

issue_create() {
  local title="" body="$TMPDIR_PRP/issue_body.md" lb="" sel edited l2
  while [[ -z "${title// }" ]]; do
    title=$(ui_inputbox "Neues Issue" "Issue-Titel:" "$title") || return
    [[ -n "${title// }" ]] || ui_msgbox "Issue" "Titel darf nicht leer sein." "OK"
  done
  printf 'Beschreibung:\n\n\n' >"$body"
  while :; do
    sel=$(ui_menu "Neues Issue" "Titel: ${C_C}$title${C_N}\nLabels: ${lb:-keine}" \
      "b" "Body bearbeiten (TUI-Editor)" \
      "e" "Body bearbeiten (nnvim/Editor)" \
      "l" "Labels wählen (gh label list)" \
      "k" "✔ Issue erstellen (gh issue create)" \
      "z" "↩ abbrechen") || return
    case $sel in
      b) edited=$(dlg --title "Issue-Body (TUI-Editor) — fertig: OK" --editbox "$body" "$(ui_h)" "$(ui_w)") && printf '%s\n' "$edited" >"$body" ;;
      e) open_editor "$body" ;;
      l) l2=$(label_picker multi) && lb=$l2 ;;
      k)
        local args=(gh issue create --title "$title" --body-file "$body")
        [[ -n "$lb" ]] && args+=(--label "$lb")
        if run_live "gh issue create" "${args[@]}"; then
          ui_msgbox "Issue" "${C_G}${ICON_OK} Issue erstellt!${C_N}" "Weiter"; return
        fi
        ui_msgbox "Issue" "Fehlgeschlagen (siehe Terminal)." "OK" ;;
      z) return ;;
    esac
  done
}

issue_detail() {
  local n=$1 out="$TMPDIR_PRP/issue.out" sel lb f="$TMPDIR_PRP/issue_comment.md"
  while :; do
    sel=$(ui_menu "Issue #$n" "$(gh issue view "$n" --json title,state,labels,author,assignees \
        --jq '"\(.title)\nStatus: \(.state)   Autor: \(.author.login)\nLabels: \(.labels|map(.name)|join(", "))\nAssignee: \(.assignees|map(.login)|join(", "))"' 2>/dev/null || echo '(Issue konnte nicht geladen werden — gh-Konto ok?)')" \
      "v" "Mit Kommentaren ansehen (gh issue view --comments)" \
      "k" "Kommentar schreiben (gh issue comment)" \
      "l" "Labels ändern (gh issue edit)" \
      "e" "Titel / Body bearbeiten (gh issue edit)" \
      "m" "Meilenstein setzen (gh issue edit --milestone)" \
      "a" "Assignee: mir zuweisen / entfernen" \
      "c" "Schließen (gh issue close)" \
      "o" "Wieder öffnen (gh issue reopen)" \
      "b" "Im Browser öffnen (gh issue view --web)" \
      "z" "↩ zurück") || return 0
    case $sel in
      v) : >"$out"; cap "$out" gh issue view "$n" --comments; ui_textbox "Issue #$n" "$out" ;;
      k) printf 'Dein Kommentar zu #%s:\n' "$n" >"$f"; open_editor "$f"
         run_live "gh issue comment $n" gh issue comment "$n" -F "$f" ;;
      l) label_edit "Issue #$n" gh issue edit "$n" ;;
      e) lb=$(ui_menu "Issue #$n bearbeiten" "" \
           "t" "Titel ändern (gh issue edit --title)" \
           "b" "Body bearbeiten (Editor → --body-file)" \
           "z" "↩ zurück") || continue
         case $lb in
           t) local tt; tt=$(gh issue view "$n" --json title -q .title 2>/dev/null)
              tt=$(ui_inputbox "Issue-Titel" "Neuer Titel:" "$tt") || continue
              cmd_confirm_run "Titel ändern" "$out" gh issue edit "$n" --title "$tt" ;;
           b) gh issue view "$n" --json body -q .body >"$TMPDIR_PRP/issue_body_edit.md" 2>/dev/null || : >"$TMPDIR_PRP/issue_body_edit.md"
              open_editor "$TMPDIR_PRP/issue_body_edit.md"
              cmd_confirm_run "Body aktualisieren" "$out" gh issue edit "$n" --body-file "$TMPDIR_PRP/issue_body_edit.md" ;;
           z) continue ;;
         esac ;;
      m) local ms; ms=$(milestone_picker) || continue; [[ -z "$ms" ]] && continue
         cmd_confirm_run "Meilenstein setzen" "$out" gh issue edit "$n" --milestone "$ms" ;;
      a) lb=$(ui_menu "Assignee #$n" "" "a" "Mir zuweisen (@me)" "r" "Mir entfernen (@me)" "z" "↩ zurück") || continue
         case $lb in
           a) : >"$out"; cap "$out" gh issue edit "$n" --add-assignee @me; ui_textbox "Assignee" "$out" ;;
           r) : >"$out"; cap "$out" gh issue edit "$n" --remove-assignee @me; ui_textbox "Assignee" "$out" ;;
           z) continue ;;
         esac ;;
      c) cmd_confirm_run "Issue #$n schließen" "$out" gh issue close "$n" ;;
      o) cmd_confirm_run "Issue #$n öffnen" "$out" gh issue reopen "$n" ;;
      b) run_live "gh issue view $n --web" gh issue view "$n" --web ;;
      z) return 0 ;;
    esac
  done
}

milestone_picker() {
  local sel
  [[ -z "$REPO_SLUG" ]] && return 1
  sel=$(gh api "repos/$REPO_SLUG/milestones?state=open&per_page=50" --jq '.[].title' 2>/dev/null \
      | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --header 'Meilenstein wählen (ENTER)')
  [[ -z "$sel" ]] && return 1
  printf '%s' "$sel"
}

issues_menu() {
  local sel n q lb ms
  while :; do
    sel=$(ui_menu "Issues (gh)" "Repo: ${REPO_SLUG:-?}" \
      "o" "Offene Issues (gh issue list → fzf-Auswahl, Vorschau)" \
      "g" "Geschlossene Issues" \
      "a" "Alle Issues" \
      "s" "Issues suchen (Volltext)" \
      "l" "Nach Label filtern (Label-Picker)" \
      "m" "Nach Meilenstein filtern" \
      "n" "★ Neues Issue erstellen (gh issue create)" \
      "v" "Issue nach Nummer öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      o) issue_browse ;;
      g) issue_browse --state closed ;;
      a) issue_browse --state all ;;
      l) lb=$(label_picker one) || continue; [[ -z "$lb" ]] && continue
         issue_browse --label "$lb" ;;
      m) ms=$(milestone_picker) || continue; [[ -z "$ms" ]] && continue
         issue_browse --milestone "$ms" ;;
      s) q=$(ui_inputbox "Issues suchen" "Suchtext (z. B. crash, mapiary):") || continue
         [[ -z "$q" ]] && continue
         sel=$(gh issue list --limit 60 --search "$q" --json number,title,labels \
               --jq '.[] | "\(.number)\t[\(.labels|map(.name)|join(","))] \(.title)"' 2>/dev/null \
             | fzf_num "Suchergebnisse für: $q" 'GH_PAGER=cat gh issue view {1} --comments')
         [[ -z "$sel" ]] && continue
         n=${sel%%$'\t'*}; [[ $n =~ ^[0-9]+$ ]] && issue_detail "$n" ;;
      n) issue_create ;;
      v) n=$(ask_number "Issue-Nummer:" "Issue öffnen") || continue; issue_detail "$n" ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Pull Requests (browsen + auschecken)
# ----------------------------------------------------------------------------

pr_browse() {
  local sel n
  sel=$(gh pr list --limit 60 "$@" --json number,title,headRefName,isDraft,state \
        --jq '.[] | "\(.number)\t[\(.state|ascii_downcase)\(if .isDraft then ",draft" else "" end)] \(.headRefName): \(.title)"' 2>/dev/null \
      | fzf_num 'ENTER = PR ansehen  |  CTRL-C = zurück' 'GH_PAGER=cat gh pr view {1} --comments')
  [[ -z "$sel" ]] && return
  n=${sel%%$'\t'*}
  [[ $n =~ ^[0-9]+$ ]] && pr_detail "$n"
}

pr_detail() {
  local n=$1 out="$TMPDIR_PRP/pr.out" sel mode f="$TMPDIR_PRP/pr_comment.md" dargs=() titlef="$TMPDIR_PRP/pr_edit_body.md"
  while :; do
    sel=$(ui_menu "PR #$n" "$(gh pr view "$n" --json title,state,headRefName,baseRefName,author,isDraft \
        --jq '"\(.title)\n[\(.state)\(if .isDraft then ", DRAFT" else "" end)]  \(.headRefName) → \(.baseRefName)   von \(.author.login)"' 2>/dev/null || echo '(PR konnte nicht geladen werden)')" \
      "v" "Mit Kommentaren ansehen (gh pr view --comments)" \
      "d" "Exakter Diff (gh pr diff)" \
      "s" "Dateiliste im PR (gh pr diff --name-only)" \
      "c" "CI-Checks (gh pr checks)" \
      "o" "★ Diesen PR auschecken (gh pr checkout)" \
      "k" "Kommentar schreiben (gh pr comment)" \
      "r" "Review abgeben (gh pr review)" \
      "g" "Reviews & Review-Stand anzeigen" \
      "R" "Reviewer anfordern (gh pr edit --add-reviewer)" \
      "l" "Labels / Assignee (gh pr edit)" \
      "e" "Titel / Body bearbeiten (gh pr edit)" \
      "y" "Ready ↔ Draft (gh pr ready)" \
      "M" "Mergen (gh pr merge)" \
      "x" "Schließen / wieder öffnen" \
      "b" "Im Browser öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      v) : >"$out"; cap "$out" gh pr view "$n" --comments; ui_textbox "PR #$n" "$out" ;;
      d) : >"$out"; cap "$out" gh pr diff "$n"; ui_textbox "PR #$n — Diff" "$out" ;;
      s) : >"$out"; cap "$out" gh pr diff "$n" --name-only; ui_textbox "Dateien in PR #$n" "$out" ;;
      c) : >"$out"; cap "$out" gh pr checks "$n"; ui_textbox "Checks PR #$n" "$out" ;;
      o) run_live "gh pr checkout $n" gh pr checkout "$n" && { refresh_state; ui_msgbox "PR #$n" "${C_G}${ICON_OK} Ausgecheckt — jetzt auf Branch: $CURRENT_BRANCH${C_N}" "Weiter"; return 0; } ;;
      k) printf 'Dein Kommentar zu PR #%s:\n' "$n" >"$f"; open_editor "$f"
         run_live "gh pr comment $n" gh pr comment "$n" -F "$f" ;;
      r) mode=$(ui_menu "Review PR #$n" "" "a" "Approve" "c" "Kommentieren" "r" "Changes anfordern" "z" "↩ zurück") || continue
         case $mode in a) mode=--approve ;; c) mode=--comment ;; r) mode=--request-changes ;; z) continue ;; esac
         printf 'Review-Text:\n' >"$f"; open_editor "$f"
         run_live "gh pr review $n" gh pr review "$n" "$mode" -F "$f" ;;
      g) : >"$out"; cap "$out" gh pr view "$n" --json reviewDecision,reviews \
           --jq '"Review-Stand: \(.reviewDecision // "noch offen")\n\n" + ([.reviews[]? | "\(.author.login): \(.state)"] | join("\n"))'
         ui_textbox "Reviews PR #$n" "$out" ;;
      R) local rev; rev=$(ui_inputbox "Reviewer anfordern" "GitHub-Logins (kommasepariert):" "") || continue
         [[ -z "$rev" ]] && continue
         cmd_confirm_run "Reviewer anfordern" "$out" gh pr edit "$n" --add-reviewer "$rev" ;;
      l) sel=$(ui_menu "PR #$n — Labels/Assignee" "" "l" "Labels ändern" "m" "Mir zuweisen (@me)" "z" "↩ zurück") || continue
         case $sel in
           l) label_edit "PR #$n" gh pr edit "$n" ;;
           m) : >"$out"; cap "$out" gh pr edit "$n" --add-assignee @me; ui_textbox "Assignee" "$out" ;;
           z) continue ;;
         esac ;;
      e) sel=$(ui_menu "PR #$n bearbeiten" "" \
           "t" "Titel ändern (gh pr edit --title)" \
           "b" "Body bearbeiten (Editor → gh pr edit --body-file)" \
           "z" "↩ zurück") || continue
         case $sel in
           t) local tt; tt=$(gh pr view "$n" --json title -q .title 2>/dev/null)
              tt=$(ui_inputbox "PR-Titel" "Neuer Titel:" "$tt") || continue
              cmd_confirm_run "Titel ändern" "$out" gh pr edit "$n" --title "$tt" ;;
           b) gh pr view "$n" --json body -q .body >"$titlef" 2>/dev/null || : >"$titlef"
              open_editor "$titlef"
              cmd_confirm_run "Body aktualisieren" "$out" gh pr edit "$n" --body-file "$titlef" ;;
           z) continue ;;
         esac ;;
      y) sel=$(ui_menu "PR #$n" "" "r" "Review-ready (gh pr ready)" "d" "Zurück in Draft (gh pr ready --undo)" "z" "↩ zurück") || continue
         case $sel in r) run_live "gh pr ready $n" gh pr ready "$n" ;; d) run_live "gh pr ready $n --undo" gh pr ready "$n" --undo ;; z) continue ;; esac ;;
      M) mode=$(ui_menu "PR #$n mergen" "Methode?" "m" "Merge-Commit" "s" "Squash" "r" "Rebase" "z" "↩ zurück") || continue
         case $mode in m) mode=--merge ;; s) mode=--squash ;; r) mode=--rebase ;; z) continue ;; esac
         dargs=()
         ui_yesno "Branch nach dem Merge löschen? (--delete-branch)" "Merge" "Ja, löschen" "Nein" && dargs+=(--delete-branch)
         cmd_confirm_run "PR #$n mergen" "$out" gh pr merge "$n" "$mode" "${dargs[@]}" ;;
      x) sel=$(ui_menu "PR #$n" "" "c" "Schließen (gh pr close)" "o" "Wieder öffnen (gh pr reopen)" "z" "↩ zurück") || continue
         case $sel in c) cmd_confirm_run "PR #$n schließen" "$out" gh pr close "$n" ;; o) cmd_confirm_run "PR #$n öffnen" "$out" gh pr reopen "$n" ;; z) continue ;; esac ;;
      b) run_live "gh pr view $n --web" gh pr view "$n" --web ;;
      z) return 0 ;;
    esac
  done
}

prs_menu() {
  local sel n q
  while :; do
    sel=$(ui_menu "Pull Requests (gh)" "Repo: ${REPO_SLUG:-?}   Branch: $CURRENT_BRANCH" \
      "o" "Offene PRs (fzf-Auswahl, Vorschau)" \
      "g" "Geschlossene/gemergte PRs" \
      "a" "Alle PRs" \
      "s" "PRs suchen (Volltext)" \
      "n" "★ Neuen PR erstellen (→ Schritt 9)" \
      "v" "PR nach Nummer öffnen" \
      "k" "★ PR auschecken (gh pr checkout — auch fremde PRs)" \
      "m" "Meine PRs in diesem Repo (gh pr status)" \
      "b" "PR-Liste im Browser öffnen (gh pr list --web)" \
      "z" "↩ zurück") || return 0
    case $sel in
      o) pr_browse "" ;;
      g) pr_browse "--state closed" ;;
      a) pr_browse "--state all" ;;
      s) q=$(ui_inputbox "PRs suchen" "Suchtext:") || continue
         [[ -z "$q" ]] && continue
         sel=$(gh pr list --limit 60 --search "$q" --json number,title,headRefName \
               --jq '.[] | "\(.number)\t[\(.headRefName)] \(.title)"' 2>/dev/null \
             | fzf_num "PR-Suche: $q" 'GH_PAGER=cat gh pr view {1} --comments')
         [[ -z "$sel" ]] && continue
         n=${sel%%$'\t'*}; [[ $n =~ ^[0-9]+$ ]] && pr_detail "$n" ;;
      n) run_steps 9 ;;
      v) n=$(ask_number "PR-Nummer:" "PR öffnen") || continue; pr_detail "$n" ;;
      k)
        sel=$(gh pr list --limit 60 --json number,title,headRefName,isDraft,state \
              --jq '.[] | "\(.number)\t[\(.headRefName)] \(.title)"' 2>/dev/null \
            | fzf_num 'ENTER = PR auschecken' 'GH_PAGER=cat gh pr view {1} --comments')
        [[ -z "$sel" ]] && continue
        n=${sel%%$'\t'*}
        [[ $n =~ ^[0-9]+$ ]] || continue
        if [[ -n "$(git status --porcelain)" ]] && ! ui_yesno "Es gibt uncommittete Änderungen — checkout kann scheitern.\n\nTrotzdem PR #$n auschecken?" "gh pr checkout" "Trotzdem" "Abbrechen"; then continue; fi
        run_live "gh pr checkout $n" gh pr checkout "$n" && { refresh_state; ui_msgbox "PR #$n" "${C_G}${ICON_OK} Ausgecheckt — Branch: $CURRENT_BRANCH${C_N}" "Weiter"; } ;;
      m) : >"$TMPDIR_PRP/prstatus.out"; cap "$TMPDIR_PRP/prstatus.out" gh pr status; ui_textbox "gh pr status" "$TMPDIR_PRP/prstatus.out" ;;
      b) run_live "gh pr list --web" gh pr list --web ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Actions / CI
# ----------------------------------------------------------------------------

pick_run() {  # [extra args für gh run list]  → Run-ID auf stdout
  local extra=$1 sel
  # shellcheck disable=SC2086
  sel=$(gh run list --limit 30 $extra --json databaseId,displayTitle,status,conclusion,workflowName \
        --jq '.[] | "\(.databaseId)\t[\(.conclusion // .status)] \(.workflowName): \(.displayTitle)"' 2>/dev/null \
      | fzf_num 'ENTER = Run auswählen' 'GH_PAGER=cat gh run view {1}')
  [[ -z "$sel" ]] && return 1
  printf '%s' "${sel%%$'\t'*}"
}

actions_menu() {
  local sel run wf out="$TMPDIR_PRP/actions.out" method adir
  while :; do
    sel=$(ui_menu "Actions / CI (gh)" "Branch: $CURRENT_BRANCH   Repo: ${REPO_SLUG:-?}" \
      "r" "Letzte Runs ansehen (gh run list → fzf)" \
      "b" "Runs für Branch $CURRENT_BRANCH" \
      "w" "Workflows im Repo (gh workflow list)" \
      "v" "Run nach ID ansehen (Jobs + Status)" \
      "l" "Log des Runs (fehlgeschlagene Schritte: --log-failed)" \
      "W" "★ Run LIVE beobachten (gh run watch)" \
      "R" "Fehlgeschlagenen Run erneut starten (gh run rerun --failed)" \
      "s" "★ Workflow manuell starten — mit Inputs (gh workflow run)" \
      "d" "Run-Artefakte herunterladen (gh run download)" \
      "x" "Laufenden Run abbrechen (gh run cancel)" \
      "z" "↩ zurück") || return 0
    case $sel in
      r) : >"$out"; cap "$out" gh run list --limit 15; ui_textbox "Letzte Runs" "$out"
         if run=$(pick_run) && [[ -n $run ]]; then : >"$out"; cap "$out" gh run view "$run"; ui_textbox "Run $run" "$out"; fi ;;
      b) : >"$out"; cap "$out" gh run list --branch "$CURRENT_BRANCH" --limit 15; ui_textbox "Runs für $CURRENT_BRANCH" "$out" ;;
      w) : >"$out"; cap "$out" gh workflow list; ui_textbox "Workflows" "$out" ;;
      v) run=$(ask_number "Run-ID:" "Run ansehen") || continue; : >"$out"; cap "$out" gh run view "$run"; ui_textbox "Run $run" "$out" ;;
      l) run=$(pick_run) || continue; [[ -z $run ]] && continue
         method=$(ui_menu "Run $run" "Welches Log?" "f" "Nur fehlgeschlagene Schritte (--log-failed)" "a" "Komplettes Log (--log)" "z" "↩ zurück") || continue
         case $method in
           f) cmd_confirm_run "Log (fail) Run $run" "$out" gh run view "$run" --log-failed ;;
           a) cmd_confirm_run "Log Run $run" "$out" gh run view "$run" --log ;;
           z) continue ;;
         esac ;;
      W) run=$(pick_run) || continue; [[ -z $run ]] && continue
         run_live "gh run watch $run (Ctrl-C = aufhören zuzusehen)" gh run watch "$run" ;;
      R) run=$(pick_run) || continue; [[ -z $run ]] && continue
         cmd_confirm_run "Run $run neu starten (failed)" "$out" gh run rerun "$run" --failed ;;
      s) workflow_menu ;;
      d) run=$(pick_run) || continue; [[ -z $run ]] && continue
         adir="$START_DIR/gh-downloads/run-$run"; mkdir -p "$adir"
         cmd_confirm_run "Artefakte herunterladen (Run $run)" "$out" gh run download "$run" -D "$adir"
         ui_msgbox "Download" "Artefakte liegen in:\n${C_C}$adir${C_N}" "OK" ;;
      x) run=$(pick_run) || continue; [[ -z $run ]] && continue
         cmd_confirm_run "Run $run abbrechen" "$out" gh run cancel "$run" ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Labels
# ----------------------------------------------------------------------------

label_picker() {  # multi|one  → kommaseparierte Labelnamen auf stdout
  local mode=$1 sel
  local opts=(--delimiter='\t' --with-nth=1,2 --header='ENTER = Label wählen  ·  im Dialog: TAB = mehrere')
  [[ $mode == multi ]] && opts+=(--multi)
  sel=$(gh label list --limit 100 --json name,description,color \
        --jq '.[] | "\(.name)\t\(.description)  [#\(.color)]"' 2>/dev/null \
      | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" "${opts[@]}")
  [[ -z "$sel" ]] && return 1
  printf '%s' "$sel" | cut -f1 | paste -sd, -
}

label_edit() {  # title gh-subcmd...
  local title=$1; shift
  local out="$TMPDIR_PRP/label.out" sel lb
  while :; do
    sel=$(ui_menu "$title — Labels" "Aktuelle Labels siehe Ansicht im Hintergrund" \
      "a" "Label hinzufügen (gh label list)" \
      "r" "Label entfernen (gh label list)" \
      "z" "↩ zurück") || return 0
    case $sel in
      a) lb=$(label_picker multi) || continue; [[ -z "$lb" ]] && continue
         : >"$out"; cap "$out" "$@" --add-label "$lb"; ui_textbox "Labels hinzugefügt: $lb" "$out" ;;
      r) lb=$(label_picker multi) || continue; [[ -z "$lb" ]] && continue
         : >"$out"; cap "$out" "$@" --remove-label "$lb"; ui_textbox "Labels entfernt: $lb" "$out" ;;
      z) return 0 ;;
    esac
  done
}

labels_menu() {
  local sel name color desc out="$TMPDIR_PRP/labels.out"
  while :; do
    sel=$(ui_menu "Labels (gh)" "Repo: ${REPO_SLUG:-?}" \
      "l" "Alle Labels ansehen (gh label list)" \
      "s" "Labels durchsuchen (gh label list --search)" \
      "n" "Neues Label erstellen (gh label create)" \
      "e" "Label bearbeiten (gh label edit)" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" gh label list --limit 100; ui_textbox "Labels in $REPO_SLUG" "$out" ;;
      s) name=$(ui_inputbox "Labels suchen" "Suchtext:") || continue; [[ -z $name ]] && continue
         : >"$out"; cap "$out" gh label list --search "$name" --limit 100; ui_textbox "Label-Suche: $name" "$out" ;;
      n)
        name=$(ui_inputbox "Neues Label" "Labelname:") || continue; [[ -z $name ]] && continue
        color=$(ui_inputbox "Neues Label" "Farbe als Hex ohne # (z. B. d73a4a):" "ededed")
        desc=$(ui_inputbox "Neues Label" "Beschreibung (optional):" "")
        cmd_confirm_run "gh label create" "$out" gh label create "$name" --color "$color" --description "$desc" ;;
      e)
        name=$(ui_inputbox "Label bearbeiten" "Welches Label?" "") || continue; [[ -z $name ]] && continue
        desc=$(ui_inputbox "Label bearbeiten" "Neue Beschreibung (leer = unverändert):" "")
        color=$(ui_inputbox "Label bearbeiten" "Neue Farbe ohne # (leer = unverändert):" "")
        local args=(gh label edit "$name")
        [[ -n $desc ]] && args+=(--description "$desc")
        [[ -n $color ]] && args+=(--color "$color")
        cmd_confirm_run "gh label edit" "$out" "${args[@]}" ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Remote-Tree (Dateien auf GitHub — über die gefetchten Remote-Refs)
# ----------------------------------------------------------------------------

remote_browser() {
  local ref="$DEFAULT_BRANCH" path="" sel target args=() meta mtype name out="$TMPDIR_PRP/remote_tree.out"
  while :; do
    target="origin/$ref"
    [[ -n "$path" ]] && target="$target:$path"
    if ! git rev-parse --verify --quiet "$target" >/dev/null; then
      ui_msgbox "Remote-Tree" "Ref $target nicht gefunden.\n\nErst fetchen (Schritt 1a oder hier 'F')." "OK"
      path=""; continue
    fi
    args=()
    (( ${#path} )) && args+=("@up" "⬆ .. (eine Ebene höher)")
    args+=("@ref" "🔀 Ref wechseln (aktuell: origin/$ref)" "@fetch" "⟳ git fetch origin (Remote-Stand aktualisieren)")
    args+=("@browse" "🌐 Diesen Ordner auf GitHub öffnen")
    while IFS=$'\t' read -r meta name; do
      [[ -z "$name" ]] && continue
      set -- $meta
      mtype=$2
      case $mtype in
        tree) args+=("d:$name" "📁 $name/") ;;
        blob) args+=("f:$name" "📄 $name") ;;
        commit) args+=("x:$name" "🔗 $name (Submodule)") ;;
      esac
    done < <(git ls-tree "$target" 2>/dev/null)
    sel=$(ui_menu "Remote-Tree: ${path:-/}  (origin/$ref)" "${#args[@]} Einträge" "${args[@]}") || return 0
    case $sel in
      @up) path=$(dirname "$path"); [[ $path == "." ]] && path="" ;;
      @fetch) cmd_confirm_run "git fetch origin" "$out" git fetch origin; refresh_state ;;
      @browse) run_live "gh browse" gh browse ;;
      @ref)
        local refs=() r
        while IFS= read -r r; do refs+=("$r" "$r"); done < <(git for-each-ref --format='%(refname:short)' refs/remotes/origin | grep -v HEAD | sort)
        r=$(ui_menu "Ref wählen" "Welchen Remote-Stand browsen?" "${refs[@]}") || continue
        ref=${r#origin/}; path="" ;;
      d:*) path="${path:+$path/}${sel#d:}" ;;
      f:*)
        name=${sel#f:}
        local full="${path:+$path/}$name"
        while :; do
          local fsel
          fsel=$(ui_menu "$name" "Datei aus origin/$ref${path:+/$path}/" \
            "v" "Inhalt anzeigen (Textbox)" \
            "s" "Als lokale Kopie in nnvim öffnen" \
            "h" "Verlauf der Datei (git log)" \
            "b" "Auf GitHub im Browser öffnen (gh browse)" \
            "z" "↩ zurück") || break
          case $fsel in
            v)
              git show "origin/$ref:$full" >"$out" 2>/dev/null
              if command -v file >/dev/null 2>&1 && file -b --mime "$out" | grep -q 'charset=binary'; then
                ui_msgbox "$name" "Das ist eine Binärdatei — wird nicht angezeigt.\n\nNutze: lokale Kopie (nnvim) oder GitHub." "OK"
              else
                ui_textbox "origin/$ref:$full" "$out"
              fi ;;
            s)
              local tmpf="$TMPDIR_PRP/remote_copies/$(basename "$full")"
              mkdir -p "$(dirname "$tmpf")"
              if git show "origin/$ref:$full" >"$tmpf" 2>/dev/null; then
                ui_msgbox "Remote-Datei" "Kopie liegt in:\n$tmpf\n\nAchtung: das ist NICHT im Repo — nur zum Anschauen." "OK"
                open_nn_folder "$tmpf"
              fi ;;
            h) git --no-pager log --oneline -20 "origin/$ref" -- "$full" >"$out" 2>&1; ui_textbox "Verlauf: $full" "$out" ;;
            b) run_live "gh browse $full" gh browse "$full" ;;
            z) break ;;
          esac
        done ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Lokaler Datei-Browser
# ----------------------------------------------------------------------------

local_browser() {
  local path="" sel name e rel args=() out="$TMPDIR_PRP/local_file.out" full
  while :; do
    args=()
    (( ${#path} )) && args+=("@up" "⬆ .. (eine Ebene höher)")
    args+=("@nvim" "📂 ${path:-Repo-Wurzel} in nnvim öffnen" "@rmd" "📄 Markdown-Viewer starten")
    local entries=()
    while IFS= read -r e; do entries+=("$e"); done < <(
      find "$PWD${path:+/$path}" -mindepth 1 -maxdepth 1 -name .git -prune -o -print 2>/dev/null | LC_ALL=C sort
    )
    for e in "${entries[@]}"; do
      rel=${e#"$PWD/"}
      [[ -d $e ]] && args+=("d:$rel" "📁 $(basename "$rel")/")
    done
    for e in "${entries[@]}"; do
      rel=${e#"$PWD/"}
      [[ -d $e ]] || args+=("f:$rel" "📄 $(basename "$rel")")
    done
    sel=$(ui_menu "Lokaler Tree: /${path}" "${#args[@]} Einträge (nnvim für echte Bearbeitung)" "${args[@]}") || return 0
    case $sel in
      @up) path=$(dirname "$path"); [[ $path == "." ]] && path="" ;;
      @nvim) open_nn_folder "${path:-.}" ;;
      @rmd) md_viewer ;;
      d:*) path=${sel#d:} ;;
      f:*)
        rel=${sel#f:}; full="$PWD/$rel"
        while :; do
          local fsel
          fsel=$(ui_menu "$rel" "Datei-Aktionen" \
            "v" "Anzeigen (Textbox, Anfang)" \
            "n" "In nnvim bearbeiten" \
            "o" "Ordner in nnvim öffnen" \
            "h" "Verlauf (git log)" \
            "g" "git blame (erste 200 Zeilen)" \
            "z" "↩ zurück") || break
          case $fsel in
            v) if command -v file >/dev/null 2>&1 && file -b --mime "$full" | grep -q 'charset=binary'; then
                 ui_msgbox "$rel" "Binärdatei." "OK"
               else
                 head -n 800 "$full" >"$out" 2>&1 || true; ui_textbox "$rel" "$out"
               fi ;;
            n) open_nn_folder "$rel" ;;
            o) open_nn_folder "$(dirname "$rel")" ;;
            h) git --no-pager log --oneline -20 -- "$rel" >"$out" 2>&1; ui_textbox "Verlauf: $rel" "$out" ;;
            g) git --no-pager blame -- "$rel" 2>&1 | head -n 200 >"$out"; ui_textbox "blame: $rel" "$out" ;;
            z) break ;;
          esac
        done ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Markdown-Viewer (lokal + remote)
# ----------------------------------------------------------------------------

make_md_preview() {
  local prev="$TMPDIR_PRP/md_preview.sh" tsv="$TMPDIR_PRP/md.tsv"
  cat >"$prev" <<'EOS'
#!/usr/bin/env bash
idx=$1; tsv=$2
entry=$(sed -n "${idx}p" "$tsv")
kind=${entry%%$'\t'*}; rest=${entry#*$'\t'}
if [[ $kind == local ]]; then
  printf '\033[1;36m── LOKAL: %s ──\033[0m\n\n' "$rest"
  head -n 250 -- "$rest"
else
  ref=${rest%%$'\t'*}; p=$(printf '%s' "${rest#*$'\t'}")
  printf '\033[1;35m── REMOTE origin/%s: %s ──\033[0m\n\n' "$ref" "$p"
  git show "origin/$ref:$p" | head -n 250
fi
EOS
  chmod +x "$prev"
}

md_viewer() {
  local tsv="$TMPDIR_PRP/md.tsv" prev="$TMPDIR_PRP/md_preview.sh" sel kind rest ref f
  make_md_preview
  : >"$tsv"
  git ls-files '*.md' '*.MD' 2>/dev/null | while IFS= read -r f; do [[ -f $f ]] && printf 'local\t%s\n' "$f"; done >>"$tsv"
  git ls-files --others --exclude-standard -- '*.md' 2>/dev/null | while IFS= read -r f; do printf 'local\t%s\n' "$f"; done >>"$tsv"
  git ls-tree -r --name-only "origin/$DEFAULT_BRANCH" 2>/dev/null | grep -iE '\.md$' | while IFS= read -r f; do printf 'remote\t%s\t%s\n' "$DEFAULT_BRANCH" "$f"; done >>"$tsv"
  awk -F'\t' '!seen[$0]++' "$tsv" >"$tsv.tmp" && mv "$tsv.tmp" "$tsv"
  if [[ ! -s "$tsv" ]]; then ui_msgbox "Markdown-Viewer" "Keine .md-Dateien gefunden." "OK"; return; fi
  while :; do
    sel=$(fzf_indexed "$tsv" "\"$prev\" {1} \"$tsv\"" 'Markdown wählen – Vorschau unten · ENTER = öffnen' one) || return 0
    [[ -z "$sel" ]] && return 0
    kind=${sel%%$'\t'*}; rest=${sel#*$'\t'}
    if [[ $kind == local ]]; then
      f=$rest
      while :; do
        sel=$(ui_menu "📄 $f" "Lokale Markdown-Datei" \
          "v" "Im Dialog lesen (Textbox)" \
          "n" "In nnvim bearbeiten" \
          "z" "↩ zurück") || break
        case $sel in
          v) ui_textbox "$f" "$f" ;;
          n) open_nn_folder "$f" ;;
          z) break ;;
        esac
      done
    else
      ref=${rest%%$'\t'*}; f=${rest#*$'\t'}
      local out="$TMPDIR_PRP/md_remote.out"
      git show "origin/$ref:$f" >"$out" 2>/dev/null
      ui_textbox "remote origin/$ref:$f" "$out"
    fi
  done
}

# ----------------------------------------------------------------------------
#  Suche / Übersicht / Konto / Checkliste
# ----------------------------------------------------------------------------

search_menu() {
  local sel q out="$TMPDIR_PRP/search.out" line n
  while :; do
    sel=$(ui_menu "Suche (gh search)" "Repo: ${REPO_SLUG:-?}" \
      "i" "Issues durchsuchen (gh search issues, in diesem Repo)" \
      "p" "PRs durchsuchen (gh search prs, in diesem Repo)" \
      "c" "Code durchsuchen (gh search code, in diesem Repo)" \
      "r" "GitHub-weit Repos suchen (gh search repos)" \
      "z" "↩ zurück") || return 0
    case $sel in
      i|p)
        q=$(ui_inputbox "Suche" "Suchtext (z. B. mapiary crash):") || continue; [[ -z $q ]] && continue
        if [[ $sel == i ]]; then
          line=$(gh search issues "$q" --repo "$REPO_SLUG" --limit 30 --json number,title,state \
                 --jq '.[] | "\(.number)\t[\(.state)] \(.title)"' 2>/dev/null \
               | fzf_num "Issues: $q" 'GH_PAGER=cat gh issue view {1}')
          [[ -n "$line" ]] && { n=${line%%$'\t'*}; [[ $n =~ ^[0-9]+$ ]] && issue_detail "$n"; }
        else
          line=$(gh search prs "$q" --repo "$REPO_SLUG" --limit 30 --json number,title,state \
                 --jq '.[] | "\(.number)\t[\(.state)] \(.title)"' 2>/dev/null \
               | fzf_num "PRs: $q" 'GH_PAGER=cat gh pr view {1}')
          [[ -n "$line" ]] && { n=${line%%$'\t'*}; [[ $n =~ ^[0-9]+$ ]] && pr_detail "$n"; }
        fi ;;
      c) q=$(ui_inputbox "Code-Suche" "Suchtext (Funktionen, Dateiinhalte):") || continue; [[ -z $q ]] && continue
         : >"$out"; cap "$out" gh search code "$q" --repo "$REPO_SLUG" --limit 30; ui_textbox "Code-Suche: $q" "$out" ;;
      r) q=$(ui_inputbox "Repo-Suche" "Suchtext (GitHub-weit):") || continue; [[ -z $q ]] && continue
         : >"$out"; cap "$out" gh search repos "$q" --limit 30; ui_textbox "Repos: $q" "$out" ;;
      z) return 0 ;;
    esac
  done
}

local_overview() {
  local sel out="$TMPDIR_PRP/overview.out"
  while :; do
    sel=$(ui_menu "Übersicht (lokal)" "Branch: $CURRENT_BRANCH   $AHEAD_BEHIND" \
      "s" "Status: kurz + lang (git status)" \
      "d" "Diff: offen + gestaged (exakt)" \
      "l" "Letzte Commits (Graph, 30)" \
      "b" "Branches lokal + remote (mit Upstream)" \
      "t" "Untracked / ignoriert / Stashes" \
      "u" "Drift zum Remote: fetch + links/rechts" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) { echo "══ kurz ══"; git_status_short; echo; echo "══ lang ══"; git --no-pager status; } >"$out"; ui_textbox "git status" "$out" ;;
      d) view_full_diff ;;
      l) { git --no-pager log --oneline --graph --decorate -30; } >"$out"; ui_textbox "Commits" "$out" ;;
      b) { echo "══ lokal ══"; git --no-pager branch -vv; echo; echo "══ remote (origin) ══"; git --no-pager branch -r -v | head -n 30; } >"$out"; ui_textbox "Branches" "$out" ;;
      t) { echo "══ untracked ══"; git ls-files --others --exclude-standard | head -n 50; echo; echo "══ ignoriert ══"; git ls-files --others --ignored --exclude-standard | head -n 30; echo; echo "══ Stashes ══"; git --no-pager stash list; } >"$out"; ui_textbox "Untracked / ignoriert / Stashes" "$out" ;;
      u) : >"$out"; cap "$out" git fetch origin; cap "$out" git status -sb
         { echo; echo "══ links = Remote fehlt lokal, rechts = lokal nicht gepusht ══"; git --no-pager log --oneline --left-right '@{u}...HEAD' 2>/dev/null | head -n 30; } >>"$out"
         ui_textbox "Drift zum Remote" "$out" ;;
      z) return 0 ;;
    esac
  done
}

auth_menu() {
  local sel out="$TMPDIR_PRP/auth.out" who
  while :; do
    who=$(gh api user -q .login 2>/dev/null || echo "nicht eingeloggt")
    sel=$(ui_menu "gh-Konto" "Angemeldet als: ${C_C}$who${C_N}" \
      "s" "gh auth status (alle Konten + Scopes)" \
      "l" "gh auth login (einloggen / anderes Konto)" \
      "w" "gh auth switch (Konto wechseln)" \
      "r" "gh auth refresh (Scopes erweitern)" \
      "t" "gh auth token anzeigen? (NEIN — Sicherheitsrisiko, nur Status)" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; cap "$out" gh auth status; ui_textbox "gh auth status" "$out" ;;
      l) run_live "gh auth login" gh auth login; refresh_state ;;
      w) run_live "gh auth switch" gh auth switch; refresh_state ;;
      r) run_live "gh auth refresh" gh auth refresh; refresh_state ;;
      t) ui_msgbox "gh-Konto" "Der Token wird hier absichtlich nicht angezeigt —\nfalls du ihn brauchst: gh auth token (im Terminal)." "OK" ;;
      z) return 0 ;;
    esac
  done
}

show_checklist() {
  if [[ -f "$CHECKLIST" ]]; then
    ui_textbox "PR-Checkliste — $CHECKLIST" "$CHECKLIST"
  else
    ui_msgbox "Checkliste" "Nicht gefunden:\n$CHECKLIST" "OK"
  fi
}

# ============================================================================
#  PART 6 — zusätzliche GitHub-Funktionen (Allrounder, Runde 2)
# ============================================================================

# URL im Browser öffnen (xdg-open / $BROWSER / Hinweis)
open_url() {
  if command -v xdg-open >/dev/null 2>&1; then
    run_live "Im Browser öffnen: $1" xdg-open "$1"
  elif [[ -n "${BROWSER:-}" ]] && command -v "$BROWSER" >/dev/null 2>&1; then
    run_live "Im Browser öffnen: $1" "$BROWSER" "$1"
  else
    ui_msgbox "URL" "Kein Browser-Befehl gefunden.\n\nÖffne manuell:\n${C_C}$1${C_N}" "OK"
  fi
}

# Refs (Branches/Remotes) auswählen → stdout
ref_picker() {  # [Init-Wert]
  local init=${1:-$CURRENT_BRANCH} r args=() sel
  while IFS= read -r r; do
    [[ -z "$r" ]] && continue
    args+=("$r" "$r")
  done < <(
    { printf '%s\n' "$CURRENT_BRANCH" "$DEFAULT_BRANCH"
      git for-each-ref --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null | grep -v HEAD
    } | awk '!seen[$0]++'
  )
  args+=("@in" "✍ Anderen Ref eingeben (Tag, Commit, feature/x …)")
  sel=$(ui_menu "Ref wählen" "Vorgang auf welchem Branch/Tag/Commit? (Vorschlag: $init)" "${args[@]}") || return 1
  if [[ $sel == "@in" ]]; then
    sel=$(ui_inputbox "Ref" "Branch / Tag / Commit:" "$init") || return 1
  fi
  [[ -n "$sel" ]] || return 1
  printf '%s' "$sel"
}

workflow_picker() {
  local sel
  sel=$(gh workflow list --json name,path,state --jq '.[] | "\(.name)\t[\(.state)] \(.path)"' 2>/dev/null \
      | fzf_num 'Workflow wählen – ENTER = auswählen' '')
  [[ -z "$sel" ]] && return 1
  printf '%s' "${sel%%$'\t'*}"
}

workflow_menu() {
  local sel wf ref inputs=() args=() out="$TMPDIR_PRP/wf.out" kv
  while :; do
    sel=$(ui_menu "Workflows & manuelle Trigger (gh workflow)" "Branch: $CURRENT_BRANCH" \
      "r" "★ Workflow manuell starten (gh workflow run — mit Inputs & Ref-Wahl)" \
      "l" "Workflow-Liste (gh workflow list)" \
      "v" "Workflow im Detail (gh workflow view)" \
      "e" "Workflow aktivieren (gh workflow enable)" \
      "d" "Workflow deaktivieren (gh workflow disable)" \
      "w" "Läufe dieses Workflows (gh run list --workflow)" \
      "z" "↩ zurück") || return 0
    case $sel in
      r)
        wf=$(workflow_picker) || continue; [[ -z "$wf" ]] && continue
        ref=$(ref_picker "$CURRENT_BRANCH") || continue
        inputs=()
        if ui_yesno "Hat der Workflow Eingaben (workflow_dispatch Inputs)?\n\nDu kannst sie gleich als key=value eingeben." "Workflow starten" "Ja, Inputs" "Nein, ohne"; then
          while :; do
            kv=$(ui_inputbox "Workflow-Inputs" "Ein Input pro Aufruf als  key=value\n(leer lassen = keine weiteren)\n\nBisher: ${inputs[*]:-keine}" "") || break
            [[ -z "$kv" ]] && break
            if [[ $kv == *"="* ]]; then inputs+=(-f "$kv"); else ui_msgbox "Inputs" "Format muss  key=value  sein." "OK"; fi
          done
        fi
        args=(gh workflow run "$wf" --ref "$ref" "${inputs[@]}")
        if run_live "Workflow manuell starten" "${args[@]}"; then
          ui_msgbox "Workflow" "${C_G}${ICON_OK} '$wf' wurde auf '$ref' gestartet.${C_N}\n\nBeobachte den Lauf: Extras → Actions → LIVE watch." "Weiter"
          : >"$out"; cap "$out" gh run list --workflow "$wf" --limit 5
          ui_textbox "Letzte Läufe von '$wf'" "$out"
        fi ;;
      l) : >"$out"; cap "$out" gh workflow list; ui_textbox "Workflows" "$out" ;;
      v) wf=$(workflow_picker) || continue; [[ -z $wf ]] && continue
         : >"$out"; cap "$out" gh workflow view "$wf"; ui_textbox "Workflow: $wf" "$out" ;;
      e) wf=$(workflow_picker) || continue; [[ -z $wf ]] && continue
         cmd_confirm_run "Workflow aktivieren" "$out" gh workflow enable "$wf" ;;
      d) wf=$(workflow_picker) || continue; [[ -z $wf ]] && continue
         cmd_confirm_run "Workflow deaktivieren" "$out" gh workflow disable "$wf" ;;
      w) wf=$(workflow_picker) || continue; [[ -z $wf ]] && continue
         : >"$out"; cap "$out" gh run list --workflow "$wf" --limit 15; ui_textbox "Läufe: $wf" "$out" ;;
      z) return 0 ;;
    esac
  done
}

releases_menu() {
  local sel rline tag args=() out="$TMPDIR_PRP/release.out" notes="$TMPDIR_PRP/release_notes.md" title draft pre esel
  while :; do
    sel=$(ui_menu "Releases (gh release)" "Repo: ${REPO_SLUG:-?}" \
      "l" "Releases ansehen (fzf-Auswahl, Vorschau)" \
      "v" "Release nach Tag ansehen (gh release view)" \
      "n" "★ Neues Release erstellen (gh release create)" \
      "e" "Release bearbeiten (Titel/Notes/Draft/Pre-Release)" \
      "d" "Assets herunterladen (gh release download)" \
      "u" "Asset hochladen (gh release upload)" \
      "D" "Release löschen (gh release delete)" \
      "b" "Releases im Browser öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      l)
        rline=$(gh release list --limit 30 --json tagName,name,isDraft,isPrerelease \
                --jq '.[] | "\(.tagName)\t[\(if .isDraft then "DRAFT" elif .isPrerelease then "PRE" else "release" end)] \(.name // "")"' 2>/dev/null \
              | fzf_num 'ENTER = Release ansehen' 'GH_PAGER=cat gh release view {1}')
        [[ -z "$rline" ]] && continue
        tag=${rline%%$'\t'*}; : >"$out"; cap "$out" gh release view "$tag"; ui_textbox "Release $tag" "$out" ;;
      v) tag=$(ui_inputbox "Release ansehen" "Tag:" "") || continue; [[ -z $tag ]] && continue
         : >"$out"; cap "$out" gh release view "$tag"; ui_textbox "Release $tag" "$out" ;;
      n)
        tag=$(ui_inputbox "Neues Release" "Tag (wird auf GitHub angelegt, z. B. 2.7.0):") || continue
        [[ -z $tag ]] && continue
        title=$(ui_inputbox "Neues Release" "Titel (leer = Tag):" "") || true
        printf '## Was ist neu?\n\n-\n\n## Bekannte Probleme\n\n-\n' >"$notes"
        open_editor "$notes"
        draft=0; pre=0
        ui_yesno "Als Draft anlegen?" "Release" "Ja" "Nein" && draft=1
        ui_yesno "Als Pre-Release markieren?" "Release" "Ja" "Nein" && pre=1
        args=(gh release create "$tag" --notes-file "$notes")
        [[ -n "$title" ]] && args+=(--title "$title")
        (( draft )) && args+=(--draft)
        (( pre )) && args+=(--prerelease)
        run_live "gh release create $tag" "${args[@]}" ;;
      e)
        tag=$(ui_inputbox "Release bearbeiten" "Tag:" "") || continue; [[ -z $tag ]] && continue
        esel=$(ui_menu "Release $tag bearbeiten" "" \
          "t" "Titel ändern" \
          "n" "Release-Notes im Editor bearbeiten" \
          "p" "Draft veröffentlichen (--draft=false)" \
          "r" "Pre-Release umschalten" \
          "l" "Als aktuellstes Release markieren (--latest)" \
          "z" "↩ zurück") || continue
        case $esel in
          t) title=$(ui_inputbox "Titel" "Neuer Titel:" "") || continue
             cmd_confirm_run "Release-Titel ändern" "$out" gh release edit "$tag" --title "$title" ;;
          n) cap "$out" gh release view "$tag" --json body -q .body || true
             cp "$out" "$notes" 2>/dev/null || printf '## Notes\n\n' >"$notes"
             open_editor "$notes"
             cmd_confirm_run "Notes aktualisieren" "$out" gh release edit "$tag" --notes-file "$notes" ;;
          p) cmd_confirm_run "Draft veröffentlichen" "$out" gh release edit "$tag" --draft=false ;;
          r) if ui_yesno "Pre-Release-Flag umschalten?" "Release" "Umschalten" "Abbrechen"; then
               cmd_confirm_run "Pre-Release togglen" "$out" gh release edit "$tag" --prerelease
             fi ;;
          l) cmd_confirm_run "Als latest markieren" "$out" gh release edit "$tag" --latest ;;
          z) continue ;;
        esac ;;
      d)
        tag=$(ui_inputbox "Assets herunterladen" "Tag:" "") || continue; [[ -z $tag ]] && continue
        local dir="$START_DIR/gh-downloads/release-$tag"
        mkdir -p "$dir"
        cmd_confirm_run "Release-Assets herunterladen" "$out" gh release download "$tag" -D "$dir"
        ui_msgbox "Download" "Zielordner:\n${C_C}$dir${C_N}" "OK" ;;
      u)
        tag=$(ui_inputbox "Asset hochladen" "Tag:" "") || continue; [[ -z $tag ]] && continue
        local file
        file=$(ui_inputbox "Asset hochladen" "Dateipfad (absolut):" "") || continue
        [[ -f "$file" ]] || { ui_msgbox "Upload" "Datei nicht gefunden:\n$file" "OK"; continue; }
        cmd_confirm_run "Asset hochladen" "$out" gh release upload "$tag" "$file" ;;
      D)
        tag=$(ui_inputbox "Release löschen" "Tag:" "") || continue; [[ -z $tag ]] && continue
        if ui_yesno "${C_R}Release '$tag' wirklich löschen?${C_N}" "Löschen" "Löschen" "Abbrechen"; then
          if ui_yesno "Auch den Git-Tag auf GitHub löschen? (--cleanup-tag)" "Löschen" "Ja, Tag weg" "Nein, Tag bleibt"; then
            cmd_confirm_run "Release + Tag löschen" "$out" gh release delete "$tag" --yes --cleanup-tag
          else
            cmd_confirm_run "Release löschen" "$out" gh release delete "$tag" --yes
          fi
        fi ;;
      b) run_live "gh browse releases" gh browse releases ;;
      z) return 0 ;;
    esac
  done
}

gists_menu() {
  local sel gid args=() out="$TMPDIR_PRP/gist.out" desc tmpf="$TMPDIR_PRP/gist_content.txt" pub nwo
  while :; do
    sel=$(ui_menu "Gists (gh gist)" "Deine kleinen Snippets — überall verfügbar" \
      "l" "Meine Gists (fzf-Auswahl, Vorschau, Öffnen)" \
      "v" "Gist nach ID ansehen (gh gist view)" \
      "n" "★ Neuen Gist erstellen (Datei im Editor → gh gist create)" \
      "e" "Gist bearbeiten (gh gist edit — Datei oder Beschreibung)" \
      "c" "Gist klonen (gh gist clone in den Start-Ordner)" \
      "D" "Gist löschen (gh gist delete)" \
      "b" "Meine Gists im Browser öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      l)
        gid=$(gh gist list --limit 40 2>/dev/null \
              | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --header 'ENTER = Gist ansehen' \
                  --preview 'GH_PAGER=cat gh gist view {1}' --preview-window='down,60%,wrap' \
              | awk '{print $1}')
        [[ -z "$gid" ]] && continue
        : >"$out"; cap "$out" gh gist view "$gid"; ui_textbox "Gist $gid" "$out" ;;
      v) gid=$(ui_inputbox "Gist ansehen" "Gist-ID oder URL:" "") || continue; [[ -z $gid ]] && continue
         : >"$out"; cap "$out" gh gist view "$gid"; ui_textbox "Gist $gid" "$out" ;;
      n)
        desc=$(ui_inputbox "Neuer Gist" "Beschreibung:" "") || true
        printf '# Snippet\n\n' >"$tmpf"
        open_editor "$tmpf"
        pub=""
        ui_yesno "Gist öffentlich machen? (Nein = secret)" "Gist" "Öffentlich" "Secret" && pub="-p"
        args=(gh gist create -d "$desc")
        [[ -n "$pub" ]] && args+=(-p)
        args+=("$tmpf")
        run_live "gh gist create" "${args[@]}" ;;
      e)
        gid=$(ui_inputbox "Gist bearbeiten" "Gist-ID oder URL:" "") || continue; [[ -z $gid ]] && continue
        local esel2
        esel2=$(ui_menu "Gist $gid bearbeiten" "" \
          "f" "Datei im Editor bearbeiten (gh gist edit)" \
          "a" "Datei hinzufügen (gh gist edit --add)" \
          "r" "Datei entfernen (gh gist edit --remove)" \
          "d" "Beschreibung ändern (gh gist edit --desc)" \
          "z" "↩ zurück") || continue
        case $esel2 in
          f) run_live "gh gist edit $gid" gh gist edit "$gid" ;;
          a) local fname; fname=$(ui_inputbox "Datei hinzufügen" "Dateiname:" "") || continue
             [[ -z $fname ]] && continue
             run_live "gh gist edit --add" gh gist edit "$gid" --add "$fname" ;;
          r) local rname; rname=$(ui_inputbox "Datei entfernen" "Dateiname:" "") || continue
             [[ -z $rname ]] && continue
             cmd_confirm_run "Datei entfernen" "$out" gh gist edit "$gid" --remove "$rname" ;;
          d) desc=$(ui_inputbox "Beschreibung" "Neue Beschreibung:" "") || continue
             cmd_confirm_run "Beschreibung ändern" "$out" gh gist edit "$gid" --desc "$desc" ;;
          z) continue ;;
        esac ;;
      c) gid=$(ui_inputbox "Gist klonen" "Gist-ID oder URL:" "") || continue; [[ -z $gid ]] && continue
         run_live "gh gist clone → $START_DIR" gh gist clone "$gid" "$START_DIR/gist-${gid##*/}" ;;
      D) gid=$(ui_inputbox "Gist löschen" "Gist-ID oder URL:" "") || continue; [[ -z $gid ]] && continue
         run_live "gh gist delete $gid (nachfragen: y)" gh gist delete "$gid" ;;
      b) nwo=$(gh api user -q .login 2>/dev/null || echo ""); open_url "https://gist.github.com/$nwo" ;;
      z) return 0 ;;
    esac
  done
}

notifications_menu() {
  local sel out="$TMPDIR_PRP/notif.out" line url
  while :; do
    sel=$(ui_menu "Benachrichtigungen (gh api notifications)" "Dein GitHub-Postfach" \
      "u" "Ungelesene anzeigen (im Browser öffnen auswählbar)" \
      "a" "Alle anzeigen (auch gelesene)" \
      "r" "Alles als gelesen markieren (PUT /notifications)" \
      "b" "Benachrichtigungs-Seite im Browser öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      u|a)
        local q="notifications?per_page=50"
        [[ $sel == u ]] && q="notifications?all=false&per_page=50"
        line=$(gh api "$q" --jq '.[] | "\(.subject.url | sub("^https://api.github.com/repos/"; "https://github.com/") | sub("/pulls/"; "/pull/") | sub("/commits/"; "/commit/"))\t[\(.repository.full_name)] \(.subject.title)  · \(.reason)"' 2>/dev/null \
              | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --header 'ENTER = im Browser öffnen  |  CTRL-C = zurück')
        [[ -z "$line" ]] && continue
        url=${line%%$'\t'*}
        open_url "$url" ;;
      r)
        cmd_confirm_run "Alle als gelesen markieren" "$out" gh api notifications --method PUT ;;
      b) open_url "https://github.com/notifications" ;;
      z) return 0 ;;
    esac
  done
}

repos_menu() {
  local sel name nwo out="$TMPDIR_PRP/repos.out" who
  who=$(gh api user -q .login 2>/dev/null || echo "?")
  while :; do
    sel=$(ui_menu "Repos & Profil (gh repo / gh api)" "Angemeldet als: ${C_C}$who${C_N}" \
      "l" "Meine Repos (gh repo list, fzf-Auswahl)" \
      "i" "Repo-Info & Statistiken (gh repo view + gh api)" \
      "c" "Repo klonen (gh repo clone in den Start-Ordner)" \
      "s" "Dieses Repo starren / unstarren" \
      "f" "Fork dieses Repos erstellen/aktualisieren (gh repo fork)" \
      "k" "API-Kontingent ansehen (gh api rate_limit)" \
      "p" "Mein Profil im Browser öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      l)
        local rl
        rl=$(gh repo list --limit 50 --json nameWithOwner,description,visibility,isFork \
             --jq '.[] | "\(.nameWithOwner)\t[\(.visibility)\(if .isFork then ",fork" else "" end)] \(.description // "")"' 2>/dev/null \
           | fzf_num 'ENTER = Repo-Info anzeigen' 'GH_PAGER=cat gh repo view {1}')
        [[ -z "$rl" ]] && continue
        repo_info "${rl%%$'\t'*}" ;;
      i) nwo=$(ui_inputbox "Repo-Info" "OWNER/NAME (leer = dieses Repo):" "$REPO_SLUG") || continue
         [[ -z "$nwo" ]] && nwo="$REPO_SLUG"
         [[ -z "$nwo" ]] && continue
         repo_info "$nwo" ;;
      c) name=$(ui_inputbox "Repo klonen" "OWNER/NAME oder URL:" "") || continue; [[ -z "$name" ]] && continue
         local dir="$START_DIR/${name##*/}"; dir=${dir%.git}
         [[ -e "$dir" ]] && { ui_msgbox "Klonen" "Ziel existiert schon:\n$dir" "OK"; continue; }
         run_live "gh repo clone → $dir" gh repo clone "$name" "$dir" ;;
      s)
        if [[ -z "$REPO_SLUG" ]]; then ui_msgbox "Star" "Repo-Slug unbekannt." "OK"; continue; fi
        if gh api "user/starred/$REPO_SLUG" >/dev/null 2>&1; then
          if ui_yesno "Repo ${C_C}$REPO_SLUG${C_N} ist ${C_G}gestarred${C_N}.\n\nStar entfernen?" "Unstar"; then
            cmd_confirm_run "Unstar" "$out" gh api --method DELETE "user/starred/$REPO_SLUG"
          fi
        else
          if ui_yesno "Repo ${C_C}$REPO_SLUG${C_N} ist noch nicht gestarred.\n\nStarren?" "Star"; then
            cmd_confirm_run "Star" "$out" gh api --method PUT "user/starred/$REPO_SLUG"
          fi
        fi ;;
      f) run_live "gh repo fork --remote=true" gh repo fork --remote=true; refresh_state ;;
      k) : >"$out"; cap "$out" gh api rate_limit --jq '.rate | "Limit:      \(.limit)\nVerbraucht: \(.used)\nRest:       \(.remaining)\nReset:      \(.reset | strflocaltime("%H:%M:%S"))"'; ui_textbox "API-Kontingent" "$out" ;;
      p) open_url "https://github.com/$who" ;;
      z) return 0 ;;
    esac
  done
}

repo_info() {
  local nwo=$1 out="$TMPDIR_PRP/repoinfo.out"
  : >"$out"
  cap "$out" gh repo view "$nwo" 2>/dev/null
  cap "$out" gh api "repos/$nwo" --jq '"── Statistiken ──\nStars:        \(.stargazers_count)\nWatchers:     \(.subscribers_count)\nForks:        \(.forks_count)\nOpen Issues:  \(.open_issues_count)\nSprache:      \(.language // "-")\nLizenz:       \(.license.spdx_id // "-")\nDefault:      \(.default_branch)\nZuletzt gepusht: \(.pushed_at)\nArchiviert:   \(.archived)\nURL:          \(.html_url)"'
  ui_textbox "Repo: $nwo" "$out"
}

secrets_menu() {
  local sel name valuef="$TMPDIR_PRP/secret_value.txt" out="$TMPDIR_PRP/secrets.out" value
  while :; do
    sel=$(ui_menu "Secrets & Variablen (Actions)" "Repo: ${REPO_SLUG:-?}" \
      "l" "Secrets auflisten (gh secret list)" \
      "v" "Variablen auflisten (gh variable list)" \
      "s" "★ Secret setzen (Wert wird NIE angezeigt — Editor-Eingabe)" \
      "V" "Variable setzen (gh variable set)" \
      "e" "Environment-Secret setzen (gh secret set --env)" \
      "d" "Secret löschen (gh secret delete)" \
      "D" "Variable löschen (gh variable delete)" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" gh secret list; ui_textbox "Secrets in $REPO_SLUG" "$out" ;;
      v) : >"$out"; cap "$out" gh variable list; ui_textbox "Variablen in $REPO_SLUG" "$out" ;;
      s)
        name=$(ui_inputbox "Secret setzen" "Name des Secrets (z. B. MAVEN_TOKEN):") || continue
        [[ -z $name ]] && continue
        printf 'Wert für %s (eine Zeile):\n' "$name" >"$valuef"
        open_editor "$valuef"
        if [[ ! -s "$valuef" ]]; then ui_msgbox "Secret" "Die Wertedatei ist leer — abgebrochen." "OK"; continue; fi
        : >"$out"
        if ui_yesno "Secret ${C_C}$name${C_N} jetzt setzen?\n\n(Der Wert wird per stdin übergeben — er taucht in keiner Befehlszeile auf.)" "Secret setzen" "Setzen" "Abbrechen"; then
          printf '$ gh secret set %s  < [Wertedatei]\n' "$name" >>"$out"
          gh secret set "$name" <"$valuef" >>"$out" 2>&1
          printf '\n[Exit-Code: %d]\n' "$?" >>"$out"
          shopt -s nullglob; rm -f "$valuef"*; shopt -u nullglob
          ui_textbox "gh secret set" "$out"
        fi ;;
      V)
        name=$(ui_inputbox "Variable setzen" "Name der Variable:") || continue; [[ -z $name ]] && continue
        value=$(ui_inputbox "Variable setzen" "Wert (sichtbar — Variablen sind nicht geheim):" "") || continue
        cmd_confirm_run "gh variable set" "$out" gh variable set "$name" --body "$value" ;;
      e)
        local env
        env=$(ui_inputbox "Environment-Secret" "Environment-Name (z. B. production):") || continue; [[ -z $env ]] && continue
        name=$(ui_inputbox "Environment-Secret" "Name des Secrets:") || continue; [[ -z $name ]] && continue
        printf 'Wert für %s (eine Zeile):\n' "$name" >"$valuef"
        open_editor "$valuef"
        [[ -s "$valuef" ]] || { ui_msgbox "Secret" "Leer — abgebrochen." "OK"; continue; }
        : >"$out"
        if ui_yesno "Environment-Secret setzen?" "Secret setzen" "Setzen" "Abbrechen"; then
          printf '$ gh secret set %s --env %s  < [Wertedatei]\n' "$name" "$env" >>"$out"
          gh secret set "$name" --env "$env" <"$valuef" >>"$out" 2>&1
          printf '\n[Exit-Code: %d]\n' "$?" >>"$out"
          shopt -s nullglob; rm -f "$valuef"*; shopt -u nullglob
          ui_textbox "gh secret set --env" "$out"
        fi ;;
      d) name=$(ui_inputbox "Secret löschen" "Name:" "") || continue; [[ -z $name ]] && continue
         cmd_confirm_run "Secret löschen" "$out" gh secret delete "$name" ;;
      D) name=$(ui_inputbox "Variable löschen" "Name:" "") || continue; [[ -z $name ]] && continue
         cmd_confirm_run "Variable löschen" "$out" gh variable delete "$name" ;;
      z) return 0 ;;
    esac
  done
}

gh_setup_menu() {
  local sel name out="$TMPDIR_PRP/setup.out" keyf val
  while :; do
    sel=$(ui_menu "gh-Setup: Keys, Aliase, Extensions, Config" "" \
      "k" "SSH-Keys ansehen / hinzufügen (gh ssh-key)" \
      "g" "GPG-Keys ansehen / hinzufügen (gh gpg-key)" \
      "a" "Aliase verwalten (gh alias list/set/delete)" \
      "e" "Extensions: Liste / Suche / Installieren" \
      "c" "gh config: get / set (editor, browser, pager …)" \
      "z" "↩ zurück") || return 0
    case $sel in
      k)
        sel2=$(ui_menu "SSH-Keys" "" "l" "Liste (gh ssh-key list)" "a" "Key hinzufügen (gh ssh-key add)" "z" "↩ zurück") || continue
        case $sel2 in
          l) : >"$out"; cap "$out" gh ssh-key list; ui_textbox "SSH-Keys" "$out" ;;
          a) keyf=$(ui_inputbox "SSH-Key hinzufügen" "Pfad zum Public-Key:" "$HOME/.ssh/id_ed25519.pub") || continue
             [[ -f "$keyf" ]] || { ui_msgbox "SSH-Key" "Datei nicht gefunden:\n$keyf" "OK"; continue; }
             name=$(ui_inputbox "SSH-Key hinzufügen" "Titel (z. B. Laptop):" "$(hostname)") || continue
             cmd_confirm_run "gh ssh-key add" "$out" gh ssh-key add "$keyf" --title "$name" ;;
          z) continue ;;
        esac ;;
      g)
        sel2=$(ui_menu "GPG-Keys" "" "l" "Liste (gh gpg-key list)" "a" "Key hinzufügen (gh gpg-key add)" "z" "↩ zurück") || continue
        case $sel2 in
          l) : >"$out"; cap "$out" gh gpg-key list; ui_textbox "GPG-Keys" "$out" ;;
          a) keyf=$(ui_inputbox "GPG-Key hinzufügen" "Pfad zum Armor-File (gpg --armor --export …):" "") || continue
             [[ -f "$keyf" ]] || { ui_msgbox "GPG-Key" "Datei nicht gefunden:\n$keyf" "OK"; continue; }
             cmd_confirm_run "gh gpg-key add" "$out" gh gpg-key add "$keyf" ;;
          z) continue ;;
        esac ;;
      a)
        sel2=$(ui_menu "Aliase" "" "l" "Liste (gh alias list)" "s" "Neu setzen (gh alias set)" "d" "Löschen (gh alias delete)" "z" "↩ zurück") || continue
        case $sel2 in
          l) : >"$out"; cap "$out" gh alias list; ui_textbox "gh-Aliase" "$out" ;;
          s) name=$(ui_inputbox "Alias setzen" "Alias-Name:" "") || continue; [[ -z $name ]] && continue
             val=$(ui_inputbox "Alias setzen" "Expansion (z. B. pr status):" "") || continue
             cmd_confirm_run "gh alias set" "$out" gh alias set "$name" "$val" ;;
          d) name=$(ui_inputbox "Alias löschen" "Alias-Name:" "") || continue; [[ -z $name ]] && continue
             cmd_confirm_run "gh alias delete" "$out" gh alias delete "$name" ;;
          z) continue ;;
        esac ;;
      e)
        sel2=$(ui_menu "Extensions" "" "l" "Installierte (gh extension list)" "s" "Suchen (gh extension search)" "i" "Installieren (gh extension install)" "r" "Entfernen (gh extension remove)" "z" "↩ zurück") || continue
        case $sel2 in
          l) : >"$out"; cap "$out" gh extension list; ui_textbox "Extensions" "$out" ;;
          s) name=$(ui_inputbox "Extension-Suche" "Suchtext:" "") || continue; [[ -z $name ]] && continue
             : >"$out"; cap "$out" gh extension search "$name"; ui_textbox "Extension-Suche: $name" "$out" ;;
          i) name=$(ui_inputbox "Extension installieren" "OWNER/NAME (z. B. dlvhdr/gh-dash):" "") || continue; [[ -z $name ]] && continue
             run_live "gh extension install $name" gh extension install "$name" ;;
          r) name=$(ui_inputbox "Extension entfernen" "Name:" "") || continue; [[ -z $name ]] && continue
             cmd_confirm_run "gh extension remove" "$out" gh extension remove "$name" ;;
          z) continue ;;
        esac ;;
      c)
        sel2=$(ui_menu "gh config" "" "l" "Liste (gh config list)" "g" "Wert lesen (gh config get)" "s" "Wert setzen (gh config set)" "z" "↩ zurück") || continue
        case $sel2 in
          l) : >"$out"; cap "$out" gh config list; ui_textbox "gh config" "$out" ;;
          g) name=$(ui_inputbox "gh config get" "Key (editor, browser, pager, git_protocol …):" "editor") || continue
             : >"$out"; cap "$out" gh config get "$name"; ui_textbox "gh config get $name" "$out" ;;
          s) name=$(ui_inputbox "gh config set" "Key:" "") || continue; [[ -z $name ]] && continue
             val=$(ui_inputbox "gh config set" "Wert:" "") || continue
             cmd_confirm_run "gh config set" "$out" gh config set "$name" "$val" ;;
          z) continue ;;
        esac ;;
      z) return 0 ;;
    esac
  done
}

# ----------------------------------------------------------------------------
#  Commit-/History-Browser, Ref-Vergleich, Textsuche (lokal)
# ----------------------------------------------------------------------------

commit_browser() {
  local line sha out="$TMPDIR_PRP/commit.out" sel fl pv="$TMPDIR_PRP/commit_preview.sh" tsv="$TMPDIR_PRP/commit_files.tsv" f
  while :; do
    line=$(git --no-pager log --oneline -60 --color=never \
           | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --header 'Commit wählen (ENTER) — Vorschau unten' \
               --preview 'git --no-pager show --stat --color=always {1}' --preview-window='down,60%,wrap') || return 0
    [[ -z "$line" ]] && return 0
    sha=${line%% *}
    while :; do
      sel=$(ui_menu "Commit $sha" "$(git --no-pager log -1 --format='%h %s%n%an · %ar' "$sha" 2>/dev/null)" \
        "v" "Vollen Commit ansehen (git show)" \
        "d" "Datei-Diff im Commit wählen (mit Vorschau)" \
        "f" "Dateiliste im Commit (git show --stat)" \
        "b" "Auf GitHub öffnen (gh browse <commit>)" \
        "c" "Diesen Commit auschecken (detached HEAD)" \
        "i" "In aktuellen Branch cherry-picken (git cherry-pick)" \
        "r" "Revert-Commit erzeugen (git revert --no-commit)" \
        "z" "↩ zurück") || break
      case $sel in
        v) git --no-pager show --color=never "$sha" >"$out"; ui_textbox "Commit $sha" "$out" ;;
        d)
          git --no-pager show --name-only --format='' "$sha" | grep -v '^$' >"$tsv"
          if [[ ! -s "$tsv" ]]; then ui_msgbox "Commit" "Keine Dateien (leerer Commit?)." "OK"; continue; fi
          cat >"$pv" <<EOS
#!/usr/bin/env bash
p=\$(sed -n "\${1}p" "$tsv")
git --no-pager show --color=always "$sha" -- "\$p"
EOS
          chmod +x "$pv"
          f=$(fzf_indexed "$tsv" "\"$pv\" {1}" 'Datei wählen — Vorschau: Diff in diesem Commit' one)
          [[ -z "$f" ]] && continue
          git --no-pager show --color=never "$sha" -- "$f" >"$out"
          ui_textbox "Commit $sha — $f" "$out" ;;
        f) git --no-pager show --stat --color=never "$sha" >"$out"; ui_textbox "Dateien im Commit" "$out" ;;
        b) run_live "gh browse $sha" gh browse "$sha" ;;
        c) if [[ -n "$(git status --porcelain)" ]] && ! ui_yesno "Uncommittete Änderungen — Checkout kann scheitern/verwirren.\n\nTrotzdem zu $sha springen (detached HEAD)?" "Checkout" "Trotzdem" "Abbrechen"; then continue; fi
           cmd_confirm_run "Detached checkout" "$out" git checkout "$sha"; refresh_state ;;
        i) cmd_confirm_run "Cherry-pick $sha" "$out" git cherry-pick "$sha"; refresh_state ;;
        r) cmd_confirm_run "Revert (nur vorbereiten, kein Auto-Commit)" "$out" git revert --no-commit "$sha"; refresh_state ;;
        z) break ;;
      esac
    done
  done
}

ref_compare() {
  local a b out="$TMPDIR_PRP/refcmp.out"
  a=$(ref_picker "$DEFAULT_BRANCH") || return 0
  b=$(ref_picker "$CURRENT_BRANCH") || return 0
  if [[ $a == "$b" ]]; then ui_msgbox "Ref-Vergleich" "Beide Refs sind identisch: $a" "OK"; return 0; fi
  {
    echo "══ Vergleich: $a  ↔  $b ══"; echo
    echo "══ Commits nur in '$b' (was $a fehlt) ══"
    git --no-pager log --oneline "$a..$b" 2>/dev/null || echo "(Vergleich nicht möglich — Refs gültig?)"
    echo; echo "══ Commits nur in '$a' ══"
    git --no-pager log --oneline "$b..$a" 2>/dev/null
    echo; echo "══ diff --stat $a..$b ══"
    git --no-pager diff --stat "$a..$b" 2>/dev/null
    echo; echo "══ voller Diff $a..$b ══"
    git --no-pager diff --color=never "$a..$b" 2>/dev/null
  } >"$out"
  ui_textbox "Ref-Vergleich" "$out"
}

fzf_paths_preview() {  # $1=Header, $2=TSV mit einem Pfad pro Zeile
  local hdr=$1 tsv=$2 prev="$TMPDIR_PRP/path_preview.sh"
  cat >"$prev" <<'EOS'
#!/usr/bin/env bash
p=$(sed -n "${1}p" "$2")
printf '\033[1;36m%s\033[0m\n\n' "$p"
if [[ -d $p ]]; then ls -la -- "$p" | head -n 60; else head -n 150 -- "$p" 2>/dev/null; fi
EOS
  chmod +x "$prev"
  fzf_indexed "$tsv" "\"$prev\" {1} \"$tsv\"" "$hdr" one
}

git_find() {
  local sel q out="$TMPDIR_PRP/find.out" line tsv="$TMPDIR_PRP/find_files.tsv" f
  while :; do
    sel=$(ui_menu "Finden (lokal)" "grep, Pickaxe, Dateisuche" \
      "g" "Text im getrackten Code (git grep)" \
      "f" "Text auch in untracked Dateien (grep -R)" \
      "h" "Text in der History: git log -S („wann kam/ging das?“)" \
      "l" "Datei nach Namen finden (fzf über alle Dateien, mit Vorschau)" \
      "z" "↩ zurück") || return 0
    case $sel in
      g)
        q=$(ui_inputbox "git grep" "Suchtext:") || continue; [[ -z $q ]] && continue
        : >"$out"; cap "$out" git grep -n -- "$q"; ui_textbox "git grep: $q" "$out" ;;
      f)
        q=$(ui_inputbox "grep -R" "Suchtext (auch untracked):") || continue; [[ -z $q ]] && continue
        : >"$out"
        { grep -RIn --exclude-dir=.git --exclude-dir=.gradle --exclude-dir=build --exclude-dir=node_modules -- "$q" . 2>/dev/null | head -n 300; } >>"$out"
        ui_textbox "grep -R: $q" "$out" ;;
      h)
        q=$(ui_inputbox "Pickaxe" "Text — zeigt Commits, die ihn hinzugefügt/entfernt haben (git log -S):") || continue
        [[ -z $q ]] && continue
        line=$(git --no-pager log --oneline -S"$q" --color=never -30 \
               | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --header "Commits zu: $q" --preview 'git --no-pager show --stat --color=always {1}') || continue
        [[ -z "$line" ]] && continue
        git --no-pager show --color=never "${line%% *}" >"$out"; ui_textbox "Commit ${line%% *}" "$out" ;;
      l)
        git ls-files -co --exclude-standard 2>/dev/null >"$tsv"
        f=$(fzf_paths_preview 'Datei wählen — Vorschau: Inhalt' "$tsv") || continue
        [[ -z "$f" ]] && continue
        sel=$(ui_menu "Datei: $f" "" "n" "In nnvim öffnen" "v" "Inhalt anzeigen (Anfang)" "o" "Ordner in nnvim öffnen" "p" "Pfad anzeigen (kopierbar)" "z" "↩ zurück") || continue
        case $sel in
          n) open_nn_folder "$f" ;;
          v) head -n 800 -- "$f" >"$out" 2>&1; ui_textbox "$f" "$out" ;;
          o) open_nn_folder "$(dirname "$f")" ;;
          p) ui_msgbox "Pfad" "$PWD/$f" "OK" ;;
          z) continue ;;
        esac ;;
      z) return 0 ;;
    esac
  done
}

# ============================================================================
#  PART 7 — Helfer für die neuen Werkzeuge
# ============================================================================

# Text in die Zwischenablage (wl-copy/xclip/xsel/pbcopy/clip.exe)
copy_to_clipboard() {
  local txt=$1
  if command -v wl-copy >/dev/null 2>&1; then printf '%s' "$txt" | wl-copy
  elif command -v xclip >/dev/null 2>&1; then printf '%s' "$txt" | xclip -selection clipboard
  elif command -v xsel >/dev/null 2>&1; then printf '%s' "$txt" | xsel --clipboard --input
  elif command -v pbcopy >/dev/null 2>&1; then printf '%s' "$txt" | pbcopy
  elif command -v clip.exe >/dev/null 2>&1; then printf '%s' "$txt" | clip.exe
  else ui_msgbox "Zwischenablage" "Kein Clipboard-Werkzeug gefunden.\n\nZum Kopieren:\n${C_C}$txt${C_N}" "OK"; return 1
  fi
}

copy_ui() {  # $1=Bezeichnung $2=Text
  if copy_to_clipboard "$2"; then
    ui_msgbox "Zwischenablage" "${C_G}${ICON_OK} $1 kopiert:${C_N}\n\n$2" "OK"
  fi
}

# https-URL des origin auf GitHub (ohne .git) → stdout
repo_web_url() {
  local u
  u=$(git remote get-url origin 2>/dev/null) || return 1
  [[ -z "$u" ]] && return 1
  u=${u%.git}
  u=${u#git@github.com:}
  u=${u#ssh://git@github.com/}
  u=${u#https://github.com/}
  [[ $u == http* || $u == git* ]] && return 1
  printf 'https://github.com/%s' "$u"
}

# PR-Nummer per fzf wählen → stdout
pr_pick() {
  local sel
  sel=$(gh pr list --limit 60 --json number,title,state,isDraft \
        --jq '.[] | "\(.number)\t[\(.state|ascii_downcase)\(if .isDraft then ",draft" else "" end)] \(.title)"' 2>/dev/null \
      | fzf_num 'PR wählen – ENTER = übernehmen' 'GH_PAGER=cat gh pr view {1}')
  [[ -z "$sel" ]] && return 1
  printf '%s' "${sel%%$'\t'*}"
}

# Datei bei Zeile N in nnvim öffnen
open_nn_at() {  # $1=Datei $2=Zeile
  local bin; bin=$(nvim_bin)
  if [[ -z "$bin" ]]; then open_editor "$1"; return; fi
  dialog --clear || true
  printf '\n\033[1;36m==> nnvim:  %s:%s\033[0m\n\n' "$1" "$2"
  printf '    Beenden mit  :q  — danach geht es hier weiter.\n\n'
  sleep 0.6
  if [[ $bin == nnvim ]]; then nnvim "+$2" "$1"; else NVIM_APPNAME=nnvim nvim "+$2" "$1"; fi
}

# ============================================================================
#  PART 7 — Git-Werkzeuge (Branches, Tags, Konflikte, Cherry-pick, …)
# ============================================================================

# ---------------------------------------------------------------- Branches --
branches_menu() {
  local args=() b up ab mark subj sel
  while IFS= read -r b; do
    [[ -z $b ]] && continue
    up=$(git rev-parse --abbrev-ref --symbolic-full-name "$b@{upstream}" 2>/dev/null) || up=""
    if [[ -n $up ]]; then
      ab=$(git rev-list --left-right --count "$up...$b" 2>/dev/null | awk 'BEGIN{FS="\t"}{printf "  ↑%s ↓%s", $2, $1}')
    else
      ab="  (kein Upstream)"
    fi
    mark=""; [[ $b == "$CURRENT_BRANCH" ]] && mark="◆ "
    subj=$(git log -1 --format='%s' "$b" 2>/dev/null | cut -c1-34)
    args+=("$b" "$mark$b$ab — $subj")
  done < <(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads 2>/dev/null)
  args+=("@new" "＋ Neuen Branch anlegen (von $CURRENT_BRANCH)")
  sel=$(ui_menu "Branches (lokal)" "◆ = ausgecheckt   ↑↓ = vs. Upstream" "${args[@]}") || return 0
  if [[ $sel == "@new" ]]; then branch_create "$CURRENT_BRANCH"; else branch_actions "$sel"; fi
}

branch_create() {  # $1 = Basis-Branch
  local base=${1:-$CURRENT_BRANCH} name out="$TMPDIR_PRP/git.out"
  while :; do
    name=$(ui_inputbox "Neuer Branch" "Von '${base}' abzweigen.\n\nBranch-Name (z. B. feature/gtnh-xyz):" "") || return 0
    [[ -z $name ]] && return 0
    [[ $name =~ [[:space:]] ]] && { ui_msgbox "Neuer Branch" "Keine Leerzeichen im Branch-Namen." "OK"; continue; }
    break
  done
  : >"$out"
  if cap "$out" git checkout -b "$name" "$base"; then
    refresh_state
    ui_textbox "Branch erstellt — $name" "$out"
  else
    ui_textbox "Fehler beim Anlegen" "$out"
  fi
}

branch_actions() {  # $1 = Branch
  local b=$1 sel out="$TMPDIR_PRP/git.out" url
  while :; do
    sel=$(ui_menu "Branch: $b" "Aktueller Branch: $CURRENT_BRANCH   ${SEP}   Basis: $DEFAULT_BRANCH" \
      "c" "→ Auschecken (git checkout $b)" \
      "n" "＋ Neuen Branch von '$b' starten" \
      "p" "⇡ Nach origin pushen (git push -u origin $b)" \
      "m" "⋯ '$b' in '$CURRENT_BRANCH' mergen" \
      "r" "⇄ '$CURRENT_BRANCH' auf '$b' rebasen" \
      "v" "🔍 Vergleich mit aktuellem Branch (Diff)" \
      "l" "📜 Letzte Commits (git log)" \
      "u" "⇡ Upstream-Status prüfen / setzen" \
      "d" "🗑 Lokal löschen" \
      "e" "☁ Remote bei GitHub löschen" \
      "h" "↺ Vom Remote hart aufsetzen (fetch + reset --hard)" \
      "o" "🌐 Auf GitHub öffnen" \
      "y" "📋 Namen kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      c) : >"$out"; if cap "$out" git checkout "$b"; then refresh_state; ui_textbox "Ausgecheckt: $b" "$out"; else ui_textbox "Fehler beim Checkout" "$out"; fi ;;
      n) branch_create "$b" ;;
      p) run_live "Push: $b → origin" git push -u origin "$b"; refresh_state ;;
      m) if [[ $b == "$CURRENT_BRANCH" ]]; then ui_msgbox "Merge" "Das ist bereits der aktuelle Branch." "OK"; continue; fi
         ui_yesno "In den aktuellen Branch mergen?\n\n${C_C}git merge --no-edit $b${C_N}\n\n(Bei Konflikten hilft der Konflikt-Assistent.)" "Merge: $b" "Mergen" "Abbrechen" || continue
         run_live "Merge: $b → $CURRENT_BRANCH" git merge --no-edit "$b"; refresh_state ;;
      r) if [[ $b == "$CURRENT_BRANCH" ]]; then ui_msgbox "Rebase" "Auf sich selbst rebasen geht nicht." "OK"; continue; fi
         ui_yesno "Aktuellen Branch auf '$b' rebasen?\n\n${C_C}git rebase $b${C_N}" "Rebase auf $b" "Rebasen" "Abbrechen" || continue
         run_live "Rebase: $CURRENT_BRANCH auf $b" git rebase "$b"; refresh_state ;;
      v) : >"$out"
         { echo "── Stat: $CURRENT_BRANCH ↔ $b ──"; git --no-pager diff --stat "$CURRENT_BRANCH...$b"
           echo; echo "── Diff (erste 800 Zeilen) ──"; git --no-pager diff --color=never "$CURRENT_BRANCH...$b" | head -n 800; } >"$out"
         ui_textbox "Diff: $CURRENT_BRANCH ↔ $b" "$out" ;;
      l) : >"$out"; cap "$out" git --no-pager log --oneline --graph --decorate --max-count=40 "$b"
         ui_textbox "Commits: $b" "$out" ;;
      u) : >"$out"
         if git rev-parse --abbrev-ref --symbolic-full-name "$b@{upstream}" >/dev/null 2>&1; then
           cap "$out" git status --short --branch
         else
           ui_yesno "Für '$b' ist kein Upstream gesetzt.\n\nJetzt pushen und Upstream setzen?\n\n${C_C}git push -u origin $b${C_N}" "Upstream" "Ja" "Nein" && run_live "Push -u origin $b" git push -u origin "$b"
         fi
         [[ -s $out ]] && ui_textbox "Upstream-Status: $b" "$out" ;;
      d) [[ $b == "$CURRENT_BRANCH" ]] && { ui_msgbox "Löschen" "Der ausgecheckte Branch kann nicht gelöscht werden." "OK"; continue; }
         if ui_yesno "Lokalen Branch '$b' löschen?\n\nZuerst wird  git branch -d  versucht (sicher);\nfalls nicht gemergt, fragt das Skript nochmal." "Löschen: $b" "Löschen" "Abbrechen"; then
           : >"$out"
           if cap "$out" git branch -d "$b"; then ui_textbox "Gelöscht: $b" "$out"
           else
             ui_yesno "'$b' ist nicht vollständig gemergt.\n\nMit  git branch -D  (hart) trotzdem löschen?" "Hart löschen" "Ja, hart" "Nein" \
               && { : >"$out"; cap "$out" git branch -D "$b"; refresh_state; ui_textbox "Hart gelöscht: $b" "$out"; }
           fi
         fi ;;
      e) [[ $b == "$DEFAULT_BRANCH" ]] && { ui_msgbox "Remote löschen" "Der Basis-Branch ($DEFAULT_BRANCH) wird nicht gelöscht." "OK"; continue; }
         ui_yesno "Branch '${C_C}$b${C_N}' WIRKLICH auf GitHub löschen?\n\nNur der Remote-Branch; lokal bleibt er erhalten.\n\nUngemergte PRs können dadurch beeinträchtigt werden." "Remote löschen" "Ja, auf GitHub löschen" "Abbrechen" || continue
         : >"$out"; cap "$out" gh api --method DELETE "repos/$REPO_SLUG/git/refs/heads/$b"; ui_textbox "Remote löschen: $b" "$out" ;;
      h) ui_yesno "⚠ '${C_C}$b${C_N}' wird HART auf origin/$b gesetzt.\n\n${C_R}Lokale Commits auf '$b' gehen dabei verloren.${C_N}" "Hart zurücksetzen" "Ja" "Abbrechen" || continue
         : >"$out"
         cap "$out" git fetch origin "$b" \
           && cap "$out" git checkout "$b" \
           && cap "$out" git reset --hard "origin/$b"
         refresh_state; ui_textbox "Reset: $b → origin/$b" "$out" ;;
      o) url=$(repo_web_url) || { ui_msgbox "GitHub" "Kein GitHub-Remote gefunden." "OK"; continue; }
         open_url "$url/tree/$b" ;;
      y) copy_ui "Branch-Name" "$b" ;;
      z|"") return 0 ;;
    esac
  done
}

# -------------------------------------------------------------------- Tags --
tags_menu() {
  local args=() line t sha sel
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    t=${line%%$'\t'*}; sha=${line#*$'\t'}
    args+=("$t" "$t  ($sha)")
  done < <(git for-each-ref --sort=-creatordate --format='%(refname:short)%09%(objectname:short)' refs/tags 2>/dev/null | head -40)
  args+=("@new" "＋ Neuen Tag erstellen (annotiert/leicht)")
  sel=$(ui_menu "Tags" "Tags insgesamt: $(git tag | wc -l)   (neueste 40 unten)" "${args[@]}") || return 0
  if [[ $sel == "@new" ]]; then tag_create "$CURRENT_BRANCH"; else tag_actions "$sel"; fi
}

tag_create() {  # $1 = Basis-Ref
  local ref=${1:-$CURRENT_BRANCH} name msg
  name=$(ui_inputbox "Neuer Tag" "Tag-Name (z. B. v1.2.3):" "") || return 0
  [[ -z $name ]] && return 0
  msg=$(ui_inputbox "Tag $name" "Nachricht für den Tag (leer = leichtgewichtiger Tag):" "") || return 0
  if [[ -n $msg ]]; then run_live "Annotierten Tag setzen: $name" git tag -a "$name" -m "$msg" "$ref"
  else run_live "Leichtgewichtigen Tag setzen: $name" git tag "$name" "$ref"; fi
  ui_yesno "Tag '${C_C}$name${C_N}' auch zu origin pushen?" "Tag pushen" "Ja, pushen" "Später" \
    && run_live "Tag pushen: $name" git push origin "$name"
}

tag_actions() {  # $1 = Tag
  local t=$1 sel out="$TMPDIR_PRP/git.out" url
  while :; do
    sel=$(ui_menu "Tag: $t" "Tag-Aktionen" \
      "s" "🔍 Tag anzeigen (git show)" \
      "c" "→ Auschecken (detached HEAD)" \
      "d" "📜 Commits bis zum Tag (git log)" \
      "p" "⇡ Tag zu GitHub pushen" \
      "a" "⇡ Alle Tags pushen (git push --tags)" \
      "r" "🎁 GitHub-Release für diesen Tag erstellen" \
      "v" "🔍 Diff: Tag ↔ HEAD" \
      "e" "☁ Tag bei GitHub löschen" \
      "x" "🗑 Lokal löschen (git tag -d)" \
      "o" "🌐 Auf GitHub ansehen" \
      "y" "📋 Namen kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; cap "$out" git --no-pager show --stat "$t"; ui_textbox "Tag: $t" "$out" ;;
      c) run_live "Checkout Tag: $t (detached)" git checkout "$t"; refresh_state ;;
      d) : >"$out"; cap "$out" git --no-pager log --oneline --max-count=40 "$t"; ui_textbox "Commits bis $t" "$out" ;;
      p) run_live "Tag pushen: $t" git push origin "$t" ;;
      a) ui_yesno "Alle lokalen Tags zu origin pushen?" "Alle Tags pushen" "Pushen" "Abbrechen" && run_live "Alle Tags pushen" git push --tags ;;
      r) if run_live "Release erstellen (gh release create)" gh release create "$t" --generate-notes --title "$t"; then
           ui_msgbox "Release" "${C_G}${ICON_OK} Release für $t erstellt (Notes automatisch generiert).${C_N}" "OK"
         fi ;;
      v) : >"$out"
         { echo "── Stat: HEAD ↔ $t ──"; git --no-pager diff --stat "$t...HEAD"
           echo; echo "── Diff (erste 800 Zeilen) ──"; git --no-pager diff --color=never "$t...HEAD" | head -n 800; } >"$out"
         ui_textbox "Diff: $t ↔ HEAD" "$out" ;;
      e) ui_yesno "Tag '${C_C}$t${C_N}' auf GitHub löschen?" "Remote-Tag löschen" "Ja, löschen" "Abbrechen" \
           && { : >"$out"; cap "$out" gh api --method DELETE "repos/$REPO_SLUG/git/refs/tags/$t"; ui_textbox "Remote-Tag gelöscht: $t" "$out"; } ;;
      x) ui_yesno "Lokalen Tag '$t' löschen?" "Tag löschen" "Ja" "Abbrechen" \
           && run_live "Tag löschen: $t" git tag -d "$t" ;;
      o) url=$(repo_web_url) || { ui_msgbox "GitHub" "Kein GitHub-Remote gefunden." "OK"; continue; }
         open_url "$url/releases/tag/$t" ;;
      y) copy_ui "Tag-Name" "$t" ;;
      z|"") return 0 ;;
    esac
  done
}

# -------------------------------------------------------- Konflikt-Assistent --
conflict_pick_file() {
  local args=() f
  while IFS= read -r f; do
    [[ -z $f ]] && continue
    args+=("$f" "$f")
  done < <(git diff --name-only --diff-filter=U 2>/dev/null)
  [[ ${#args[@]} -eq 0 ]] && return 1
  ui_menu "Konfliktdatei wählen" "Welche Datei?" "${args[@]}"
}

open_all_conflicts() {
  local files=() bin
  mapfile -t files < <(git diff --name-only --diff-filter=U 2>/dev/null)
  if [[ ${#files[@]} -eq 0 ]]; then ui_msgbox "Konflikte" "Keine Konfliktdateien gefunden." "OK"; return; fi
  bin=$(nvim_bin)
  dialog --clear || true
  printf '\033[1;36m==> nnvim: %d Konfliktdateien — Suche mit  /<<<<<<<  springt zum nächsten Marker\033[0m\n\n' "${#files[@]}"
  printf '    :n / :prev wechselt zwischen den Dateien. Danach Konflikt-Assistent → stage → continue.\n\n'
  sleep 0.7
  if [[ -n $bin ]]; then
    if [[ $bin == nnvim ]]; then nnvim "+/<<<<<<<" "${files[@]}"; else NVIM_APPNAME=nnvim nvim "+/<<<<<<<" "${files[@]}"; fi
  else open_editor "${files[0]}"; fi
}

conflict_tools() {
  local sel f files=() out="$TMPDIR_PRP/git.out"
  mapfile -t files < <(git diff --name-only --diff-filter=U 2>/dev/null)
  sel=$(ui_menu "Konflikt-Werkzeuge" "Konfliktdateien: ${#files[@]}" \
    "m" "🧰 git mergetool starten (konfigurierter Merge-Editor)" \
    "o" "⬅ „unsere“ Version übernehmen (git checkout --ours)" \
    "t" "➡ „deren“ Version übernehmen (git checkout --theirs)" \
    "b" "⟲ Beide Versionen zurückholen (git checkout --merge)" \
    "z" "↩ zurück") || return 0
  if [[ $sel == m ]]; then run_live "git mergetool" git mergetool; refresh_state; return; fi
  f=$(conflict_pick_file) || { ui_msgbox "Konflikt-Werkzeuge" "Aktuell gibt es keine Konfliktdateien." "OK"; return; }
  case $sel in
    o) : >"$out"; cap "$out" git checkout --ours -- "$f"; ui_textbox "„Ours“ übernommen: $f" "$out" ;;
    t) : >"$out"; cap "$out" git checkout --theirs -- "$f"; ui_textbox "„Theirs“ übernommen: $f" "$out" ;;
    b) : >"$out"; cap "$out" git checkout --merge -- "$f"; ui_textbox "Konflikt-Marker wiederhergestellt: $f" "$out" ;;
  esac
}

conflict_assistant() {
  local sel n out="$TMPDIR_PRP/git.out" f op conflicts
  while :; do
    conflicts=$(git diff --name-only --diff-filter=U 2>/dev/null)
    n=$(printf '%s' "$conflicts" | grep -c . )
    op="keine Operation aktiv"
    [[ -d .git/rebase-merge || -d .git/rebase-apply ]] && op="Rebase läuft"
    [[ -f .git/MERGE_HEAD ]] && op="Merge läuft"
    [[ -f .git/CHERRY_PICK_HEAD ]] && op="Cherry-pick läuft"
    [[ -f .git/REVERT_HEAD ]] && op="Revert läuft"
    sel=$(ui_menu "Konflikt-Assistent" "Status: $op   ${SEP}   Konflikte: $n" \
      "l" "📄 Status & Konfliktdateien (git status)" \
      "d" "🔍 Konflikt-Diff einer Datei (mit Markern)" \
      "o" "✍ Datei in nnvim öffnen (Marker bearbeiten)" \
      "g" "✍ Alle Konfliktdateien in nnvim öffnen" \
      "t" "✔ Einzelne Datei als gelöst stagen (git add)" \
      "f" "✔ Alle als gelöst stagen (git add -A)" \
      "h" "🧰 Werkzeuge: mergetool / ours / theirs" \
      "c" "▶ Operation fortsetzen (--continue)" \
      "s" "⏭ Operation überspringen (--skip)" \
      "a" "🛑 Operation abbrechen (--abort)" \
      "?" "Hilfe: Marker erklärt" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" git status; ui_textbox "Konflikt-Status" "$out" ;;
      d) f=$(conflict_pick_file) || { ui_msgbox "Diff" "Keine Konfliktdateien." "OK"; continue; }
         : >"$out"; { echo "Datei: $f"; echo; git --no-pager diff --color=never -- "$f" | head -n 600; } >"$out"
         ui_textbox "Konflikt-Diff: $f" "$out" ;;
      o) f=$(conflict_pick_file) || { ui_msgbox "Öffnen" "Keine Konfliktdateien." "OK"; continue; }
         open_nn_at "$f" "$(grep -n -m1 '<<<<<<<' "$f" 2>/dev/null | cut -d: -f1 | grep . || echo 1)"
         refresh_state ;;
      g) open_all_conflicts; refresh_state ;;
      t) f=$(conflict_pick_file) || continue
         : >"$out"; cap "$out" git add -- "$f"; ui_textbox "Gestaged: $f" "$out" ;;
      f) ui_yesno "ALLE Änderungen als gelöst stagen?\n\n${C_C}git add -A${C_N}" "Alles stagen" "Ja" "Abbrechen" \
           && { : >"$out"; cap "$out" git add -A; ui_textbox "Gestaged" "$out"; } ;;
      h) conflict_tools ;;
      c) if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then run_live "Rebase fortsetzen" git rebase --continue
         elif [[ -f .git/MERGE_HEAD ]]; then run_live "Merge fortsetzen" git commit --no-edit
         elif [[ -f .git/CHERRY_PICK_HEAD ]]; then run_live "Cherry-pick fortsetzen" git cherry-pick --continue
         else ui_msgbox "Fortsetzen" "Keine Operation aktiv." "OK"; fi
         refresh_state ;;
      s) if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then run_live "Rebase überspringen" git rebase --skip
         elif [[ -f .git/CHERRY_PICK_HEAD ]]; then run_live "Cherry-pick überspringen" git cherry-pick --skip
         else ui_msgbox "Überspringen" "Nur bei Rebase/Cherry-pick möglich." "OK"; fi
         refresh_state ;;
      a) ui_yesno "⚠ Operation WIRKLICH abbrechen?\n\nDer Originalzustand wird wiederhergestellt;\nalle Konfliktauflösungen gehen verloren." "Abbrechen" "Ja, abbrechen" "Nein" || continue
         if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then run_live "Rebase abbrechen" git rebase --abort
         elif [[ -f .git/MERGE_HEAD ]]; then run_live "Merge abbrechen" git merge --abort
         elif [[ -f .git/CHERRY_PICK_HEAD ]]; then run_live "Cherry-pick abbrechen" git cherry-pick --abort
         elif [[ -f .git/REVERT_HEAD ]]; then run_live "Revert abbrechen" git revert --abort
         else ui_msgbox "Abbrechen" "Keine Operation aktiv." "OK"; fi
         refresh_state ;;
      "?") ui_msgbox "Konflikt-Marker" "${C_C}<<<<<<< HEAD${C_N}   = dein aktueller Stand (ours)\n${C_C}=======${C_N}        = Trennlinie\n${C_C}>>>>>>> other${C_N} = der andere Stand (theirs)\n\nIn nnvim: Datei öffnen, Marker entfernen, gewünschten Code behalten.\nDann hier: „als gelöst stagen“ → „Operation fortsetzen“." "OK" ;;
      z|"") return 0 ;;
    esac
  done
}

# -------------------------------------------------------------- Cherry-pick --
cherry_pick_series() {
  local from to list="$TMPDIR_PRP/cherry.tsv" sel line shas=()
  from=$(ref_picker "$DEFAULT_BRANCH") || return 0
  [[ -z $from ]] && return 0
  to=$(ui_inputbox "Cherry-pick" "Commits von (exklusiv):  $from\nbis (inklusive; leer = HEAD):" "") || return 0
  to=${to:-HEAD}
  git log --reverse --format='%h%x09%s' "$from..$to" >"$list" 2>/dev/null
  if [[ ! -s $list ]]; then ui_msgbox "Cherry-pick" "Keine Commits gefunden in  $from..$to" "OK"; return 0; fi
  mapfile -t sel < <(FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --multi --keep-order \
      --delimiter=$'\t' --with-nth=2.. \
      --header="Cherry-pick: $from..$to — TAB = mehrere wählen, ENTER = übernehmen" \
      --preview='git --no-pager show --stat --color=always {1}' <"$list")
  [[ ${#sel[@]} -eq 0 ]] && return 0
  for line in "${sel[@]}"; do shas+=("${line%%$'\t'*}"); done
  ui_yesno "Diese ${#shas[@]} Commits auf '${CURRENT_BRANCH}' cherry-picken?\n\n${C_C}git cherry-pick $(join_by ' ' "${shas[@]}")${C_N}" \
    "Cherry-pick" "Los" "Abbrechen" || return 0
  run_live "Cherry-pick (${#shas[@]} Commits)" git cherry-pick "${shas[@]}"
  refresh_state
}

# ------------------------------------------------------------------- Stash --
stash_pick() {
  local args=() line
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    args+=("${line%%:*}" "$(printf '%s' "$line" | cut -c1-96)")
  done < <(git stash list 2>/dev/null)
  [[ ${#args[@]} -eq 0 ]] && return 1
  ui_menu "Stash wählen" "Welcher Stash?" "${args[@]}"
}

stash_menu() {
  local sel out="$TMPDIR_PRP/git.out" idx msg br
  while :; do
    sel=$(ui_menu "Stash" "Einträge: $(git stash list | wc -l)   ${SEP}   git stash list" \
      "s" "＋ Aktuelle Änderungen stashen (mit Nachricht)" \
      "u" "＋ Inkl. untracked Dateien stashen (git stash -u)" \
      "p" "▶ Neuesten Stash wieder anwenden & löschen (pop)" \
      "a" "▶ Stash anwenden, aber behalten (apply)" \
      "d" "🔍 Stash anzeigen (show -p)" \
      "b" "🌿 Branch aus Stash erstellen (stash branch)" \
      "e" "🗑 Einzelnen Stash löschen" \
      "X" "🗑 Alle Stashes löschen (stash clear)" \
      "l" "📄 Stash-Liste anzeigen" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) msg=$(ui_inputbox "Stash" "Nachricht für den Stash (leer = automatisch):" "") || continue
         if [[ -n $msg ]]; then run_live "Stash anlegen" git stash push -m "$msg"; else run_live "Stash anlegen" git stash push; fi
         refresh_state ;;
      u) run_live "Stash inkl. untracked" git stash push -u; refresh_state ;;
      p) [[ -z "$(git stash list)" ]] && { ui_msgbox "Stash" "Kein Stash vorhanden." "OK"; continue; }
         run_live "Stash anwenden (pop)" git stash pop; refresh_state ;;
      a) idx=$(stash_pick) || continue; run_live "Stash anwenden ($idx)" git stash apply "$idx"; refresh_state ;;
      d) idx=$(stash_pick) || continue; : >"$out"; cap "$out" git --no-pager stash show -p "$idx"; ui_textbox "Stash: $idx" "$out" ;;
      b) idx=$(stash_pick) || continue
         br=$(ui_inputbox "Branch aus Stash" "Neuer Branch-Name:" "") || continue
         [[ -z $br ]] && continue
         run_live "Branch aus Stash: $br" git stash branch "$br" "$idx"; refresh_state ;;
      e) idx=$(stash_pick) || continue
         ui_yesno "Stash '${C_C}$idx${C_N}' endgültig löschen?" "Stash löschen" "Löschen" "Abbrechen" \
           && { : >"$out"; cap "$out" git stash drop "$idx"; ui_textbox "Stash gelöscht" "$out"; } ;;
      X) ui_yesno "⚠ ALLE Stashes dieses Repos löschen?" "Stash clear" "Alle löschen" "Abbrechen" \
           && run_live "Alle Stashes löschen" git stash clear ;;
      l) : >"$out"; cap "$out" git stash list; ui_textbox "Stash-Liste" "$out" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------------ Reflog --
reflog_pick() {
  local line
  line=$(git reflog --format='%h%x09%gd  %gs' 2>/dev/null | head -60 \
      | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" --delimiter=$'\t' --with-nth=2.. \
        --header='Reflog-Commit wählen (ENTER)' --preview='git --no-pager show --stat --color=always {1}')
  [[ -z $line ]] && return 1
  printf '%s' "${line%%$'\t'*}"
}

reflog_menu() {
  local sel sha out="$TMPDIR_PRP/git.out" br mode f
  while :; do
    sel=$(ui_menu "Reflog — Zeitreise" "Verlorene Commits finden & retten (git reflog)" \
      "l" "📜 Reflog anzeigen" \
      "g" "🌳 Reflog als Graph" \
      "c" "🔍 Commit aus Reflog ansehen" \
      "d" "🔍 Diff HEAD ↔ Reflog-Commit" \
      "r" "↺ HEAD auf Reflog-Commit setzen (soft/mixed/hard)" \
      "b" "🌿 Rettungs-Branch aus Reflog-Commit" \
      "f" "↺ Datei aus Reflog-Commit holen (git restore --source)" \
      "y" "📋 Commit-Hash kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" git --no-pager reflog --date=relative; ui_textbox "Reflog" "$out" ;;
      g) : >"$out"; cap "$out" git --no-pager log -g --oneline --graph --decorate; ui_textbox "Reflog (Graph)" "$out" ;;
      c) sha=$(reflog_pick) || continue; : >"$out"; cap "$out" git --no-pager show --stat "$sha"; ui_textbox "Commit $sha" "$out" ;;
      d) sha=$(reflog_pick) || continue
         : >"$out"; { git --no-pager diff --stat "$sha" HEAD; echo; git --no-pager diff --color=never "$sha" HEAD | head -n 600; } >"$out"
         ui_textbox "Diff: $sha ↔ HEAD" "$out" ;;
      r) sha=$(reflog_pick) || continue
         mode=$(ui_menu "Reset-Modus" "HEAD auf $sha setzen — wie?" \
              "soft"  "soft — Änderungen bleiben gestaged" \
              "mixed" "mixed — Änderungen bleiben, unstaged" \
              "hard"  "hard — ALLES verwerfen (Vorsicht!)") || continue
         if [[ $mode == hard ]]; then
           ui_yesno "⚠ HART zurücksetzen auf $sha?\n\nOffene und gestagte Änderungen gehen verloren." "Reset --hard" "Ja, hart" "Abbrechen" || continue
         fi
         run_live "Reset ($mode) auf $sha" git reset --"$mode" "$sha"; refresh_state ;;
      b) sha=$(reflog_pick) || continue
         br=$(ui_inputbox "Rettungs-Branch" "Neuer Branch-Name:" "rescue/$(date +%m%d-%H%M)") || continue
         [[ -z $br ]] && continue
         run_live "Rettungs-Branch: $br → $sha" git branch "$br" "$sha"; refresh_state ;;
      f) sha=$(reflog_pick) || continue
         f=$(ui_inputbox "Datei wiederherstellen" "Pfad relativ zum Repo:" "") || continue
         [[ -z $f ]] && continue
         run_live "Datei aus $sha holen" git restore --source="$sha" -- "$f" ;;
      y) sha=$(reflog_pick) || continue; copy_ui "Commit-Hash" "$sha" ;;
      z|"") return 0 ;;
    esac
  done
}

# -------------------------------------------------------- Commit-Reparatur --
# Dateien aus dem Arbeitsstand mehrfach wählen → Pfade auf stdout
pick_changed_multi() {
  local line out=() args=() sel
  if fzf_available; then
    while IFS= read -r line; do [[ -n $line ]] && out+=("${line#*$'\t'}"); done \
      < <(fzf_select_files changed multi 'Dateien wählen (TAB = mehrere, ENTER = übernehmen)')
  else
    while IFS=$'\t' read -r xy f; do args+=("$f" "$xy $f"); done < <(changed_files)
    [[ ${#args[@]} -eq 0 ]] && return 1
    while :; do
      sel=$(ui_menu "Dateien wählen" "Eine Datei pro Durchlauf wählen\n(Abbrechen = fertig)" "${args[@]}") || break
      out+=("$sel")
    done
  fi
  [[ ${#out[@]} -eq 0 ]] && return 1
  printf '%s\n' "${out[@]}"
}

repair_menu() {
  local sel out="$TMPDIR_PRP/git.out" n msg files=() f
  while :; do
    sel=$(ui_menu "Commit-Reparatur" "$(git log -1 --format='%h %s' 2>/dev/null | cut -c1-50)   ${SEP}   offen: $(git status --porcelain | wc -l) Dateien" \
      "u" "↩ Letzten Commit rückgängig — Änderungen bleiben (reset --soft)" \
      "h" "🗑 Letzten Commit verwerfen — hart (reset --hard)" \
      "a" "✏ Letzten Commit bearbeiten (amend, Editor öffnet)" \
      "n" "✏ Nur Commit-Nachricht ändern (amend -m)" \
      "m" "＋ Gestagte Änderungen an letzten Commit anhängen (--amend)" \
      "f" "🔧 Fixup-Commit für HEAD (--fixup) + Autosquash-Hinweis" \
      "s" "⇄ Letzte N Commits zu einem zusammenfassen (squash)" \
      "g" "＋ Dateien stagen (git add)" \
      "k" "✂ Dateien unstagen (restore --staged)" \
      "r" "↺ Datei(en) auf HEAD zurücksetzen (Arbeitsstand)" \
      "x" "💥 Datei(en) KOMPLETT verwerfen (auch untracked)" \
      "c" "🧹 Untracked aufräumen (git clean)" \
      "z" "↩ zurück") || return 0
    case $sel in
      u) ui_yesno "Letzten Commit rückgängig machen?\n\n${C_C}git reset --soft HEAD~1${C_N}\n\nDie Änderungen bleiben gestaged." "Reset --soft" "Ja" "Abbrechen" || continue
         : >"$out"; if cap "$out" git reset --soft HEAD~1; then refresh_state; ui_textbox "Letzter Commit zurückgenommen" "$out"; else ui_textbox "Fehler (einziger Commit?)" "$out"; fi ;;
      h) ui_yesno "⚠ Letzten Commit VERWERFEN?\n\n${C_R}Alle Änderungen dieses Commits gehen verloren (reset --hard).${C_N}" "Reset --hard" "Ja, verwerfen" "Abbrechen" || continue
         : >"$out"; cap "$out" git reset --hard HEAD~1; refresh_state; ui_textbox "Commit verworfen" "$out" ;;
      a) run_live "Commit bearbeiten (amend)" git commit --amend; refresh_state ;;
      n) msg=$(git log -1 --format='%s' 2>/dev/null)
         msg=$(ui_inputbox "Commit-Nachricht" "Neue Nachricht für HEAD:" "$msg") || continue
         [[ -z $msg ]] && continue
         : >"$out"; cap "$out" git commit --amend -m "$msg"; refresh_state; ui_textbox "Commit-Nachricht geändert" "$out" ;;
      m) [[ -z "$(git diff --cached --name-only)" ]] && { ui_msgbox "Amend" "Keine gestagten Änderungen — erst Dateien stagen." "OK"; continue; }
         ui_yesno "Gestagte Änderungen an den letzten Commit anhängen?\n\n${C_C}git commit --amend --no-edit${C_N}" "Amend" "Anhängen" "Abbrechen" \
           && { : >"$out"; cap "$out" git commit --amend --no-edit; refresh_state; ui_textbox "Angehängt" "$out"; } ;;
      f) [[ -z "$(git diff --cached --name-only)" ]] && { ui_msgbox "Fixup" "Keine gestagten Änderungen." "OK"; continue; }
         : >"$out"; cap "$out" git commit --fixup HEAD; refresh_state
         ui_msgbox "Fixup" "${C_G}${ICON_OK} Fixup-Commit erstellt.${C_N}\n\nBeim Rebase einbauen:\n${C_C}git rebase -i --autosquash HEAD~2${C_N}" "OK" ;;
      s) n=$(ask_number "Wie viele der letzten Commits zu EINEM zusammenfassen?" "Squash") || continue
         (( n >= 2 )) || { ui_msgbox "Squash" "Mindestens 2 Commits angeben." "OK"; continue; }
         ui_yesno "Letzte ${C_C}$n${C_N} Commits zusammenfassen?\n\n(${C_C}git reset --soft HEAD~$n${C_N}, danach neuer Commit)" "Squash" "Weiter" "Abbrechen" || continue
         : >"$out"
         if cap "$out" git reset --soft "HEAD~$n"; then
           refresh_state
           run_live "Squash: neuen Commit schreiben (Editor öffnet)" git commit
         else
           ui_textbox "Fehler" "$out"
         fi ;;
      g) mapfile -t files < <(pick_changed_multi) || { ui_msgbox "Stagen" "Keine Dateien ausgewählt." "OK"; continue; }
         : >"$out"; cap "$out" git add -- "${files[@]}"; refresh_state; ui_textbox "Gestaged" "$out" ;;
      k) mapfile -t files < <(pick_changed_multi) || continue
         : >"$out"; if ! cap "$out" git restore --staged -- "${files[@]}" 2>/dev/null; then cap "$out" git reset -- "${files[@]}"; fi
         refresh_state; ui_textbox "Unstaged" "$out" ;;
      r) mapfile -t files < <(pick_changed_multi) || continue
         ui_yesno "Arbeitsstands-Änderungen dieser Dateien verwerfen?\n\n${files[*]}" "Zurücksetzen" "Verwerfen" "Abbrechen" || continue
         : >"$out"; cap "$out" git restore -- "${files[@]}"; refresh_state; ui_textbox "Zurückgesetzt" "$out" ;;
      x) mapfile -t files < <(pick_changed_multi) || continue
         ui_yesno "⚠ Dateien KOMPLETT verwerfen (auch neue/untracked)?\n\n${files[*]}" "Komplett verwerfen" "Ja, verwerfen" "Abbrechen" || continue
         : >"$out"
         for f in "${files[@]}"; do
           if git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then cap "$out" git restore --source=HEAD --staged --worktree -- "$f"
           else cap "$out" git clean -f -- "$f"; fi
         done
         refresh_state; ui_textbox "Verworfen" "$out" ;;
      c) : >"$out"; cap "$out" git clean -nd
         ui_textbox "Vorschau: git clean -nd" "$out"
         if ui_yesno "Jetzt löschen?\n\n${C_C}git clean -fd${C_N}\n(untracked Dateien + leere Ordner)" "Clean" "Löschen (-fd)" "Abbrechen"; then
           : >"$out"; cap "$out" git clean -fd; ui_textbox "Clean ausgeführt" "$out"
         elif ui_yesno "Auch IGNORIERTE Dateien löschen?\n\n${C_R}git clean -fdx${C_N} — löscht auch Build-Artefakte, lokale Configs …" "Clean -fdx" "Ja, -fdx" "Nein"; then
           : >"$out"; cap "$out" git clean -fdx; ui_textbox "Clean -fdx ausgeführt" "$out"
         fi ;;
      z|"") return 0 ;;
    esac
  done
}

# ---------------------------------------------------------------- Worktrees --
worktree_pick() {
  local args=() line
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    args+=("${line%% *}" "$line")
  done < <(git worktree list 2>/dev/null)
  [[ ${#args[@]} -eq 0 ]] && return 1
  ui_menu "Worktree wählen" "Welcher Worktree?" "${args[@]}"
}

worktree_menu() {
  local sel path br base out="$TMPDIR_PRP/git.out" def
  while :; do
    sel=$(ui_menu "Git-Worktrees" "Parallele Arbeitsbäume desselben Repos   ${SEP}   aktiv: $(git worktree list | wc -l)" \
      "l" "📄 Worktrees auflisten" \
      "a" "＋ Neuen Worktree anlegen (eigenes Verzeichnis)" \
      "o" "✍ Worktree in nnvim öffnen" \
      "c" "⌨️ Shell im Worktree öffnen" \
      "r" "🗑 Worktree entfernen" \
      "p" "🧹 Veraltete Worktrees aufräumen (prune)" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" git worktree list; ui_textbox "Worktrees" "$out" ;;
      a) base=$(ref_picker "$CURRENT_BRANCH") || continue
         br=$(ui_inputbox "Neuer Worktree" "Neuer Branch-Name\n(leer = Ref '$base' direkt auschecken):" "") || continue
         def="$HOME/worktrees/${REPO_NAME}-$(date +%m%d-%H%M%S)"
         path=$(ui_inputbox "Worktree-Pfad" "Verzeichnis (wird angelegt):" "$def") || continue
         [[ -z $path ]] && continue
         if [[ -n $br ]]; then run_live "Worktree: $path — neuer Branch $br" git worktree add -b "$br" "$path" "$base"
         else run_live "Worktree: $path — $base" git worktree add "$path" "$base"; fi ;;
      o) path=$(worktree_pick) || continue; open_nn_folder "$path" ;;
      c) path=$(worktree_pick) || continue; run_live "Shell in $path" bash -c 'cd "$1" && exec "${SHELL:-/bin/bash}"' _ "$path" ;;
      r) path=$(worktree_pick) || continue
         [[ $path == "$PWD" ]] && { ui_msgbox "Worktree" "Der aktuelle Worktree kann hier nicht entfernt werden." "OK"; continue; }
         ui_yesno "Worktree '${C_C}$path${C_N}' entfernen?" "Worktree entfernen" "Entfernen" "Abbrechen" || continue
         : >"$out"
         if cap "$out" git worktree remove "$path"; then ui_textbox "Worktree entfernt" "$out"
         else ui_yesno "Entfernen fehlgeschlagen (Änderungen darin?).\n\nMit ${C_R}--force${C_N} trotzdem entfernen?" "Force" "Ja, --force" "Nein" \
                && { : >"$out"; cap "$out" git worktree remove --force "$path"; ui_textbox "Worktree (force) entfernt" "$out"; }
         fi ;;
      p) : >"$out"; cap "$out" git worktree prune -v; ui_textbox "Prune" "$out" ;;
      z|"") return 0 ;;
    esac
  done
}

# --- PART7-B-ENDE ---

# ------------------------------------------------- Konfiguration & Aliase --
git_config_menu() {
  local sel out="$TMPDIR_PRP/git.out" key val name cmd cur aliases=() line
  while :; do
    sel=$(ui_menu "Git-Konfiguration & Aliase" "user: $(git config user.name 2>/dev/null || echo '—')   ${SEP}   pull.rebase: $(git config pull.rebase 2>/dev/null || echo '—')" \
      "l" "📄 Lokale Config anzeigen (--local)" \
      "o" "📄 Globale Config anzeigen (--global)" \
      "s" "✏ Eintrag setzen (lokal)" \
      "g" "✏ Eintrag global setzen" \
      "d" "🗑 Eintrag löschen (lokal)" \
      "u" "👤 user.name / user.email setzen (lokal)" \
      "a" "🔧 Alias anlegen" \
      "i" "📄 Aliase auflisten" \
      "x" "🗑 Alias löschen" \
      "e" "🧰 Editor / mergetool setzen" \
      "r" "🔁 rerere aktivieren (Konfliktauflösungen merken)" \
      "p" "⇄ pull.rebase umschalten (merge ↔ rebase)" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" git --no-pager config --list --local; ui_textbox "Lokale Config" "$out" ;;
      o) : >"$out"; cap "$out" git --no-pager config --list --global; ui_textbox "Globale Config" "$out" ;;
      s|g) [[ $sel == s ]] && scope=--local || scope=--global
         key=$(ui_inputbox "git config" "Schlüssel (z. B. core.autocrlf):" "") || continue
         [[ -z $key ]] && continue
         val=$(ui_inputbox "git config $key" "Wert:" "$(git config "$key" 2>/dev/null)") || continue
         : >"$out"; cap "$out" git config "$scope" "$key" "$val"; ui_textbox "Gesetzt: $key" "$out" ;;
      d) key=$(ui_inputbox "Eintrag löschen" "Schlüssel (lokal):" "") || continue
         [[ -z $key ]] && continue
         ui_yesno "Lokalen Eintrag '${C_C}$key${C_N}' löschen?" "Config löschen" "Löschen" "Abbrechen" \
           && { : >"$out"; cap "$out" git config --local --unset "$key"; ui_textbox "Gelöscht" "$out"; } ;;
      u) name=$(ui_inputbox "user.name" "Name:" "$(git config user.name 2>/dev/null)") || continue
         cmd=$(ui_inputbox "user.email" "E-Mail:" "$(git config user.email 2>/dev/null)") || continue
         : >"$out"; cap "$out" git config --local user.name "$name"; cap "$out" git config --local user.email "$cmd"
         ui_textbox "Benutzer gesetzt (lokal)" "$out" ;;
      a) name=$(ui_inputbox "Alias anlegen" "Alias-Name (z. B. lg):" "") || continue
         [[ -z $name ]] && continue
         cmd=$(ui_inputbox "Alias: git $name" "Befehl (z. B. log --oneline --graph --decorate):" "") || continue
         [[ -z $cmd ]] && continue
         : >"$out"; cap "$out" git config --local "alias.$name" "$cmd"
         ui_msgbox "Alias" "${C_G}${ICON_OK} Angelegt.${C_N}\n\nAufruf im Terminal:\n${C_C}git $name${C_N}" "OK" ;;
      i) : >"$out"; cap "$out" git --no-pager config --local --get-regexp '^alias\.'; ui_textbox "Aliase (lokal)" "$out" ;;
      x) aliases=()
         while IFS= read -r line; do
           [[ -z $line ]] && continue
           aliases+=("${line%% *}" "${line#alias.}")
         done < <(git config --local --get-regexp '^alias\.' 2>/dev/null | sed 's/^alias\.//')
         [[ ${#aliases[@]} -eq 0 ]] && { ui_msgbox "Aliase" "Keine lokalen Aliase vorhanden." "OK"; continue; }
         name=$(ui_menu "Alias löschen" "Welcher Alias?" "${aliases[@]}") || continue
         ui_yesno "Alias '$name' löschen?" "Alias löschen" "Löschen" "Abbrechen" \
           && { : >"$out"; cap "$out" git config --local --unset "alias.$name"; ui_textbox "Gelöscht" "$out"; } ;;
      e) cur=$(git config core.editor 2>/dev/null || echo "${EDITOR:-nvim}")
         val=$(ui_inputbox "Editor" "core.editor (z. B. nvim):" "$cur") || continue
         [[ -n $val ]] && { : >"$out"; cap "$out" git config --local core.editor "$val"; ui_textbox "Editor gesetzt" "$out"; }
         cur=$(git config merge.tool 2>/dev/null)
         val=$(ui_inputbox "Mergetool" "merge.tool (z. B. nvim, meld, kdiff3):" "$cur") || continue
         [[ -n $val ]] && { : >"$out"; cap "$out" git config --local merge.tool "$val"; ui_textbox "Mergetool gesetzt" "$out"; } ;;
      r) : >"$out"; cap "$out" git config --local rerere.enabled true; ui_textbox "rerere aktiviert" "$out" ;;
      p) cur=$(git config pull.rebase 2>/dev/null)
         if [[ $cur == true ]]; then val=false; else val=true; fi
         ui_yesno "pull.rebase: '$cur' → '$val' setzen?\n\n(true = Rebase beim Pull, false = Merge)" "pull.rebase" "Setzen" "Abbrechen" \
           && { : >"$out"; cap "$out" git config --local pull.rebase "$val"; ui_textbox "pull.rebase = $val" "$out"; } ;;
      z|"") return 0 ;;
    esac
  done
}

# --------------------------------------------------------------- .gitignore --
gitignore_menu() {
  local sel out="$TMPDIR_PRP/ignore.out" pat preset presets=""
  while :; do
    sel=$(ui_menu ".gitignore" "Datei: $( [[ -f .gitignore ]] && echo vorhanden || echo 'fehlt' )" \
      "s" "📄 .gitignore anzeigen" \
      "a" "＋ Muster hinzufügen" \
      "p" "📦 Vorlagen-Block hinzufügen (Java/Gradle/IDE/OS)" \
      "i" "🔍 Prüfen, ob Datei ignoriert wird (check-ignore)" \
      "g" "📄 Aktuell ignorierte Dateien (status --ignored)" \
      "f" "🔍 Ignorierte Datei trotzdem stagen (git add -f)" \
      "o" "✍ .gitignore in nnvim öffnen" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; if [[ -f .gitignore ]]; then cap "$out" cat .gitignore; else echo "(keine .gitignore im Repo)" >"$out"; fi
         ui_textbox ".gitignore" "$out" ;;
      a) pat=$(ui_inputbox "Muster hinzufügen" "Muster (z. B. build/ oder *.log):" "") || continue
         [[ -z $pat ]] && continue
         : >"$out"; printf '%s\n' "$pat" >>.gitignore; printf 'hinzugefügt: %s\n' "$pat" >>"$out"
         cap "$out" git status --short | head -n 15
         ui_textbox ".gitignore erweitert" "$out" ;;
      p) presets=$(ui_menu "Vorlagen" "Welcher Block?" \
           "@java"  "Java (*.class, build/, .gradle/)" \
           "@idea"  "IntelliJ (/.idea/, *.iml)" \
           "@ecl"   "Eclipse (.classpath, .project, bin/)" \
           "@code"  "VS Code (.vscode/)" \
           "@os"    "Betriebssystem (.DS_Store, Thumbs.db, *~)" \
           "@log"   "Logs & Temp (*.log, *.tmp, tmp/)" \
           "z"      "↩ zurück") || continue
         [[ $sel == z ]] && continue
         case $presets in
           @java) printf '# Java\n*.class\nbuild/\n.gradle/\n' >>.gitignore ;;
           @idea) printf '# IntelliJ\n/.idea/\n*.iml\n*.ipr\n*.iws\n' >>.gitignore ;;
           @ecl)  printf '# Eclipse\n.classpath\n.project\n.settings/\nbin/\n' >>.gitignore ;;
           @code) printf '# VS Code\n.vscode/\n' >>.gitignore ;;
           @os)   printf '# OS\n.DS_Store\nThumbs.db\n*~\n' >>.gitignore ;;
           @log)  printf '# Logs/Temp\n*.log\n*.tmp\ntmp/\n' >>.gitignore ;;
         esac
         ui_msgbox ".gitignore" "${C_G}${ICON_OK} Block '$presets' angehängt.${C_N}" "OK" ;;
      i) pat=$(ui_inputbox "check-ignore" "Pfad eingeben:" "") || continue
         [[ -z $pat ]] && continue
         : >"$out"; cap "$out" git check-ignore -v -- "$pat" || true
         [[ -s $out ]] || printf 'Nicht ignoriert (oder Datei existiert nicht): %s\n' "$pat" >"$out"
         ui_textbox "Ignorier-Check: $pat" "$out" ;;
      g) : >"$out"; cap "$out" bash -c 'git status --ignored --short | head -n 80'; ui_textbox "Ignorierte Dateien" "$out" ;;
      f) pat=$(ui_inputbox "git add -f" "Pfad der ignorierten Datei:" "") || continue
         [[ -z $pat ]] && continue
         : >"$out"; cap "$out" git add -f -- "$pat"; refresh_state; ui_textbox "Erzwungen gestaged" "$out" ;;
      o) if [[ -f .gitignore ]]; then open_nn_folder .gitignore; else ui_msgbox ".gitignore" "Noch keine .gitignore vorhanden — über „Muster hinzufügen“ anlegen." "OK"; fi ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------ Submodule & Git-LFS --
module_menu() {
  local sel out="$TMPDIR_PRP/module.out" url path pat
  while :; do
    sel=$(ui_menu "Submodule & Git-LFS" "Submodule: $(git submodule status 2>/dev/null | wc -l)   ${SEP}   LFS: $(git lfs version 2>/dev/null | head -1 || echo 'nicht installiert')" \
      "s" "📄 Submodule-Status" \
      "u" "⬇ Submodule initialisieren/aktualisieren (--init --recursive)" \
      "y" "⟳ Submodule synchronisieren (sync --recursive)" \
      "a" "＋ Submodule hinzufügen (URL + Pfad)" \
      "r" "⟳ Submodule auf Remote-Stand ziehen (--remote)" \
      "d" "🗑 Submodule deinit + entfernen (Vorsicht)" \
      "l" "📄 LFS: getrackte Dateien (lfs ls-files)" \
      "t" "＋ LFS: Muster tracken (git lfs track)" \
      "p" "⬇ LFS: Dateien ziehen (git lfs pull)" \
      "i" "🧰 LFS installieren (git lfs install)" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; cap "$out" git submodule status; ui_textbox "Submodule" "$out" ;;
      u) run_live "Submodule aktualisieren" git submodule update --init --recursive; refresh_state ;;
      y) run_live "Submodule sync" git submodule sync --recursive; refresh_state ;;
      a) url=$(ui_inputbox "Submodule hinzufügen" "URL (https://github.com/…):" "") || continue
         [[ -z $url ]] && continue
         path=$(ui_inputbox "Submodule" "Zielpfad im Repo:" "") || continue
         [[ -z $path ]] && continue
         run_live "Submodule add" git submodule add "$url" "$path" ;;
      r) run_live "Submodule --remote" git submodule update --remote --recursive; refresh_state ;;
      d) path=$(ui_inputbox "Submodule entfernen" "Pfad des Submodules:" "") || continue
         [[ -z $path ]] && continue
         ui_yesno "⚠ Submodule '$path' entfernen?\n\n(deinit + git rm; .git/modules bleibt ggf. übrig)" "Submodule" "Entfernen" "Abbrechen" || continue
         : >"$out"; cap "$out" git submodule deinit -f -- "$path"; cap "$out" git rm -f -- "$path"; refresh_state; ui_textbox "Submodule entfernt" "$out" ;;
      l) : >"$out"; cap "$out" git lfs ls-files 2>/dev/null || true; ui_textbox "LFS-Dateien" "$out" ;;
      t) pat=$(ui_inputbox "git lfs track" "Muster (z. B. *.jar oder assets/**):" "") || continue
         [[ -z $pat ]] && continue
         : >"$out"; cap "$out" git lfs track "$pat"; ui_textbox "LFS track" "$out" ;;
      p) run_live "git lfs pull" git lfs pull ;;
      i) run_live "git lfs install" git lfs install ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------------ Wartung --
cleanup_merged_branches() {
  local names=() b deleted=0
  mapfile -t names < <(git branch --merged "$DEFAULT_BRANCH" --format='%(refname:short)' 2>/dev/null \
      | grep -v -x -e "$CURRENT_BRANCH" -e "$DEFAULT_BRANCH")
  [[ ${#names[@]} -eq 0 ]] && { ui_msgbox "Branch-Aufräumen" "Keine vollständig gemergten Branches gefunden." "OK"; return; }
  if ui_yesno "Diese ${#names[@]} Branches sind in '$DEFAULT_BRANCH' gemergt:\n\n$(join_by $'\n' "${names[@]}")\n\nAlle löschen?" "Aufräumen" "Löschen" "Abbrechen"; then
    for b in "${names[@]}"; do
      git branch -d "$b" >/dev/null 2>&1 && ((deleted++))
    done
    refresh_state
    ui_msgbox "Branch-Aufräumen" "${C_G}${ICON_OK} $deleted Branch(es) gelöscht.${C_N}" "OK"
  fi
}

maintenance_menu() {
  local sel out="$TMPDIR_PRP/maint.out"
  while :; do
    sel=$(ui_menu "Wartung & Aufräumen" "Repo: $(du -sh .git 2>/dev/null | cut -f1)   ${SEP}   Objekte: $(git count-objects -v 2>/dev/null | awk -F': ' '/^count/{s+=$2} END{print s}')" \
      "f" "⬇ Alles holen & aufräumen (fetch --all --prune --tags)" \
      "p" "⬇ Nur origin prunen (remote prune origin)" \
      "g" "🧹 Garbage Collection (git gc)" \
      "c" "⚡ Commit-Graph schreiben (schnellere Logs)" \
      "o" "📄 Objekt-Statistik (count-objects -vH)" \
      "k" "🔍 Repo-Integrität prüfen (git fsck)" \
      "b" "🌿 Gemergte Branches aufräumen" \
      "z" "↩ zurück") || return 0
    case $sel in
      f) run_live "Alles holen + prunen" git fetch --all --prune --tags; refresh_state ;;
      p) run_live "origin prune" git remote prune origin ;;
      g) run_live "git gc" git gc ;;
      c) : >"$out"; cap "$out" git commit-graph write --reachable --changed-paths; ui_textbox "Commit-Graph" "$out" ;;
      o) : >"$out"; cap "$out" git count-objects -vH; ui_textbox "Objekt-Statistik" "$out" ;;
      k) : >"$out"; cap "$out" git fsck --no-progress 2>&1 | head -n 120; ui_textbox "fsck" "$out" ;;
      b) cleanup_merged_branches ;;
      z|"") return 0 ;;
    esac
  done
}

# --------------------------------------------------------------- Live-Status --
live_status() {
  local key
  dialog --clear || true
  while :; do
    clear
    printf '\033[1;36m⟳ Live-Status — %s\033[0m\n\n' "$(date '+%H:%M:%S')"
    printf '\033[1;35mRepo:\033[0m %s   \033[1;35mBranch:\033[0m %s\n\n' "$REPO_NAME" "$CURRENT_BRANCH"
    git -c color.ui=always status --short --branch
    printf '\n\033[1;36mLetzte Commits:\033[0m\n'
    git --no-pager log --oneline -5 --color=always
    printf '\n\033[2m(alle 2 Sekunden neu · Taste q beendet)\033[0m'
    key=""
    read -r -t 2 -n 1 key
    [[ $key == q ]] && break
  done
}

# ------------------------------------------------------------- Repo-Analyse --
repo_analysis() {
  local out="$TMPDIR_PRP/analysis.txt"
  {
    echo "══ Überblick ══"
    printf 'Commits:            %s\n' "$(git rev-list --count HEAD 2>/dev/null)"
    printf 'Beitragende:        %s\n' "$(git shortlog -sn HEAD 2>/dev/null | wc -l)"
    printf 'Lokale Branches:    %s\n' "$(git for-each-ref --format='%(refname:short)' refs/heads | wc -l)"
    printf 'Tags:               %s\n' "$(git tag | wc -l)"
    printf 'Erster Commit:      %s\n' "$(git log --reverse --format='%ad' --date=short 2>/dev/null | head -1)"
    printf 'Letzter Commit:     %s\n' "$(git log -1 --format='%ad' --date=short 2>/dev/null)"
    printf 'Größe .git:         %s\n' "$(du -sh .git 2>/dev/null | cut -f1)"
    echo
    echo "══ Top 20 Beitragende ══"
    git shortlog -sn --no-merges HEAD 2>/dev/null | head -20
    echo
    echo "══ Aktivität pro Monat (letzte 12 Monate) ══"
    git log --date=format:'%Y-%m' --format='%ad' 2>/dev/null | sort | uniq -c | tail -12
    echo
    echo "══ Die 15 meistgeänderten Dateien (letzte 800 Commits) ══"
    git log -n 800 --format='' --name-only 2>/dev/null | grep -v '^$' | sort | uniq -c | sort -rn | head -15
  } >"$out"
  ui_textbox "Repo-Analyse: $REPO_NAME" "$out"
}

# --- PART7-C-ENDE ---

# --------------------------------------------------------------- Changelog --
changelog_gen() {
  local from to out="$TMPDIR_PRP/changelog.md" n sec title found line
  from=$(ref_picker "$DEFAULT_BRANCH") || return 0
  [[ -z $from ]] && return 0
  to=$(ui_inputbox "Changelog" "Commits von (exklusiv):  $from\nbis (inklusive; leer = HEAD):" "") || return 0
  to=${to:-HEAD}
  n=$(git rev-list --count "$from..$to" 2>/dev/null || echo 0)
  (( n > 0 )) || { ui_msgbox "Changelog" "Keine Commits in  $from..$to" "OK"; return 0; }
  {
    printf '# Änderungen: %s … %s\n\n' "$from" "$to"
    printf 'Zeitraum: %s bis %s · **%s Commits**\n\n' \
      "$(git log --reverse --format=%ad --date=short "$from..$to" 2>/dev/null | head -1)" \
      "$(git log -1 --format=%ad --date=short "$to" 2>/dev/null)" "$n"
    printf '> Automatisch erzeugt – Commit-Typen (feat/fix/…) gruppiert.\n\n'
    for sec in feat fix docs refactor perf build ci test chore style other; do
      case $sec in
        feat) title="✨ Features" ;;
        fix) title="🐛 Bug Fixes" ;;
        docs) title="📚 Dokumentation" ;;
        refactor) title="♻️ Refactoring" ;;
        perf) title="⚡ Performance" ;;
        build) title="🏗️ Build" ;;
        ci) title="🤖 CI" ;;
        test) title="🧪 Tests" ;;
        chore) title="🔧 Sonstiges (chore)" ;;
        style) title="💅 Style" ;;
        other) title="📦 Weitere Commits" ;;
      esac
      if [[ $sec == other ]]; then
        found=$(git log --reverse --format='%h%x09%s' "$from..$to" 2>/dev/null | grep -v -E $'\t(feat|fix|docs|refactor|perf|build|ci|test|chore|style)[(:!]')
      else
        found=$(git log --reverse --format='%h%x09%s' "$from..$to" 2>/dev/null | grep -E $'\t'"$sec"'[(:!]')
      fi
      [[ -z $found ]] && continue
      printf '## %s\n\n' "$title"
      while IFS=$'\t' read -r line; do
        [[ -z $line ]] && continue
        printf -- '- %s  (`%s`)\n' "${line#*$'\t'}" "${line%%$'\t'*}"
      done <<<"$found"
      printf '\n'
    done
  } >"$out"
  ui_textbox "Changelog-Vorschlag ($n Commits)" "$out"
  if ui_yesno "Changelog in die Zwischenablage kopieren?" "Changelog" "Kopieren" "Nein"; then
    copy_ui "Changelog" "$(cat "$out")"
  fi
}

# ---------------------------------------------------------- Datei-Historie --
pick_tracked_file() {
  local f
  if fzf_available; then
    f=$(git ls-files 2>/dev/null | FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" \
      --header='Datei wählen (Tippen filtert) — Vorschau: letzte Commits' \
      --preview='git --no-pager log --oneline -8 --color=always -- {} 2>/dev/null')
  else
    f=$(ui_inputbox "Datei" "Pfad relativ zum Repo:" "") || return 1
  fi
  [[ -z $f ]] && return 1
  printf '%s' "$f"
}

file_history() {
  local f sel out="$TMPDIR_PRP/hist.out"
  f=$(pick_tracked_file) || return 0
  [[ -z $f ]] && return 0
  while :; do
    sel=$(ui_menu "Datei-Historie" "$f" \
      "l" "📜 Commits (--follow, Datum & Autor)" \
      "o" "📜 Kurz: oneline (--follow)" \
      "s" "📊 Mit Statistik (Änderungen pro Commit)" \
      "a" "👤 Autoren dieser Datei" \
      "n" "📈 Churn (Zeilen +/− pro Commit)" \
      "d" "🔍 Letzte Änderung als Diff" \
      "t" "🔍 Änderungen als Statistik (kompakt)" \
      "y" "📋 Pfad kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" git --no-pager log --follow --date=short --format='%h %ad %an  %s' -- "$f"; ui_textbox "Historie: $f" "$out" ;;
      o) : >"$out"; cap "$out" git --no-pager log --follow --oneline -- "$f"; ui_textbox "Historie: $f" "$out" ;;
      s) : >"$out"; cap "$out" git --no-pager log --follow --stat -- "$f"; ui_textbox "Historie mit Statistik" "$out" ;;
      a) : >"$out"; cap "$out" git --no-pager shortlog -sn -- "$f"; ui_textbox "Autoren: $f" "$out" ;;
      n) : >"$out"; cap "$out" git --no-pager log --follow --format='%h %an' --numstat -- "$f"; ui_textbox "Churn: $f" "$out" ;;
      d) : >"$out"; cap "$out" git --no-pager log -1 -p -- "$f"; ui_textbox "Letzte Änderung: $f" "$out" ;;
      t) : >"$out"; cap "$out" git --no-pager log --follow --oneline --stat -- "$f" | head -n 400; ui_textbox "Statistik" "$out" ;;
      y) copy_ui "Pfad" "$f" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------------- Blame --
blame_browser() {
  local f sel out="$TMPDIR_PRP/blame.txt" line sha l start end
  f=$(pick_tracked_file) || return 0
  [[ -z $f ]] && return 0
  : >"$out"; git --no-pager blame --date=short "$f" >"$out" 2>&1 || true
  ui_textbox "Blame: $f" "$out"
  while :; do
    sel=$(ui_menu "Blame-Werkzeuge" "$f" \
      "z" "🔍 Zeile erklären (Commit, Autor, Nachricht)" \
      "o" "✍ Commit der Zeile ansehen (Patch dieser Datei)" \
      "L" "📜 Zeilen-Historie (git log -L start,end)" \
      "n" "✍ Datei in nnvim öffnen" \
      "y" "📋 Pfad kopieren" \
      "q" "↩ zurück") || return 0
    case $sel in
      z) l=$(ask_number "Welche Zeile erklären?" "Blame") || continue
         line=$(git blame -L "$l,$l" --date=short "$f" 2>/dev/null | head -1)
         if [[ -z $line ]]; then ui_msgbox "Blame" "Zeile $l nicht gefunden." "OK"; continue; fi
         sha=${line%% *}
         : >"$out"
         {
           printf 'Zeile %s in %s:\n\n%s\n\n── Commit %s ──\n' "$l" "$f" "$line" "$sha"
           git --no-pager show --stat --format='%h  %an <%ae>%n%ad%n%n%s%n%n%b' "$sha" 2>/dev/null
         } >"$out"
         ui_textbox "Blame: Zeile $l" "$out" ;;
      o) l=$(ask_number "Zeile des Commits ansehen?" "Blame") || continue
         line=$(git blame -L "$l,$l" "$f" 2>/dev/null | head -1)
         [[ -z $line ]] && { ui_msgbox "Blame" "Zeile $l nicht gefunden." "OK"; continue; }
         sha=${line%% *}
         : >"$out"; cap "$out" git --no-pager show "$sha" -- "$f"; ui_textbox "Commit $sha — $f" "$out" ;;
      L) start=$(ask_number "Start-Zeile?" "Zeilen-Historie") || continue
         end=$(ask_number "End-Zeile?" "Zeilen-Historie" "$start") || continue
         : >"$out"; cap "$out" git --no-pager log -L "$start,$end:$f" --format='%h %ad %an  %s' --date=short
         ui_textbox "Zeilen $start–$end: $f" "$out" ;;
      n) open_nn_folder "$f" ;;
      y) copy_ui "Pfad" "$f" ;;
      q|"") return 0 ;;
    esac
  done
}

# --------------------------------------------------------- Commits seit …  --
commits_since() {
  local out="$TMPDIR_PRP/since.out" since custom
  since=$(ui_menu "Commits seit …" "Zeitraum wählen" \
    "24h" "Letzte 24 Stunden" \
    "7d"  "Letzte 7 Tage" \
    "30d" "Letzte 30 Tage" \
    "90d" "Letzte 90 Tage" \
    "tag" "Seit dem letzten Tag (git describe)" \
    "in"  "Benutzerdefiniert (freie Eingabe für --since)" ) || return 0
  case $since in
    24h) since="24 hours ago" ;;
    7d) since="7 days ago" ;;
    30d) since="30 days ago" ;;
    90d) since="90 days ago" ;;
    tag) local t; t=$(git describe --tags --abbrev=0 2>/dev/null)
         [[ -z $t ]] && { ui_msgbox "Commits seit" "Kein Tag im Repo gefunden." "OK"; return 0; }
         since="$t" ;;
    in) custom=$(ui_inputbox "Commits seit" "z. B.  2026-01-01  oder  3 weeks ago:" "") || return 0
        [[ -z $custom ]] && return 0
        since="$custom" ;;
  esac
  : >"$out"
  {
    printf '══ Commits seit: %s ══\n\n' "$since"
    git --no-pager log --since="$since" --date=short --format='%h %ad %an  %s' 2>/dev/null | head -n 400
    echo
    printf 'Anzahl: %s\n' "$(git rev-list --count --since="$since" HEAD 2>/dev/null)"
    printf '\n── Geänderte Dateien in diesem Zeitraum ──\n'
    git log --since="$since" --format='' --name-only 2>/dev/null | grep -v '^$' | sort | uniq -c | sort -rn | head -20
  } >"$out"
  ui_textbox "Commits seit $since" "$out"
}

# --------------------------------------------------------- Git-Werkzeuge ----
git_tools_menu() {
  local sel
  while :; do
    sel=$(ui_menu "git-Werkzeuge" "Alles rund ums lokale Repo   ${SEP}   $CURRENT_BRANCH @ $(git log -1 --format='%h' 2>/dev/null)" \
      "b" "🌿 Branches: wechseln, anlegen, mergen, löschen (lokal/remote)" \
      "t" "🏷️ Tags: ansehen, pushen, löschen, Release anlegen" \
      "k" "🚧 Konflikt-Assistent (Merge/Rebase/Cherry-pick)" \
      "c" "🍒 Cherry-pick: mehrere Commits auf einmal" \
      "s" "📦 Stash: sichern, anwenden, Branch daraus" \
      "r" "🕰️ Reflog: verlorene Commits finden & retten" \
      "e" "🛠️ Commit-Reparatur (undo, amend, squash, clean)" \
      "w" "🌳 Worktrees (parallele Checkouts desselben Repos)" \
      "a" "📊 Repo-Analyse (Commits, Autoren, Churn)" \
      "f" "📝 Changelog-Generator (Markdown, gruppiert)" \
      "h" "📜 Datei-Historie (--follow, Autoren, Churn)" \
