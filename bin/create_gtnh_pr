usage() {
  cat <<EOF
create_gtnh_pr $VERSION — interaktiver PR-Assistent (TUI), gh-first

Aufruf:   create_gtnh_pr
          (in dem Ordner ausführen, in dem deine Git-Repos liegen)

Schritte 1–12 folgen der Checkliste:
  $CHECKLIST

PR-Erstellung (Schritt 9):
  PR-Template aus .github/PULL_REQUEST_TEMPLATE* oder <owner>/.github wählen,
  Assignees/Reviewer/Labels direkt beim Erstellen setzen. Nachträglich in
  Schritt 10 (Labels / Assignees / Reviewer ändern) weiter anpassbar.

Extras (GitHub-Allrounder):
  Issues (Labels/Meilensteine/Filter), PRs (auschecken/bearbeiten/mergen),
  Actions live beobachten, Logs, Artefakte, Workflows manuell starten (Inputs),
  Releases (erstellen/bearbeiten/Assets), Gists, Benachrichtigungen,
  Commit-/History-Browser (cherry-pick, revert), Ref-Vergleich (Diff A↔B),
  Textsuche (git grep, Pickaxe, Dateisuche), Secrets & Variablen,
  gh-Setup (SSH/GPG-Keys, Aliases, Extensions, Config), Labels verwalten,
  Remote-Tree + lokaler Tree, Markdown-Viewer, gh search, gh-Konto.

git-Werkzeuge (Extras → j; Schnellzugriff: b = Branches, T = Tags):
  Branches & Tags (anlegen, mergen, löschen lokal/remote), Konflikt-Assistent,
  Cherry-pick-Serien, Stash, Reflog-Rettung, Commit-Reparatur (undo/amend/squash),
  Worktrees, Repo-Analyse, Changelog-Generator, Datei-Historie, Blame-Browser,
  Commits seit Zeitraum, git config/Aliase, .gitignore, Submodule & Git-LFS,
  Wartung (fetch/prune/gc), Live-Status.

GitHub vertieft (Extras → U):
  PR-Analyse (Commits/Threads/Patch/Checks), Dashboards (gh search),
  Meilensteine verwalten, Issue-Timeline/-Vorlagen, Security & Dependabot,
  Insights (PR-Statistik/Aktivität/Traffic), Öffnen & Links, API-Explorer,
  Cross-Repo-Browser, gh-Auth-Tools.

TUI: dialog  ·  Dateiauswahl mit exakter Diff-Vorschau: fzf
Theme: GTNH_PR_THEME=catppuccin|light|classic  (Standard: auto; catppuccin = Mocha+ Lavender)
Editor: nnvim (NVIM_APPNAME=nnvim) für den Repo-Ordner, sonst \$EDITOR

Optionen:
  -h, --help     diese Hilfe
  -V, --version  Version
EOF
}

main() {
  case ${1:-} in
    -h|--help) usage; exit 0 ;;
    -V|--version) printf 'create_gtnh_pr %s\n' "$VERSION"; exit 0 ;;
  esac
  preflight
  if [[ -n "${ui_note_fzf_missing:-}" ]]; then
    ui_msgbox "Hinweis" "fzf ist nicht installiert — die Dateiauswahl läuft dann im Dialog-Modus (ohne Diff-Vorschau).\n\nTipp: sudo pacman -S fzf  (oder apt/dnf-Pendant)" "OK"
  fi
  pick_repo || exit 0
  show_repo_intro
  local choice=''
  while :; do
    refresh_state
    choice=$(main_menu) || break
    case $choice in
      q) break ;;
      r) DONE=(); pick_repo || continue; show_repo_intro ;;
      e) extras_menu ;;
      '' ) continue ;;
      1[0-2]|[1-9]) run_steps "$choice" ;;
    esac
  done
  ui_msgbox "GTNH PR-Assistent" "Bis zum nächsten PR! 👋\n\nDie Checkliste: $CHECKLIST\n\n(Dieses Skript fasst nichts von allein an — du bleibst der Chef.)" "Tschüss"
}

# Nur beim direkten Ausführen starten (Sourcing z. B. für Tests ist möglich)
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi

