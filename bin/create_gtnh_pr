#!/usr/bin/env bash
# ============================================================================
#  create_gtnh_pr  —  Interaktiver TUI-Assistent für GitHub-Pull-Requests
# ----------------------------------------------------------------------------
#  • Sucht Git-Repositories im aktuellen Ordner
#  • Führt dich Punkt für Punkt durch die PR-Checkliste:
#      /mnt/matthias/gtnh_dev/PR-Checkliste.md
#  • GH-FIRST: PRs, Issues, Actions, Labels, Suche, Merge, update-branch …
#    git wird nur für das Nötigste benutzt (status, add, commit, push, pull).
#  • DU schreibst alles selbst (Branch-Name, Commit-Message, PR-Titel/-Body).
#    Jeder Befehl wird vorher angezeigt und erst nach Bestätigung ausgeführt.
#  • Bearbeiten läuft über nnvim (NVIM_APPNAME=nnvim, /mnt/matthias/nnvim):
#    Schritt 3 öffnet einfach den aktuellen Repo-Ordner.
#  • Dateiauswahl mit exakter Diff-Vorschau (fzf), viele Menü-Optionen.
#
#  Abhängigkeiten: dialog, git, gh (GitHub CLI), fzf, nvim (nnvim)
#  Aufruf:         create_gtnh_pr        (Hilfe: create_gtnh_pr -h)
#  Hinweis:        NICHT als root ausführen (git/gh gehören dir, nicht root).
# ============================================================================

VERSION="3.0.0"
CHECKLIST="${PR_CHECKLIST:-/mnt/matthias/gtnh_dev/PR-Checkliste.md}"
START_DIR="$(pwd)"
TMPDIR_PRP="$(mktemp -d "${TMPDIR:-/tmp}/create_gtnh_pr.XXXXXX")" || exit 1
export GH_PAGER=cat GIT_PAGER=cat GIT_TERMINAL_PROMPT=1

REPO_NAME=""
CURRENT_BRANCH=""
DEFAULT_BRANCH=""
LAST_BRANCH_NAME=""
declare -A DONE=()

# --- Dialog-Farben (\Z-Codes, werden von dialog --colors interpretiert) -----
C_R='\Z1'; C_G='\Z2'; C_Y='\Z3'; C_M='\Z5'; C_C='\Z6'; C_N='\Zn'

# --- Eigenes dialog-Theme: lesbare Kontraste, unabhängig vom System ---------
# GTNH_PR_THEME=catppuccin (Standard), light oder classic; "auto" erkennt
# helle Terminals per COLORFGBG, fällt sonst auf catppuccin zurück.
# catppuccin = Catppuccin Mocha + Lavender-Akzent (passt zu Catppuccin-
# Terminalpaletten); classic = Blau/Weiß wie früher.
setup_dialog_theme() {
  local theme="${GTNH_PR_THEME:-auto}" rc="$TMPDIR_PRP/dialogrc" bg
  if [[ $theme == auto ]]; then
    theme=catppuccin
    if [[ -n "${COLORFGBG:-}" ]]; then
      bg="${COLORFGBG##*;}"
      if [[ $bg =~ ^[0-9]+$ ]] && (( bg >= 7 )); then theme=light; fi
    fi
  fi
  if [[ $theme == light ]]; then
    cat >"$rc" <<'EORC'
