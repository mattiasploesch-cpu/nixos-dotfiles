}

# --- PART7-D-ENDE ---

# ------------------------------------------------------------- PR-Analyse --
pr_analysis() {
  local pr sel out="$TMPDIR_PRP/pr-analysis.out" url patch log
  pr=$(pr_pick) || return 0
  [[ -z $pr ]] && return 0
  while :; do
    sel=$(ui_menu "PR #$pr — Analyse" "gh pr view / diff / threads   ${SEP}   $REPO_SLUG" \
      "s" "📄 Übersicht + Kommentare (--comments)" \
      "c" "📜 Commits des PR" \
      "f" "🗂 Geänderte Dateien + Statistik" \
      "d" "🔍 Voller Diff (erste 1200 Zeilen)" \
      "p" "⬇ Patch als Datei speichern (TMP) + in nnvim öffnen" \
      "t" "💬 Review-Threads & Kommentare (API)" \
      "r" "📄 Reviews (Zustände & Texte)" \
      "k" "✅ Checks & Status" \
      "l" "🏷️ Labels / Meilenstein / Assignees / Reviewer" \
      "o" "🌐 Im Browser öffnen" \
      "y" "📋 PR-URL kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; cap "$out" gh pr view "$pr" --comments; ui_textbox "PR #$pr" "$out" ;;
      c) : >"$out"; cap "$out" gh pr view "$pr" --json commits --jq '.commits[] | "\(.oid[0:8])  \(.messageHeadline)"'; ui_textbox "Commits" "$out" ;;
      f) : >"$out"; cap "$out" gh pr view "$pr" --json files --jq '.files[] | "+\(.additions) -\(.deletions)  \(.path)"'; ui_textbox "Dateien" "$out" ;;
      d) : >"$out"; cap "$out" bash -c 'gh pr diff "$1" | head -n 1200' _ "$pr"; ui_textbox "Diff PR #$pr" "$out" ;;
      p) patch="$TMPDIR_PRP/pr-$pr.patch"; log="$TMPDIR_PRP/patch.log"; : >"$log"
         if gh pr diff "$pr" >"$patch" 2>>"$log" && [[ -s $patch ]]; then
           printf 'gespeichert: %s  (%s Zeilen)\n' "$patch" "$(wc -l <"$patch")" >>"$log"
           ui_textbox "Patch gespeichert (TMP)" "$log"
           ui_yesno "Patch jetzt in nnvim öffnen?" "Patch" "Öffnen" "Nein" && open_nn_folder "$patch"
         else ui_textbox "Patch-Fehler" "$log"; fi ;;
      t) : >"$out"
         { echo "── Review-Kommentare (Threads) ──"
           gh api "repos/$REPO_SLUG/pulls/$pr/comments" --paginate \
             --jq '.[] | "[\(.user.login)] \(.path):\(.line // .original_line // "?")  \(.body)"' 2>&1
           echo; echo "── Reviews ──"
           gh api "repos/$REPO_SLUG/pulls/$pr/reviews" --paginate \
             --jq '.[] | "[\(.state)] \(.user.login): \(.body // "")"' 2>&1; } >"$out"
         ui_textbox "PR #$pr — Threads" "$out" ;;
      r) : >"$out"; cap "$out" gh pr view "$pr" --json reviews --jq '.reviews[] | "[\(.state)] \(.author.login)  \(.submittedAt)  \(.body[0:80])"'; ui_textbox "Reviews" "$out" ;;
      k) : >"$out"; cap "$out" gh pr checks "$pr"; ui_textbox "Checks" "$out" ;;
      l) : >"$out"; cap "$out" gh pr view "$pr" --json labels,milestone,assignees,reviewRequests \
           --jq '"Labels: \(.labels | map(.name) | join(", "))\nMeilenstein: \(.milestone.title // "—")\nAssignees: \(.assignees | map(.login) | join(", "))\nReviewer: \(.reviewRequests | map(.login // .name // "?") | join(", "))"'
         ui_textbox "Meta" "$out" ;;
      o) url=$(gh pr view "$pr" --json url --jq .url 2>/dev/null); open_url "$url" ;;
      y) url=$(gh pr view "$pr" --json url --jq .url 2>/dev/null); copy_ui "PR-URL" "$url" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------- Dashboards --
search_view() {  # $1=URL $2=pr|issue
  local url=$1 kind=$2 sel out="$TMPDIR_PRP/search.out"
  sel=$(ui_menu "Ergebnis" "$url" \
    "v" "📄 Details ansehen" \
    "o" "🌐 Im Browser öffnen" \
    "y" "📋 URL kopieren" \
    "z" "↩ zurück") || return 0
  case $sel in
    v) : >"$out"; cap "$out" gh "$kind" view "$url"; ui_textbox "Details" "$out" ;;
    o) open_url "$url" ;;
    y) copy_ui "URL" "$url" ;;
  esac
}

dash_pick() {  # $1=Header $2=pr|issue $3…= gh-Befehl, der "URL<TAB>Titel" liefert
  local hdr=$1 kind=$2; shift 2
  local line
  line=$(FZF_DEFAULT_OPTS="" "$@" 2>/dev/null \
      | fzf_num "$hdr — ENTER = Detail öffnen" "gh $kind view {1}")
  [[ -z $line ]] && return 0
  search_view "${line%%$'\t'*}" "$kind"
}

dashboards_menu() {
  local sel login
  login=$(gh api user --jq .login 2>/dev/null)
  while :; do
    sel=$(ui_menu "Dashboards (gh search)" "Angemeldet: ${login:-?}   ${SEP}   suchen über alle Repos" \
      "p" "🔀 Meine offenen PRs" \
      "i" "📋 Meine offenen Issues" \
      "r" "👀 Meine Review-Anfragen" \
      "o" "🔍 Offene PRs im aktuellen Repo" \
      "f" "🔍 Offene Issues im aktuellen Repo" \
      "d" "📄 Meine Draft-PRs" \
      "m" "✅ Meine gemergten PRs (letzte 30 Tage)" \
      "g" "🐣 „good first issue“ in GTNH-Repos" \
      "b" "🐛 Offene Bugs in $REPO_SLUG" \
      "s" "🔎 Freie Suche (PRs / Issues / Repos / Code)" \
      "z" "↩ zurück") || return 0
    case $sel in
      p) dash_pick "Meine offenen PRs" pr gh search prs --author @me --state open --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      i) dash_pick "Meine offenen Issues" issue gh search issues --author @me --state open --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      r) dash_pick "Review-Anfragen an mich" pr gh search prs --review-requested @me --state open --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      o) dash_pick "Offene PRs: $REPO_SLUG" pr gh pr list --state open --limit 50 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      f) dash_pick "Offene Issues: $REPO_SLUG" issue gh issue list --state open --limit 50 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      d) dash_pick "Meine Draft-PRs" pr gh search prs --author @me --state open --draft --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      m) dash_pick "Meine gemergten PRs (30 Tage)" pr gh search prs --author @me --state merged --merged-at ">=$(date -d '30 days ago' +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)" --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      g) dash_pick "good first issue (GTNH)" issue gh search issues --label "good first issue" --owner GTNewHorizons --state open --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      b) dash_pick "Offene Bugs: $REPO_SLUG" issue gh issue list --label bug --state open --limit 50 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      s) local q kind2
         kind2=$(ui_menu "Freie Suche" "Was suchen?" \
           "pr" "Pull Requests" "issue" "Issues" "repo" "Repositories" "code" "Code" "z" "↩ zurück") || continue
         [[ $kind2 == z ]] && continue
         q=$(ui_inputbox "Suche" "Suchbegriff:" "") || continue
         [[ -z $q ]] && continue
         case $kind2 in
           pr) dash_pick "PR-Suche: $q" pr gh search prs "$q" --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
           issue) dash_pick "Issue-Suche: $q" issue gh search issues "$q" --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
           repo) : >"$TMPDIR_PRP/search.out"
                 { echo "── Repositories ──"; gh search repos "$q" --limit 30 2>&1; } >"$TMPDIR_PRP/search.out"
                 ui_textbox "Repo-Suche: $q" "$TMPDIR_PRP/search.out" ;;
           code) : >"$TMPDIR_PRP/search.out"
                 { echo "── Code-Treffer (aktuelles Repo) ──"; gh search code "$q" --limit 30 2>&1; } >"$TMPDIR_PRP/search.out"
                 ui_textbox "Code-Suche: $q" "$TMPDIR_PRP/search.out" ;;
         esac ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------ Meilensteine --
mile_pick() {  # → "Nummer<TAB>Titel<TAB>[state]"
  local line
  line=$(gh api "repos/$REPO_SLUG/milestones?state=all&per_page=100" \
      --jq '.[] | "\(.number)\t\(.title)\t[\(.state)]"' 2>/dev/null \
      | fzf_num 'Meilenstein wählen (ENTER)' '')
  [[ -z $line ]] && return 1
  printf '%s' "$line"
}

milestones_deep_menu() {
  local sel line num title rest out="$TMPDIR_PRP/ms.out" val due
  local args=()
  while :; do
    sel=$(ui_menu "Meilensteine" "Repo: $REPO_SLUG" \
      "l" "📄 Alle Meilensteine (offen + geschlossen, Fortschritt)" \
      "n" "＋ Neuen Meilenstein anlegen" \
      "e" "✏ Meilenstein bearbeiten (Titel/Beschreibung/Fälligkeit)" \
      "c" "✔ Meilenstein schließen" \
      "o" "↺ Meilenstein wieder öffnen" \
      "i" "🔍 Issues des Meilensteins anzeigen" \
      "d" "🗑 Meilenstein löschen" \
      "z" "↩ zurück") || return 0
    case $sel in
      l) : >"$out"; cap "$out" gh api "repos/$REPO_SLUG/milestones?state=all&per_page=100" \
           --jq 'sort_by(.state, .due_on // "9999") | .[] | "#\(.number)  [\(.state)]  \(.title)\n     \(.open_issues) offen / \(.closed_issues) geschlossen   fällig: \(.due_on // "—" | split("T")[0])"'
         ui_textbox "Meilensteine" "$out" ;;
      n) title=$(ui_inputbox "Neuer Meilenstein" "Titel:" "") || continue
         [[ -z $title ]] && continue
         val=$(ui_inputbox "Neuer Meilenstein" "Beschreibung (optional):" "") || continue
         due=$(ui_inputbox "Neuer Meilenstein" "Fällig am JJJJ-MM-TT (optional):" "") || continue
         : >"$out"
         if [[ -n $due ]]; then cap "$out" gh api --method POST "repos/$REPO_SLUG/milestones" -f title="$title" -f description="$val" -f due_on="${due}T00:00:00Z"
         else cap "$out" gh api --method POST "repos/$REPO_SLUG/milestones" -f title="$title" -f description="$val"; fi
         ui_textbox "Meilenstein angelegt" "$out" ;;
      e) line=$(mile_pick) || continue; num=${line%%$'\t'*}; rest=${line#*$'\t'}; title=${rest%%$'\t'*}
         title=$(ui_inputbox "Meilenstein #$num" "Neuer Titel:" "$title") || continue
         val=$(ui_inputbox "Meilenstein #$num" "Neue Beschreibung (leer = unverändert):" "") || continue
         due=$(ui_inputbox "Meilenstein #$num" "Neue Fälligkeit JJJJ-MM-TT (leer = unverändert):" "") || continue
         args=(gh api --method PATCH "repos/$REPO_SLUG/milestones/$num")
         [[ -n $title ]] && args+=(-f title="$title")
         [[ -n $val ]] && args+=(-f description="$val")
         [[ -n $due ]] && args+=(-f due_on="${due}T00:00:00Z")
         : >"$out"; cap "$out" "${args[@]}"; ui_textbox "Meilenstein bearbeitet" "$out" ;;
      c) line=$(mile_pick) || continue; num=${line%%$'\t'*}
         : >"$out"; cap "$out" gh api --method PATCH "repos/$REPO_SLUG/milestones/$num" -f state=closed; ui_textbox "Geschlossen" "$out" ;;
      o) line=$(mile_pick) || continue; num=${line%%$'\t'*}
         : >"$out"; cap "$out" gh api --method PATCH "repos/$REPO_SLUG/milestones/$num" -f state=open; ui_textbox "Wieder geöffnet" "$out" ;;
      i) line=$(mile_pick) || continue; rest=${line#*$'\t'}; title=${rest%%$'\t'*}
         : >"$out"; cap "$out" gh issue list --milestone "$title" --state all --limit 50; ui_textbox "Issues: $title" "$out" ;;
      d) line=$(mile_pick) || continue; num=${line%%$'\t'*}; rest=${line#*$'\t'}; title=${rest%%$'\t'*}
         ui_yesno "Meilenstein '${C_C}$title${C_N}' WIRKLICH löschen?\n\n(nur der Meilenstein; Issues bleiben erhalten)" "Löschen" "Ja" "Abbrechen" || continue
         : >"$out"; cap "$out" gh api --method DELETE "repos/$REPO_SLUG/milestones/$num"; ui_textbox "Gelöscht" "$out" ;;
      z|"") return 0 ;;
    esac
  done
}

# ---------------------------------------------------------- Issues vertieft --
issue_pick() {
  local line
  line=$(gh issue list --limit 60 --state all --json number,title,state \
      --jq '.[] | "\(.number)\t[\(.state | ascii_downcase)] \(.title)"' 2>/dev/null \
      | fzf_num 'Issue wählen (ENTER)' 'GH_PAGER=cat gh issue view {1}')
  [[ -z $line ]] && return 1
  printf '%s' "${line%%$'\t'*}"
}

issue_deep_menu() {
  local sel n out="$TMPDIR_PRP/issue-deep.out" f q kind
  while :; do
    sel=$(ui_menu "Issues vertieft" "$REPO_SLUG" \
      "t" "🕰️ Timeline & Kommentare eines Issues" \
      "c" "💬 Kommentar schreiben (Editor → gh issue comment)" \
      "v" "📋 Issue-Vorlagen (.github/ISSUE_TEMPLATE)" \
      "n" "＋ Neues Issue (mit Vorlage)" \
      "a" "👤 Issues nach Autor (Top-Liste)" \
      "s" "📊 Issue-Statistik (offen/geschlossen/ohne Label)" \
      "f" "🔍 Repo-weite Suche (gh search issues)" \
      "z" "↩ zurück") || return 0
    case $sel in
      t) n=$(issue_pick) || continue
         : >"$out"
         { echo "══ Issue #$n ══"; gh issue view "$n" --comments 2>&1
           echo; echo "══ Timeline (Events) ══"
           gh api "repos/$REPO_SLUG/issues/$n/timeline" --paginate \
             --jq '.[] | "\(.created_at // "-")  [\(.event // "comment")]  \(.actor.login // .user.login // "-")\(if .label then "  label: " + .label.name else "" end)\(if .commit_id then "  " + .commit_id[0:8] else "" end)"' 2>&1 | head -n 120; } >"$out"
         ui_textbox "Issue #$n — Timeline" "$out" ;;
      c) n=$(issue_pick) || continue
         f="$TMPDIR_PRP/comment-$n.md"; : >"$f"
         printf '# Kommentar zu Issue #%s — Text unter dieser Zeile schreiben, speichern, schließen\n\n' "$n" >"$f"
         open_editor "$f"
         if ui_yesno "Kommentar jetzt absenden?\n\n${C_C}gh issue comment $n --body-file …${C_N}" "Kommentar" "Senden" "Abbrechen"; then
           : >"$out"; cap "$out" gh issue comment "$n" --body-file "$f"; ui_textbox "Kommentar" "$out"
         fi ;;
      v) : >"$out"
         if [[ -d .github/ISSUE_TEMPLATE ]]; then
           cap "$out" ls -la .github/ISSUE_TEMPLATE
           for f in .github/ISSUE_TEMPLATE/*; do
             [[ -f $f ]] || continue
             printf '\n── %s ──\n' "$f" >>"$out"
             head -n 40 "$f" >>"$out" 2>&1
           done
         else echo "(kein .github/ISSUE_TEMPLATE-Ordner im Repo)" >"$out"; fi
         ui_textbox "Issue-Vorlagen" "$out" ;;
      n) : >"$out"; cap "$out" bash -c 'ls .github/ISSUE_TEMPLATE 2>/dev/null || echo "(keine Vorlagen gefunden)"'
         ui_textbox "Verfügbare Vorlagen" "$out"
         f=$(ui_inputbox "Neues Issue" "Vorlagen-Datei (z. B. bug_report.md; leer = ohne Vorlage):" "") || continue
         if [[ -n $f ]]; then run_live "Issue aus Vorlage erstellen" gh issue create --template "$f"
         else run_live "Issue erstellen" gh issue create; fi ;;
      a) : >"$out"; gh issue list --state all --limit 200 --json author --jq '.[].author.login' >"$out.raw" 2>/dev/null || true
         { echo "── Top-Autoren (letzte 200 Issues) ──"; sort "$out.raw" | uniq -c | sort -rn | head -15; } >"$out"
         ui_textbox "Issues nach Autor" "$out" ;;
      s) : >"$out"
         printf 'Offen:            %s\n' "$(gh api "search/issues?q=repo:$REPO_SLUG+is:issue+is:open" --jq .total_count 2>/dev/null)"
         printf 'Geschlossen:      %s\n' "$(gh api "search/issues?q=repo:$REPO_SLUG+is:issue+is:closed" --jq .total_count 2>/dev/null)"
         printf 'Offen ohne Label: %s\n' "$(gh api "search/issues?q=repo:$REPO_SLUG+is:issue+is:open+no:label" --jq .total_count 2>/dev/null)"
         printf 'Offen ohne Meilenstein: %s\n' "$(gh api "search/issues?q=repo:$REPO_SLUG+is:issue+is:open+no:milestone" --jq .total_count 2>/dev/null)"
         ui_textbox "Issue-Statistik" "$out" ;;
      f) q=$(ui_inputbox "gh search issues" "Suchbegriff:" "") || continue
         [[ -z $q ]] && continue
         kind=issue
         dash_pick "Suche: $q" "$kind" gh search issues "$q" --repo "$REPO_SLUG" --limit 30 --json url,title --jq '.[] | "\(.url)\t\(.title)"' ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------ Security & Updates --
security_menu() {
  local sel out="$TMPDIR_PRP/sec.out" slug="$REPO_SLUG"
  while :; do
    sel=$(ui_menu "Security & Dependabot" "$slug" \
      "a" "🔔 Dependabot-Alerts (offen)" \
      "c" "🔒 Code-Scanning-Alerts (offen)" \
      "s" "🛡️ Secret-Scanning-Alerts (offen)" \
      "u" "🤖 Dependabot-PRs (Update-Vorschläge)" \
      "p" "🌿 Branch-Protection des Basis-Branches" \
      "r" "⚙️ Repo-Features & Sichtbarkeit" \
      "z" "↩ zurück") || return 0
    case $sel in
      a) : >"$out"; cap "$out" gh api "repos/$slug/dependabot/alerts?state=open&per_page=50" \
           --jq '.[] | "#\(.number) [\(.security_advisory.severity)] \(.dependency.package.name) — \(.security_advisory.summary)"'
         ui_textbox "Dependabot-Alerts" "$out" ;;
      c) : >"$out"; cap "$out" gh api "repos/$slug/code-scanning/alerts?state=open&per_page=50" \
           --jq '.[] | "#\(.number) [\(.rule.severity)] \(.rule.description) — \(.most_recent_instance.location.path):\(.most_recent_instance.location.start_line)"'
         ui_textbox "Code-Scanning" "$out" ;;
      s) : >"$out"; cap "$out" gh api "repos/$slug/secret-scanning/alerts?state=open&per_page=50" \
           --jq '.[] | "#\(.number) \(.secret_type) — angelegt: \(.created_at)"'
         ui_textbox "Secret-Scanning" "$out" ;;
      u) : >"$out"; cap "$out" gh pr list --author "app/dependabot" --state open --limit 40; ui_textbox "Dependabot-PRs" "$out" ;;
      p) : >"$out"; cap "$out" gh api "repos/$slug/branches/$DEFAULT_BRANCH/protection"; ui_textbox "Branch-Protection: $DEFAULT_BRANCH" "$out" ;;
      r) : >"$out"; cap "$out" gh repo view --json nameWithOwner,visibility,isPrivate,hasIssuesEnabled,hasWikiEnabled,hasDiscussionsEnabled,hasProjectsEnabled,defaultBranchRef
         ui_textbox "Repo-Features" "$out" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------------ Insights --
insights_menu() {
  local sel out="$TMPDIR_PRP/ins.out" slug="$REPO_SLUG"
  while :; do
    sel=$(ui_menu "Insights" "$slug" \
      "p" "📊 PR-Statistik (offen / gemergt / geschlossen)" \
      "m" "⏱️ Merge-Zeiten & Alter offener PRs" \
      "a" "📅 Commit-Aktivität (letzte 12 Wochen)" \
      "c" "👥 Top-Contributors" \
      "t" "📈 Traffic (Views/Referrers — braucht Rechte)" \
      "i" "🔢 Issues & PRs gesamt" \
      "z" "↩ zurück") || return 0
    case $sel in
      p) : >"$out"
         printf 'PRs offen:        %s\n' "$(gh api "search/issues?q=repo:$slug+is:pr+is:open" --jq .total_count 2>/dev/null)"
         printf 'PRs gemergt:      %s\n' "$(gh api "search/issues?q=repo:$slug+is:pr+is:merged" --jq .total_count 2>/dev/null)"
         printf 'PRs ungemergt zu: %s\n' "$(gh api "search/issues?q=repo:$slug+is:pr+is:closed+is:unmerged" --jq .total_count 2>/dev/null)"
         ui_textbox "PR-Statistik" "$out" ;;
      m) : >"$out"
         cap "$out" gh pr list --state merged --limit 15 --json number,title,createdAt,mergedAt \
            --jq '.[] | "#\(.number)  \((((.mergedAt | fromdate) - (.createdAt | fromdate)) / 3600 | floor)) h   \(.title[0:60])"'
         printf '\n── Offene PRs (Alter) ──\n' >>"$out"
         cap "$out" gh pr list --state open --limit 15 --json number,title,createdAt \
            --jq '.[] | "#\(.number)  \(((now - (.createdAt | fromdate)) / 86400 | floor)) Tage   \(.title[0:60])"'
         ui_textbox "Merge-Zeiten" "$out" ;;
      a) : >"$out"; cap "$out" gh api "repos/$slug/stats/commit_activity" --jq '.[-12:][] | "\(.week | todate[0:10])   \(.total) Commits"'
         ui_textbox "Commit-Aktivität" "$out" ;;
      c) : >"$out"; cap "$out" gh api "repos/$slug/contributors?per_page=25" --jq '.[] | "\(.contributions)  \(.login)"'
         ui_textbox "Contributors" "$out" ;;
      t) : >"$out"
         cap "$out" gh api "repos/$slug/traffic/views" --jq '"Views: \(.count) gesamt · \(.uniques) unique (14 Tage)"'
         printf '\n── Referrers ──\n' >>"$out"
         cap "$out" gh api "repos/$slug/traffic/referrers" --jq '.[] | "\(.count)  \(.referrer)"'
         ui_textbox "Traffic" "$out" ;;
      i) : >"$out"
         printf 'Issues gesamt: %s\n' "$(gh api "search/issues?q=repo:$slug+is:issue" --jq .total_count 2>/dev/null)"
         printf 'PRs gesamt:    %s\n' "$(gh api "search/issues?q=repo:$slug+is:pr" --jq .total_count 2>/dev/null)"
         ui_textbox "Gesamt" "$out" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------ Öffnen & Links --
links_menu() {
  local sel url
  while :; do
    url=$(repo_web_url) || { ui_msgbox "Links" "Kein GitHub-Remote gefunden." "OK"; return 0; }
    sel=$(ui_menu "Öffnen & Links" "$REPO_SLUG @ $CURRENT_BRANCH" \
      "r" "🌐 Repo-Startseite" \
      "b" "🌐 Aktuellen Branch öffnen" \
      "p" "🔀 PR-Liste" \
      "i" "📋 Issue-Liste" \
      "a" "⚙️ Actions" \
      "e" "📦 Releases" \
      "c" "🔀 Compare: $DEFAULT_BRANCH ↔ $CURRENT_BRANCH" \
      "n" "＋ „Neuer PR“-Seite öffnen" \
      "l" "📋 Repo-URL kopieren" \
      "s" "📋 owner/repo kopieren" \
      "o" "📋 origin-Remote kopieren" \
      "z" "↩ zurück") || return 0
    case $sel in
      r) open_url "$url" ;;
      b) open_url "$url/tree/$CURRENT_BRANCH" ;;
      p) open_url "$url/pulls" ;;
      i) open_url "$url/issues" ;;
      a) open_url "$url/actions" ;;
      e) open_url "$url/releases" ;;
      c) open_url "$url/compare/$DEFAULT_BRANCH...$CURRENT_BRANCH" ;;
      n) open_url "$url/compare/$DEFAULT_BRANCH...$CURRENT_BRANCH?expand=1" ;;
      l) copy_ui "Repo-URL" "$url" ;;
      s) copy_ui "Repo-Slug" "$REPO_SLUG" ;;
      o) copy_ui "Origin-Remote" "$(git remote get-url origin)" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------ API-Explorer --
api_explorer() {
  local sel path filter out="$TMPDIR_PRP/api.out"
  while :; do
    sel=$(ui_menu "GitHub-API-Explorer" "Direktzugriff über gh api   ${SEP}   $REPO_SLUG" \
      "g" "GET: Pfad eingeben" \
      "j" "GET mit jq-Filter" \
      "p" "Beispiel: Offene PRs als JSON" \
      "r" "Beispiel: Repo als JSON" \
      "u" "Beispiel: Eigenes Konto (user)" \
      "l" "Rate-Limit anzeigen" \
      "d" "Spickzettel: wichtige Endpunkte" \
      "z" "↩ zurück") || return 0
    case $sel in
      g) path=$(ui_inputbox "gh api" "Pfad (ohne https://api.github.com/):" "repos/$REPO_SLUG") || continue
         [[ -z $path ]] && continue
         : >"$out"; cap "$out" gh api "$path"; ui_textbox "API: $path" "$out" ;;
      j) path=$(ui_inputbox "gh api" "Pfad:" "repos/$REPO_SLUG") || continue
         [[ -z $path ]] && continue
         filter=$(ui_inputbox "jq-Filter" "z. B.  .name   oder   .[] | .name" "") || continue
         : >"$out"; cap "$out" gh api "$path" --jq "$filter"; ui_textbox "API: $path (jq)" "$out" ;;
      p) : >"$out"; cap "$out" gh api "repos/$REPO_SLUG/pulls?state=open&per_page=5"; ui_textbox "Offene PRs (JSON)" "$out" ;;
      r) : >"$out"; cap "$out" gh api "repos/$REPO_SLUG"; ui_textbox "Repo (JSON)" "$out" ;;
      u) : >"$out"; cap "$out" gh api user; ui_textbox "Konto (JSON)" "$out" ;;
      l) : >"$out"; cap "$out" gh api rate_limit; ui_textbox "Rate-Limit" "$out" ;;
      d) ui_msgbox "API-Spickzettel" \
"${C_C}repos/OWNER/REPO${C_N}                        Repo-Infos
${C_C}repos/OWNER/REPO/issues?state=open${C_N}       Issues
${C_C}repos/OWNER/REPO/pulls?state=open${C_N}        PRs
${C_C}repos/OWNER/REPO/commits?per_page=10${C_N}     Commits
${C_C}repos/OWNER/REPO/branches${C_N}                Branches
${C_C}repos/OWNER/REPO/releases${C_N}                Releases
${C_C}search/issues?q=repo:OWNER/REPO+is:open${C_N}  Suche
${C_C}user${C_N}  ·  ${C_C}rate_limit${C_N}" "OK" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------- Cross-Repo-Browser --
cross_repo_browser() {
  local slug sel out="$TMPDIR_PRP/cross.out" path="" name typ entries=() line
  slug=$(ui_inputbox "Cross-Repo-Browser" "Repo (owner/name):" "GTNewHorizons/GT-New-Horizons-Modpack") || return 0
  [[ -z $slug ]] && return 0
  while :; do
    sel=$(ui_menu "Cross-Repo: $slug" "Pfad: /${path}   (ohne Klonen durchstöbern)" \
      "d" "📁 Verzeichnis anzeigen/durchklicken" \
      "f" "📄 Datei direkt öffnen (Pfad eingeben)" \
      "u" "⬆ Ins übergeordnete Verzeichnis" \
      "i" "📋 Issues (gh issue list --repo)" \
      "p" "🔀 PRs (gh pr list --repo)" \
      "r" "📦 Releases" \
      "m" "📖 README anzeigen" \
      "k" "⬇ Repo klonen (gh repo clone)" \
      "z" "↩ zurück") || return 0
    case $sel in
      d) entries=()
         while IFS=$'\t' read -r typ name; do
           [[ -z $name ]] && continue
           if [[ $typ == dir ]]; then entries+=("$name" "📁 $name/"); else entries+=("$name" "📄 $name"); fi
         done < <(gh api "repos/$slug/contents/$path" --jq '.[] | "\(.type)\t\(.name)"' 2>/dev/null | sort -t$'\t' -k2)
         if [[ ${#entries[@]} -eq 0 ]]; then ui_msgbox "Cross-Repo" "Verzeichnis leer oder nicht abrufbar:\n/$path" "OK"; continue; fi
         entries+=("@up" "⬆ übergeordnetes Verzeichnis")
         name=$(ui_menu "Verzeichnis: /$path" "$slug" "${entries[@]}") || continue
         if [[ $name == "@up" ]]; then
           if [[ $path == */* ]]; then path=${path%/*}; else path=""; fi
           continue
         fi
         typ=$(gh api "repos/$slug/contents/${path:+$path/}$name" --jq .type 2>/dev/null)
         if [[ $typ == dir ]]; then path="${path:+$path/}$name"
         else
           : >"$out"
           gh api "repos/$slug/contents/${path:+$path/}$name" -H 'Accept: application/vnd.github.raw' >"$out" 2>&1
           ui_textbox "Datei: ${path:+$path/}$name" "$out"
         fi ;;
      f) name=$(ui_inputbox "Datei öffnen" "Pfad im Repo (z. B. src/main/java/…):" "$path") || continue
         [[ -z $name ]] && continue
         : >"$out"
         gh api "repos/$slug/contents/$name" -H 'Accept: application/vnd.github.raw' >"$out" 2>&1
         ui_textbox "Datei: $name" "$out" ;;
      u) if [[ $path == */* ]]; then path=${path%/*}; else path=""; fi ;;
      i) : >"$out"; cap "$out" gh issue list --repo "$slug" --limit 40; ui_textbox "Issues: $slug" "$out" ;;
      p) : >"$out"; cap "$out" gh pr list --repo "$slug" --limit 40; ui_textbox "PRs: $slug" "$out" ;;
      r) : >"$out"; cap "$out" gh release list --repo "$slug" --limit 20; ui_textbox "Releases: $slug" "$out" ;;
      m) : >"$out"; gh api "repos/$slug/readme" -H 'Accept: application/vnd.github.raw' >"$out" 2>&1; ui_textbox "README: $slug" "$out" ;;
      k) run_live "Klonen: $slug" gh repo clone "$slug" ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------ gh-Auth tief --
auth_deep_menu() {
  local sel out="$TMPDIR_PRP/auth.out" f
  while :; do
    sel=$(ui_menu "gh-Auth & Zugänge" "Konto: $(gh api user --jq .login 2>/dev/null || echo 'nicht eingeloggt')" \
      "s" "📄 Status (gh auth status)" \
      "r" "🔄 Auth erneuern / Scopes (gh auth refresh)" \
      "g" "🔧 Git-Integration (gh auth setup-git)" \
      "t" "🔑 SSH-Test (ssh -T git@github.com)" \
      "k" "🔑 SSH-Key hochladen (gh ssh-key add)" \
      "l" "🔒 Token-Info (maskiert, mit Scopes)" \
      "w" "👥 Konto wechseln (gh auth switch)" \
      "n" "＋ Neu einloggen (gh auth login)" \
      "z" "↩ zurück") || return 0
    case $sel in
      s) : >"$out"; cap "$out" gh auth status; ui_textbox "gh auth status" "$out" ;;
      r) run_live "gh auth refresh" gh auth refresh ;;
      g) : >"$out"; cap "$out" gh auth setup-git; ui_textbox "setup-git" "$out" ;;
      t) : >"$out"; cap "$out" ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 || true
         ui_textbox "SSH-Test" "$out" ;;
      k) f=$(ui_inputbox "SSH-Key" "Pfad zum öffentlichen Schlüssel:" "$HOME/.ssh/id_ed25519.pub") || continue
         [[ -f $f ]] || { ui_msgbox "SSH-Key" "Datei nicht gefunden:\n$f" "OK"; continue; }
         run_live "SSH-Key hochladen" gh ssh-key add "$f" --title "$(hostname)" ;;
      l) : >"$out"; cap "$out" bash -c 'gh auth status --show-token 2>&1 | sed -E "s/(gh[oprsu]_)[A-Za-z0-9_]+/\1…/g"'
         ui_textbox "Token (maskiert)" "$out" ;;
      w) run_live "gh auth switch" gh auth switch ;;
      n) run_live "gh auth login" gh auth login ;;
      z|"") return 0 ;;
    esac
  done
}

# ------------------------------------------------------------ GitHub tief --
github_deep_menu() {
  local sel
  while :; do
    sel=$(ui_menu "GitHub vertieft" "Analyse, Suche, Security, API   ${SEP}   $REPO_SLUG" \
      "a" "🔬 PR-Analyse (Commits, Threads, Patch, Checks)" \
      "d" "📊 Dashboards: meine PRs/Issues, Review-Anfragen" \
      "m" "🎯 Meilensteine verwalten" \
      "i" "📋 Issues vertieft (Timeline, Vorlagen, Statistik)" \
      "s" "🛡️ Security & Dependabot" \
      "n" "📈 Insights (PR-Statistik, Aktivität, Traffic)" \
      "l" "🌐 Öffnen & Links (Browser + Zwischenablage)" \
      "x" "🧪 API-Explorer (gh api)" \
      "r" "🗂️ Cross-Repo-Browser (ohne Klonen)" \
      "h" "🔑 gh-Auth: refresh, SSH-Test, Keys" \
      "z" "↩ zurück") || return 0
    case $sel in
      a) pr_analysis ;;
      d) dashboards_menu ;;
      m) milestones_deep_menu ;;
      i) issue_deep_menu ;;
      s) security_menu ;;
      n) insights_menu ;;
      l) links_menu ;;
      x) api_explorer ;;
      r) cross_repo_browser ;;
      h) auth_deep_menu ;;
      z|"") return 0 ;;
    esac
  done
}

