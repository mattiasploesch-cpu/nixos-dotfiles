border2_color             = (BLACK,WHITE,OFF)
button_active_color       = (WHITE,BLACK,OFF)
button_inactive_color     = (BLACK,WHITE,OFF)
button_key_active_color   = (YELLOW,BLACK,OFF)
button_key_inactive_color = (BLUE,WHITE,OFF)
