border2_color             = (BLUE,BLACK,OFF)
button_active_color       = (WHITE,BLUE,OFF)
button_inactive_color     = (WHITE,BLUE,OFF)
button_key_active_color   = (YELLOW,BLUE,OFF)
button_key_inactive_color = (YELLOW,BLUE,OFF)
button_label_active_color = (WHITE,BLUE,OFF)
button_label_inactive_color = (WHITE,BLUE,OFF)
item_color                = (WHITE,BLACK,OFF)
item_selected_color       = (WHITE,BLUE,OFF)
tag_color                 = (WHITE,BLACK,OFF)
tag_key_color             = (YELLOW,BLACK,OFF)
tag_selected_color        = (WHITE,BLUE,OFF)
tag_key_selected_color    = (YELLOW,BLUE,OFF)
check_color               = (WHITE,BLACK,OFF)
check_selected_color      = (WHITE,BLUE,OFF)
