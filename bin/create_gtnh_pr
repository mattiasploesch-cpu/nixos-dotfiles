cleanup() {
  [[ -n "$TMPDIR_PRP" && -d "$TMPDIR_PRP" ]] && rm -rf "$TMPDIR_PRP"
  tput cnorm 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM
setup_dialog_theme

# ============================================================================
#  Grundfunktionen
# ============================================================================

die() { printf '\n%s\n\n' "$*" >&2; exit 1; }

preflight() {
  [[ -t 0 && -t 1 ]] || die "Bitte in einem echten Terminal ausführen (TUI benötigt eine Konsole)."
  [[ "$(id -u)" -eq 0 ]] && die "Bitte NICHT als root ausführen! git und gh müssen als dein Benutzer laufen."
  local c
  for c in dialog git gh; do
    command -v "$c" >/dev/null 2>&1 || die "Benötigtes Programm fehlt: $c
Installieren z. B.:  sudo pacman -S dialog git github-cli   (oder apt/dnf-Pendant)"
  done
  local cols lines
  cols=$(term_cols); lines=$(term_lines)
  if (( cols < 62 || lines < 17 )); then
    die "Terminal zu klein (${cols}x${lines}). Benötigt: mind. 62x17."
  fi
  if ! command -v fzf >/dev/null 2>&1; then
    ui_note_fzf_missing=1
  fi
}

term_cols() { local c; c=$(tput cols 2>/dev/null); [[ "$c" =~ ^[0-9]+$ ]] || c=80; printf '%s' "$c"; }
term_lines() { local l; l=$(tput lines 2>/dev/null); [[ "$l" =~ ^[0-9]+$ ]] || l=24; printf '%s' "$l"; }

# Breite/Höhe für große Widgets (bei jedem Aufruf frisch berechnet)
ui_w() { local c; c=$(term_cols); (( c -= 6 )); (( c > 100 )) && c=100; (( c < 60 )) && c=60; printf '%s' "$c"; }
ui_h() { local l; l=$(term_lines); (( l -= 8 )); (( l > 28 )) && l=28; (( l < 10 )) && l=10; printf '%s' "$l"; }
menu_rows() { local n=$1 m; m=$(term_lines); (( m -= 8 )); (( m > n )) && m=$n; (( m < 3 )) && m=3; printf '%s' "$m"; }

# Unicode nur bei UTF-8-Locale, sonst ASCII-Fallback
if [[ "$(locale charmap 2>/dev/null)" == "UTF-8" ]]; then
  ICON_OK="✔"; ICON_TODO="○"; ICON_WARN="⚠"; SEP="│"
else
  ICON_OK="[x]"; ICON_TODO="[ ]"; ICON_WARN="[!]"; SEP="|"
fi

backtitle() {
  local ctx="kein Repo gewählt"
  [[ -n "$REPO_NAME" ]] && ctx="$REPO_NAME  $SEP  Branch: $CURRENT_BRANCH"
  printf ' create_gtnh_pr v%s  %s  %s  PR-Checkliste Schritt für Schritt ' "$VERSION" "$SEP" "$ctx"
}

dlg() { dialog --colors --backtitle "$(backtitle)" --stdout "$@"; }

# --- kleine UI-Wrapper ------------------------------------------------------
ui_msgbox()  { dlg --title "$1" --ok-label "${3:-Weiter}" --msgbox "$2" 0 0; }
ui_yesno()   { dlg --title "$2" --yes-label "${3:-Ja}" --no-label "${4:-Nein}" --yesno "$1" 0 0; }
ui_textbox() { dlg --title "$1" --ok-label "${3:-Weiter}" --textbox "$2" "$(ui_h)" "$(ui_w)"; }
ui_inputbox(){ local t=$1 txt=$2 init=${3:-}; dlg --title "$t" --inputbox "$txt" 10 "$(ui_w)" "$init"; }

# ============================================================================
#  Ausführ-Helfer
# ============================================================================

# Befehlszeile lesbar zitieren
cmdline() {
  local s="" a
  for a in "$@"; do s+="$(printf '%q' "$a") "; done
  printf '%s' "${s% }"
}

# Befehl ausführen, Ausgabe in Datei anhängen, Exit-Code zurückgeben
cap() {
  local out=$1; shift
  printf '$ %s\n' "$(cmdline "$@")" >>"$out"
  "$@" >>"$out" 2>&1
  local rc=$?
  printf '\n[Exit-Code: %d]\n\n' "$rc" >>"$out"
  return $rc
}

# Befehl LIVE im Terminal ausführen (für interaktive Befehle wie git push,
# gh repo fork ...), danach Enter zum Zurückkehren zur TUI.
run_live() {
  local banner=$1; shift
  dialog --clear || true
  printf '\n\033[1;36m==> %s\033[0m\n' "$banner"
  printf '\033[1;36m==> %s\033[0m\n\n' "$(cmdline "$@")"
  "$@"
  local rc=$?
  printf '\n\033[1;33m(--> Exit-Code: %d — Enter drücken, um zur TUI zurückzukehren) \033[0m' "$rc"
  read -r _
  return $rc
}

join_by() {
  local sep=$1; shift
  local out="" a
  for a in "$@"; do out+="${out:+$sep}$a"; done
  printf '%s' "$out"
}

pick_editor() {
  if [[ -n "${EDITOR:-}" ]] && command -v "${EDITOR%% *}" >/dev/null 2>&1; then
    printf '%s' "$EDITOR"; return
  fi
  local e
  for e in nano vim vi; do
    command -v "$e" >/dev/null 2>&1 && { printf '%s' "$e"; return; }
  done
  printf 'vi'
}

open_editor() {  # Datei
  local bin; bin=$(nvim_bin)
  dialog --clear || true
  if [[ -n "$bin" ]]; then
    printf '\033[1;36m==> nnvim: %s\033[0m\n\n' "$1"
    sleep 0.4
    if [[ $bin == nnvim ]]; then nnvim "$1"; else NVIM_APPNAME=nnvim nvim "$1"; fi
  else
    local ed; ed=$(pick_editor)
    printf '\033[1;36m==> Editor (%s): %s\033[0m\n\n' "$ed" "$1"
    sleep 0.4
    $ed "$1"
  fi
}
# ============================================================================
#  Git-/Status-Helfer
# ============================================================================

detect_default_branch() {
  local b
  b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  if [[ -z "$b" ]]; then
    if git show-ref --verify --quiet refs/heads/main; then b=main; else b=master; fi
  fi
  printf '%s' "$b"
}

refresh_state() {
  REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")
  CURRENT_BRANCH=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
  [[ -z "$CURRENT_BRANCH" ]] && CURRENT_BRANCH="(detached HEAD)"
  DEFAULT_BRANCH=$(detect_default_branch)
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo "")
  if [[ -n "$UPSTREAM" ]]; then
    AHEAD_BEHIND=$(git rev-list --left-right --count '@{u}...HEAD' 2>/dev/null | awk '{printf "↓%s ↑%s", $1, $2}')
  else
    AHEAD_BEHIND="kein Upstream gesetzt"
  fi
  REPO_SLUG=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || echo "")
}

has_changes() { [[ -n "$(git status --porcelain 2>/dev/null)" ]]; }
has_staged()  { [[ -n "$(git diff --cached --name-only 2>/dev/null)" ]]; }
staged_count(){ git diff --cached --name-only 2>/dev/null | wc -l | tr -d ' '; }

# Ausgabe: "XY<TAB>pfad" (eine Zeile pro veränderter Datei, duplikatfrei)
changed_files() {
  local raw
  raw=$(git -c core.quotepath=false status --porcelain 2>/dev/null) || return 1
  local line xy rest
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    xy=${line:0:2}; rest=${line:3}
    [[ $rest == *" -> "* ]] && rest=${rest##* -> }
    [[ $rest == \"*\" ]] && rest=${rest:1:${#rest}-2}
    printf '%s\t%s\n' "$xy" "$rest"
  done <<<"$raw" | awk -F'\t' '!seen[$2]++'
}

code_word() {
  case $1 in
    M) echo 'geändert' ;; A) echo 'neu' ;; D) echo 'gelöscht' ;;
    R) echo 'umbenannt' ;; C) echo 'kopiert' ;; T) echo 'Typ geändert' ;;
    U) echo 'KONFLIKT' ;; '?') echo 'neu (untracked)' ;; *) echo "$1" ;;
  esac
}

describe_xy() {
  local xy=$1 x=${1:0:1} y=${1:1:1} p=()
  [[ $xy == '??' ]] && { printf 'neu (untracked)'; return; }
  case ${x}${y} in *U*|AA|DD|DD) printf '%s' "${C_R}KONFLIKT – bitte zuerst lösen!${C_N}"; return ;; esac
  [[ $x != ' ' && $x != '?' ]] && p+=("gestaged: $(code_word "$x")")
  [[ $y != ' ' && $y != '?' ]] && p+=("offen: $(code_word "$y")")
  if (( ${#p[@]} == 0 )); then printf 'unverändert'; else join_by ', ' "${p[@]}"; fi
}

git_status_short() { git -c color.ui=never status -sb 2>&1; }

# ============================================================================
#  fzf-Dateiauswahl mit exakter Diff-Vorschau (injektionssicher über Index)
# ============================================================================

FILES_TSV=""      # Zeile N: XY<TAB>pfad
FZF_ITEMS=""      # Zeile N: "N<TAB>XY<TAB>pfad"  (was fzf anzeigt)
PREVIEW_SH=""

make_preview_sh() {
  PREVIEW_SH="$TMPDIR_PRP/fzf_preview.sh"
  cat >"$PREVIEW_SH" <<'EOS'
#!/usr/bin/env bash
# Vorschau für fzf:  $1 = Index in der TSV   $2 = TSV-Datei (XY<TAB>pfad)
idx=$1
tsv=$2
entry=$(sed -n "${idx}p" "$tsv")
st=${entry%%$'\t'*}; p=${entry#*$'\t'}
w=$(tput cols 2>/dev/null || echo 80); (( w > 110 )) && w=110
rule() { printf '%s\n' "────────────────────────────────────────────────────────────────"; }
printf '\033[1;36m\033[0m'
printf '\033[1;37m %s\033[0m\n' "$p"
printf ' Status: %s\n' "$st"
rule
if [[ $st == "??" ]]; then
  printf '\033[1;33m(untracked – noch nicht von git verfolgt, Vorschau = Dateiinhalt)\033[0m\n'
  rule
  if [[ -d $p ]]; then ls -la -- "$p" | head -n 80; else head -n 500 -- "$p"; fi
  exit 0
fi
if [[ ${st:0:1} != ' ' && ${st:0:1} != '?' ]]; then
  printf '\033[1;32m### GESTAGTE Änderungen (git diff --cached) ###\033[0m\n'
  rule
  git diff --cached --color=always -- "$p"
  rule
fi
if [[ ${st:1:1} != ' ' && ${st:1:1} != '?' ]]; then
  printf '\033[1;33m### NOCH NICHT GESTAGTE Änderungen (git diff) ###\033[0m\n'
  rule
  git diff --color=always -- "$p"
fi
EOS
  chmod +x "$PREVIEW_SH"
}

# Dateiliste aufbauen; $1 = Quelle ("changed" oder "staged")
build_file_list() {
  local src=$1
  FILES_TSV="$TMPDIR_PRP/files.tsv"
  FZF_ITEMS="$TMPDIR_PRP/fzf_items.txt"
  if [[ $src == "changed" ]]; then
    changed_files >"$FILES_TSV"
  else
    git diff --cached --name-only -z 2>/dev/null | while IFS= read -r -d '' f; do
      printf 'A \t%s\n' "$f"
    done >"$FILES_TSV"
  fi
  [[ -s "$FILES_TSV" ]] || return 1
  awk -F'\t' -v OFS='\t' '{printf "%d\t%s\t%s\n", NR, $1, $2}' "$FILES_TSV" >"$FZF_ITEMS"
}

fzf_available() { command -v fzf >/dev/null 2>&1; }

FZF_BASE=(--ansi --height=92% --layout=reverse --border=rounded --info=inline
  --color='bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#b4befe,fg:#cdd6f4,header:#b4befe,info:#cba6f7,pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#b4befe,border:#b4befe,preview-bg:#181825,preview-fg:#cdd6f4')
[[ "$ICON_OK" == "✔" ]] && FZF_BASE+=(--pointer='▶' --marker='✔')

# fzf auf Dateiliste laufen lassen. $1=changed|staged  $2=multi|one  $3=Header
# Ausgabe: ausgewählte Einträge aus FILES_TSV (XY<TAB>pfad), eine pro Zeile
fzf_select_files() {
  local src=$1 mode=$2 hdr=$3
  build_file_list "$src" || return 1
  make_preview_sh
  local opts=(--delimiter='\t' --with-nth=2,3 --header="$hdr"
              --preview="\"$PREVIEW_SH\" {1} \"$FILES_TSV\"")
  [[ $mode == "multi" ]] && opts+=(--multi)
  FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" "${opts[@]}" <"$FZF_ITEMS" \
    | awk -F'\t' '{print $1}' \
    | while read -r idx; do sed -n "${idx}p" "$FILES_TSV"; done
}

# Generische fzf-Auswahl über eine TSV mit Vorschauscript.
# $1=TSV-Datei  $2=Vorschaubefehln (schon fertig gequotet)  $3=Header  $4=multi|one
fzf_indexed() {
  local tsv=$1 prev=$2 hdr=$3 mode=$4 items="${1}.items"
  awk -F'\t' -v OFS='\t' '{printf "%d\t%s\n", NR, $0}' "$tsv" >"$items"
  [[ -s "$items" ]] || return 1
  local opts=(--delimiter='\t' --with-nth=2.. --header="$hdr")
  [[ -n $prev ]] && opts+=(--preview="$prev")
  [[ $mode == "multi" ]] && opts+=(--multi)
  FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" "${opts[@]}" <"$items" \
    | awk -F'\t' '{print $1}' \
    | while read -r idx; do sed -n "${idx}p" "$tsv"; done
}

# fzf-Auswahl für Listen mit Nummer in Spalte 1 ("123<TAB>Titel...")
# $1=Header  $2=Vorschau-Template (verwendet {1}, z. B. 'gh issue view {1}')  $3=multi?
fzf_num() {
  local hdr=$1 prev=${2:-} multi=${3:-}
  local opts=(--delimiter='\t' --with-nth=2.. --header="$hdr")
  [[ -n $prev ]] && opts+=(--preview="$prev" --preview-window='down,55%,wrap')
  [[ $multi == multi ]] && opts+=(--multi)
  FZF_DEFAULT_OPTS="" fzf "${FZF_BASE[@]}" "${opts[@]}"
}

# ============================================================================
#  Repo-Auswahl + Hauptmenü
# ============================================================================

pick_repo() {
  local repos=() p sel args=()
  while IFS= read -r p; do repos+=("$p"); done < <(
    find "$START_DIR" -maxdepth 2 -name .git -print 2>/dev/null | sed 's#/\.git$##' | sort -u
  )
  if (( ${#repos[@]} == 0 )); then
    ui_msgbox "GTNH PR-Assistent" "In ${C_C}$START_DIR${C_N}\n\nwurden keine Git-Repositories gefunden.\n\nStarte das Skript in dem Ordner, in dem deine Repos liegen." "OK"
    return 1
  fi
  if (( ${#repos[@]} == 1 )); then
    sel=${repos[0]}
    ui_yesno "Repository gefunden:\n\n${C_C}$sel${C_N}\n\nDamit arbeiten?" "Repo auswählen" || return 1
  else
    for p in "${repos[@]}"; do
      args+=("$p" "${p#"$START_DIR"/}")
    done
    sel=$(dlg --title "Repo auswählen" --cancel-button "Beenden" \
          --menu "Git-Repositories in $START_DIR:" "$(ui_h)" "$(ui_w)" "$(menu_rows ${#repos[@]})" \
          "${args[@]}") || return 1
  fi
  cd -- "$sel" || return 1
  refresh_state
  return 0
}

show_repo_intro() {
  local f="$TMPDIR_PRP/intro.txt"
  { echo "Repo:            $REPO_NAME${REPO_SLUG:+  ($REPO_SLUG)}"
    echo "Aktueller Branch: $CURRENT_BRANCH"
    echo "Standard-Branch:  $DEFAULT_BRANCH"
    echo "Upstream:         ${UPSTREAM:-(keiner)}    ${AHEAD_BEHIND}"
    echo
    echo "--- git status ---"
    git_status_short
    echo
    echo "--- Remotes ---"
    git remote -v
  } >"$f"
  ui_textbox "Repo-Info: $REPO_NAME" "$f" "Los geht's"
}

pr_state_text() {
  [[ -z "$REPO_SLUG" ]] && { printf -- '-'; return; }
  gh pr view --json number,state,mergeable -q 'if .number then "#\(.number) [\(.state)]" else "kein PR für diesen Branch" end' 2>/dev/null || printf -- '-'
}

main_menu_text() {
  local dirty="sauber"
  has_changes && dirty="${C_Y}uncommittete Änderungen${C_N}"
  printf '%s\n\n' "${C_C}GT New Horizons — PR-Assistent${C_N}"
  printf 'Repo:     %s   %s   Branch: %s\n' "$REPO_NAME" "$SEP" "$CURRENT_BRANCH"
  printf 'Basis:    %s   %s   Status: %s\n' "$DEFAULT_BRANCH" "$SEP" "$dirty"
  printf 'PR:       %s\n\n' "$(pr_state_text)"
  printf '%s = erledigt (diese Sitzung), %s = offen. Alle Schritte folgen der PR-Checkliste.\n' "$ICON_OK" "$ICON_TODO"
}

TOTAL_STEPS=12
STEP_TITLES=(
  "Repo aktualisieren (gh repo sync / git pull)"
  "Branch anlegen oder auswählen"
  "Änderungen machen (nnvim öffnet den Ordner)"
  "Stagen – nur gewollte Dateien (mit Diff-Vorschau)"
  "Kontrolle: Status + gestagter Diff"
  "Commit schreiben"
  "Fork / Remote einrichten (gh repo fork)"
  "Branch pushen"
  "Pull Request erstellen (gh pr create)"
  "PR prüfen: Diff, Kommentare, Checks"
  "PR-Branch aktualisieren (gh pr update-branch)"
  "Aufräumen nach dem Merge"
)
step_title() { printf '%s' "${STEP_TITLES[$1-1]}"; }
step_dtitle() { printf 'Schritt %s/12: %s' "$1" "$(step_title "$1")"; }

main_menu() {
  local args=() n mark
  for ((n=1; n<=TOTAL_STEPS; n++)); do
    if [[ -n "${DONE[$n]:-}" ]]; then mark="${C_G}${ICON_OK}${C_N}"; else mark="${ICON_TODO}"; fi
    args+=("$n" "$mark $n. $(step_title "$n")")
  done
  args+=("e" "★ Extras: GitHub-Allrounder, git-Werkzeuge, Diffs, Checkliste, Shell")
  args+=("r" "⟳ Anderes Repository wählen")
  args+=("q" "Beenden")
  dlg --title "GTNH PR-Assistent v$VERSION" --cancel-button "Beenden" \
      --menu "$(main_menu_text)" "$(ui_h)" "$(ui_w)" "$(menu_rows 15)" "${args[@]}"
}

run_steps() {
  local n=$1 next
  while :; do
    if "step_$n"; then
      DONE[$n]=1
      next=$((n+1))
      # Nach einem Merge in Schritt 10 ist "update-branch" (11) hinfällig
      if [[ $n == 10 && ${STEP10_MERGED:-0} == 1 ]]; then DONE[11]=1; next=12; fi
      if (( next <= TOTAL_STEPS )); then
        ui_yesno "${C_G}${ICON_OK} Schritt $n abgeschlossen.${C_N}\n\nNächster Schritt $next:\n${C_C}$(step_title "$next")${C_N}\n\nDirekt weitermachen?" \
                 "GTNH PR-Assistent" "Weiter: $next" "Menü" || return 0
        n=$next; continue
      else
        ui_msgbox "GTNH PR-Assistent" "${C_G}${ICON_OK} Alle 12 Schritte durchlaufen!${C_N}\n\nFalls dein PR schon gemergt wurde: viel Erfolg, Matse!"
      fi
    fi
    return 0
  done
}

# ============================================================================
#  Gemeinsame Schritt-Helfer
# ============================================================================

ui_menu() {  # title text tag1 item1 tag2 item2 ...
  local t=$1 txt=$2; shift 2
  dlg --title "$t" --cancel-button "Zurück" --menu "$txt" "$(ui_h)" "$(ui_w)" "$(menu_rows $(( $# / 2 )))" "$@"
}

ask_number() {  # prompt title [init]
  local v
  while :; do
    v=$(ui_inputbox "$2" "$1" "${3:-}") || return 1
    v=${v//[[:space:]]/}
    [[ $v =~ ^[0-9]+$ ]] && { printf '%s' "$v"; return 0; }
    ui_msgbox "$2" "Bitte eine gültige Nummer eingeben." "OK"
  done
}

# Befehl nach Bestätigung ausführen, Ausgabe in Textbox zeigen
cmd_confirm_run() {  # title outfile cmd...
  local title=$1 out=$2; shift 2
  ui_yesno "Befehl ausführen?\n\n${C_C}$(cmdline "$@")${C_N}" "$title" "Ausführen" "Abbrechen" || return 1
  : >"$out"
  cap "$out" "$@"
  local rc=$?
  ui_textbox "$title — Ausgabe" "$out"
  return $rc
}

# Lokales Update: fetch → checkout Standard-Branch → pull
run_local_update() {  # outfile
  : >"$1"
  cap "$1" git fetch origin || return 1
  refresh_state
  cap "$1" git checkout "$DEFAULT_BRANCH" || return 1
  cap "$1" git pull origin "$DEFAULT_BRANCH" || return 1
  refresh_state
  return 0
}

view_one_diff() {
  local sel f out="$TMPDIR_PRP/one.diff"
  sel=$(fzf_select_files changed one 'ENTER = Datei ansehen  |  rechts: exakter Diff') || return
  [[ -z "$sel" ]] && return
  f=${sel#*$'\t'}
  {
    printf 'Datei: %s\n\n' "$f"
    if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
      echo "── untracked – Dateiinhalt (Anfang) ──"
      head -n 400 -- "$f" 2>/dev/null || echo "(nicht lesbar)"
    else
      if ! git diff --cached --quiet -- "$f" 2>/dev/null; then
        echo "── GESTAGTE Änderungen ──"; git --no-pager diff --cached --color=never -- "$f"; echo
      fi
      if ! git diff --quiet -- "$f" 2>/dev/null; then
        echo "── NOCH OFFENE Änderungen ──"; git --no-pager diff --color=never -- "$f"
      fi
    fi
  } >"$out"
  ui_textbox "Diff: $f" "$out"
}

view_full_diff() {
  local out="$TMPDIR_PRP/full.diff"
  {
    echo "══ git status ══"; git_status_short; echo
    echo "══ git diff --stat (offen + gestaged) ══"; git --no-pager diff --stat; git --no-pager diff --cached --stat; echo
    echo "══ OFFENE Änderungen (git diff) ══"; git --no-pager diff --color=never; echo
    echo "══ GESTAGTE Änderungen (git diff --cached) ══"; git --no-pager diff --cached --color=never
  } >"$out"
  ui_textbox "Alle Änderungen — exakter Diff" "$out"
}

# --- nnvim -------------------------------------------------------------------
nvim_bin() {
  if command -v nvim >/dev/null 2>&1; then printf 'nvim'
  elif command -v nnvim >/dev/null 2>&1; then printf 'nnvim'
  else printf ''; fi
}

open_nn_folder() {  # Ordner/Datei mit nnvim (NVIM_APPNAME=nnvim) öffnen
  local bin; bin=$(nvim_bin)
  if [[ -z "$bin" ]]; then
    ui_msgbox "nnvim" "nvim wurde nicht gefunden — Fallback auf \$EDITOR." "OK"
    open_editor "$1"; return
  fi
  dialog --clear || true
  printf '\n\033[1;36m==> nnvim (deine Config):  %s\033[0m\n\n' "$1"
  printf '    Beenden mit  :q  — danach geht es hier im Assistenten weiter.\n\n'
  sleep 0.6
  if [[ $bin == nnvim ]]; then nnvim "$1"; else NVIM_APPNAME=nnvim nvim "$1"; fi
}

# ============================================================================
#  SCHRITT 1–6
# ============================================================================

step_1() {
  local out="$TMPDIR_PRP/step1.out" sel
  while :; do
    sel=$(ui_menu "$(step_dtitle 1)" \
      "Branch: ${C_C}$CURRENT_BRANCH${C_N}   Basis: ${C_C}$DEFAULT_BRANCH${C_N}   Fork: ${REPO_SLUG:-unbekannt}\n\nDie Checkliste sagt: fetch → checkout $DEFAULT_BRANCH → pull." \
      "a" "1a) Lokal aktualisieren (fetch, checkout $DEFAULT_BRANCH, pull)   ← klassisch" \
      "b" "1b) Fork auf GitHub syncen (gh repo sync)" \
      "c" "1c) Beides: erst GitHub-Fork syncen, dann lokal pullen" \
      "i" "1i) Nur Status/Info anzeigen" \
      "z" "↩ Zurück") || return 1
    case $sel in
      i)
        : >"$out"; cap "$out" git status -sb; cap "$out" git remote -v; ui_textbox "$(step_dtitle 1) — Info" "$out"; continue ;;
      z) return 1 ;;
      b|c)
        : >"$out"
        if ! cap "$out" gh repo sync; then
          ui_textbox "$(step_dtitle 1) — gh repo sync" "$out"
          ui_msgbox "gh repo sync" "Fehlgeschlagen.\n\nMögliche Gründe: origin ist kein Fork (dann nur '1a' nutzen), oder gh ist nicht eingeloggt (Extras → gh-Konto)." "OK"
          continue
        fi
        ui_textbox "$(step_dtitle 1) — gh repo sync" "$out" ;;
    esac
    if [[ $sel == a || $sel == c ]]; then
      if ! run_local_update "$out"; then
        ui_textbox "$(step_dtitle 1) — Update-Ausgabe" "$out"
        ui_msgbox "Update" "Fehlgeschlagen (siehe Ausgabe).\n\nHäufige Ursachen:\n• uncommittete Änderungen blockieren den Checkout\n• Konflikt beim Pull\n• kein Netz / kein Zugriff\n\nTipp: Schritt 3 (bearbeiten) und Schritt 6 (Commit) nutzen, dann erneut versuchen." "OK"
        continue
      fi
      ui_textbox "$(step_dtitle 1) — Update-Ausgabe" "$out"
    fi
    ui_msgbox "$(step_dtitle 1)" "${C_G}${ICON_OK} Repo ist aktuell.${C_N}\n\nBranch: $CURRENT_BRANCH\nHEAD:    $(git log -1 --format='%h %s' 2>/dev/null)" "Weiter"
    return 0
  done
}

step_2() {
  local sel name out="$TMPDIR_PRP/step2.out" args=() b
  while :; do
    sel=$(ui_menu "$(step_dtitle 2)" \
      "Aktueller Branch: ${C_C}$CURRENT_BRANCH${C_N}\n\nBranch-Name kurz + aussagekräftig, z. B. fix-mapiary-crash, add-quest-xyz." \
      "n" "2a) ✔ Neuen Feature-Branch anlegen (git checkout -b)" \
      "p" "2b) Bestehenden PR auschecken (gh pr checkout)" \
      "w" "2c) Bestehenden lokalen Branch wechseln (git checkout)" \
      "z" "↩ Zurück") || return 1
    case $sel in
      n) break ;;
      p)
        local pline
        pline=$(gh pr list --limit 40 --json number,title,headRefName,isDraft \
                 --template '{{range .}}{{printf "%v\t%s\t[%s]%s\n" .number .title .headRefName (if .isDraft " DRAFT" "")}}{{end}}' 2>/dev/null)
        if [[ -z "$pline" ]]; then ui_msgbox "gh pr checkout" "Keine offenen PRs gefunden (oder gh-Fehler — prüfe Extras → gh-Konto)." "OK"; continue; fi
        pline=$(printf '%s\n' "$pline" | fzf_num 'PR wählen – ENTER = auschecken' 'gh pr view {1}') || continue
        local pr=${pline%%$'\t'*}
        [[ -z "$pr" ]] && continue
        run_live "gh pr checkout $pr" gh pr checkout "$pr" && { refresh_state; ui_msgbox "$(step_dtitle 2)" "${C_G}${ICON_OK} PR #$pr ausgecheckt. Branch: $CURRENT_BRANCH${C_N}" "Weiter"; return 0; }
        continue ;;
      w)
        while IFS= read -r b; do
          [[ $b == "$CURRENT_BRANCH" ]] || args+=("$b" "$b")
        done < <(git for-each-ref --format='%(refname:short)' refs/heads | sort)
        if (( ${#args[@]} == 0 )); then ui_msgbox "Branch wechseln" "Kein anderer lokaler Branch vorhanden." "OK"; continue; fi
        b=$(ui_menu "$(step_dtitle 2)" "Zu welchem Branch wechseln?" "${args[@]}") || continue
        if ! cmd_confirm_run "$(step_dtitle 2)" "$out" git checkout "$b"; then continue; fi
        refresh_state
        ui_msgbox "$(step_dtitle 2)" "Jetzt auf Branch: ${C_C}$CURRENT_BRANCH${C_N}" "Weiter"
        return 0 ;;
    esac
  done
  # Name für neuen Branch
  while :; do
    name=$(ui_inputbox "$(step_dtitle 2)" "Name für den neuen Branch (kurz + aussagekräftig):" "$LAST_BRANCH_NAME") || return 1
    name=${name// /-}
    if [[ -z "$name" ]]; then ui_msgbox "Branch" "Bitte einen Namen eingeben." "OK"; continue; fi
    if [[ $name == "$DEFAULT_BRANCH" || $name == main ]]; then
      ui_msgbox "Branch" "${C_R}Das ist der Standard-Branch!${C_N} PRs brauchen immer einen Feature-Branch." "OK"; continue
    fi
    LAST_BRANCH_NAME=$name
    if git show-ref --verify --quiet "refs/heads/$name"; then
      if ui_yesno "Der Branch ${C_C}$name${C_N} existiert bereits.\n\nStattdessen dorthin wechseln?" "Branch vorhanden" "Wechseln" "Nein"; then
        cmd_confirm_run "$(step_dtitle 2)" "$out" git checkout "$name" || continue
        refresh_state
        ui_msgbox "$(step_dtitle 2)" "${C_G}${ICON_OK} Auf Branch: $CURRENT_BRANCH${C_N}" "Weiter"
        return 0
      fi
      continue
    fi
    if ! cmd_confirm_run "$(step_dtitle 2)" "$out" git checkout -b "$name"; then continue; fi
    refresh_state
    ui_msgbox "$(step_dtitle 2)" "${C_G}${ICON_OK} Neuer Branch angelegt: $CURRENT_BRANCH${C_N}\n\nAb jetzt hier arbeiten — niemals direkt auf $DEFAULT_BRANCH pushen!" "Weiter"
    return 0
  done
}

step_3() {
  local sel out="$TMPDIR_PRP/step3.out"
  open_nn_folder "$PWD"
  while :; do
    : >"$out"; cap "$out" git status -sb
    ui_textbox "$(step_dtitle 3) — Zwischenkontrolle: was ist anders?" "$out"
    sel=$(ui_menu "$(step_dtitle 3)" "$REPO_NAME war gerade in nnvim offen." \
      "n" "3a) Nochmal in nnvim öffnen (Repo-Ordner)" \
      "d" "3b) Diff einer Datei ansehen (fzf-Picker, exakter Diff)" \
      "D" "3c) Gesamten Diff ansehen (offen + gestaged)" \
      "s" "3d) git status erneut anzeigen" \
      "S" "3e) Shell im Repo öffnen" \
      "w" "3f) ✔ Fertig – weiter zu Schritt 4 (Stagen)") || return 1
    case $sel in
      n) open_nn_folder "$PWD" ;;
      d) view_one_diff ;;
      D) view_full_diff ;;
      s) : >"$out"; cap "$out" git status -sb; ui_textbox "git status" "$out" ;;
      S) run_live "Shell im Repo ($PWD) — 'exit' kommt zurück zur TUI" "${SHELL:-/bin/bash}" ;;
      w)
        if ! has_changes; then
          ui_yesno "Es gibt noch keine Änderungen.\n\nTrotzdem weiter zum Stagen?" "$(step_dtitle 3)" "Trotzdem weiter" "Weiter bearbeiten" || continue
        fi
        return 0 ;;
    esac
  done
}

step_4() {
  local sel line p out="$TMPDIR_PRP/step4.out"
  has_changes || { ui_msgbox "$(step_dtitle 4)" "Keine Änderungen gefunden.\n\nGeh zurück zu Schritt 3 und bearbeite deine Dateien." "OK"; return 1; }
  while :; do
    if fzf_available; then
      sel=$(fzf_select_files changed multi 'TAB = markieren · CTRL-A = alle · ENTER = Auswahl stagen | Vorschau: exakter Diff') \
        || { ui_yesno "Auswahl abgebrochen.\n\nZurück zum Schritt-Menü?" "$(step_dtitle 4)" "Ja" "Nochmal" || return 1; continue; }
      if [[ -z "$sel" ]]; then
        ui_msgbox "$(step_dtitle 4)" "Keine Datei ausgewählt.\n\nTipp: mit TAB markieren (mehrere), CTRL-A = alle." "OK"; continue
      fi
    else
      sel=$(stage_checklist_fallback) || return 1
      [[ -z "$sel" ]] && { ui_msgbox "$(step_dtitle 4)" "Nichts ausgewählt." "OK"; continue; }
    fi
    : >"$out"
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      p=${line#*$'\t'}
      cap "$out" git add -- "$p"
    done <<<"$sel"
    { echo; echo "══ Kontrolle: git status ══"; git_status_short; echo
      echo "══ git diff --cached --stat ══"; git --no-pager diff --cached --stat; echo
      echo "══ vollständiger GESTAGTER Diff (kommt in den Commit) ══"; git --no-pager diff --cached --color=never; } >>"$out"
    ui_textbox "$(step_dtitle 4) — So sieht das Staging aus" "$out"
    sel=$(ui_menu "$(step_dtitle 4)" "Ist das Staging korrekt?   (gestagte Dateien: $(staged_count))" \
      "w" "4a) ✔ Weiter – Staging ist korrekt" \
      "a" "4b) Weitere/andere Dateien stagen (zurück zur Auswahl)" \
      "u" "4c) Einzelne gestagte Dateien wieder unstagen" \
      "U" "4d) ALLES unstagen (git reset)" \
      "z" "4e) ↩ Zurück") || return 1
    case $sel in
      w) return 0 ;;
      a) continue ;;
      u) unstage_picker ;;
      U) if ui_yesno "Wirklich ALLES aus dem Index nehmen?\n\nDeine Dateien bleiben unverändert, nur das Staging wird geleert." "Alles unstagen"; then
           git reset -q HEAD 2>/dev/null; ui_msgbox "Unstagen" "Index geleert." "OK"; fi ;;
      z) return 1 ;;
    esac
  done
}

stage_checklist_fallback() {
  local args=() line xy p
  while IFS= read -r line; do
    xy=${line%%$'\t'*}; p=${line#*$'\t'}
    args+=("$p" "[$xy] $(describe_xy "$xy")" off)
  done < <(changed_files)
  dlg --separate-output --title "$(step_dtitle 4)" --ok-label "Auswahl stagen" --cancel-button "Abbrechen" \
    --checklist "Nur die gewollten Dateien auswählen (Leertaste = an/aus). NIEMALS blind alles stagen!" \
    "$(ui_h)" "$(ui_w)" "$(menu_rows $(( ${#args[@]} / 3 )))" "${args[@]}" \
    | while IFS= read -r p; do printf 'X \t%s\n' "$p"; done
}

unstage_picker() {
  local sel line p
  sel=$(fzf_select_files staged multi 'TAB = markieren · ENTER = ausgewählte aus dem Index nehmen') || return
  [[ -z "$sel" ]] && return
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    p=${line#*$'\t'}
    git restore --staged -- "$p" 2>/dev/null || git reset -q HEAD -- "$p"
  done <<<"$sel"
}

step_5() {
  local out="$TMPDIR_PRP/step5.out" sel
  if ! has_staged; then
    ui_yesno "$(step_dtitle 5)" "Es ist noch ${C_Y}nichts gestaged${C_N}.\n\nJetzt Schritt 4 (Stagen) ausführen?" "Zu Schritt 4" "Abbrechen" || return 1
    step_4 || return 1
    has_staged || return 1
  fi
  { echo "══ git status ══"; git_status_short; echo
    echo "══ GESTAGTE Änderungen (das kommt in den Commit) ══"; git --no-pager diff --cached --color=never; } >"$out"
  ui_textbox "$(step_dtitle 5) — exakt die gewollten Dateien unter \"Changes to be committed\"?" "$out"
  while :; do
    sel=$(ui_menu "$(step_dtitle 5)" "Bereit für den Commit von $(staged_count) Datei(en)?" \
      "w" "5a) ✔ Alles korrekt – weiter zu Schritt 6 (Commit)" \
      "d" "5b) Einzelnen gestagten Datei-Diff ansehen" \
      "u" "5c) Einzelne Dateien unstagen" \
      "4" "5d) Staging anpassen (zurück zu Schritt 4)" \
      "z" "5e) ↩ Zurück") || return 1
    case $sel in
      w) return 0 ;;
      d) local f
         f=$(fzf_select_files staged one 'ENTER = Datei-Diff im Dialog anzeigen') || continue
         [[ -z "$f" ]] && continue
         f=${f#*$'\t'}
         git --no-pager diff --cached --color=never -- "$f" >"$out"
         ui_textbox "Gestagter Diff: $f" "$out" ;;
      u) unstage_picker; if ! has_staged; then ui_msgbox "$(step_dtitle 5)" "Jetzt ist nichts mehr gestaged — zurück zu Schritt 4." "OK"; return 1; fi ;;
      4) step_4 || return 1 ;;
      z) return 1 ;;
    esac
  done
}

step_6() {
  local msg msgfile="$TMPDIR_PRP/commit_msg.txt" out="$TMPDIR_PRP/step6.out" sel
  if ! has_staged; then
    ui_yesno "$(step_dtitle 6)" "Es ist nichts gestaged — es gäbe nichts zu committen.\n\nJetzt Schritt 4 (Stagen) ausführen?" "Zu Schritt 4" "Abbrechen" || return 1
    step_4 || return 1
    has_staged || return 1
  fi
  while :; do
    { echo "══ Das kommt in den Commit ($(staged_count) Datei(en)) ══"; echo; git --no-pager diff --cached --stat; } >"$out"
    ui_textbox "$(step_dtitle 6) — Kontrolle vor dem Commit" "$out"
    msg=$(ui_inputbox "$(step_dtitle 6)" "Commit-Message:\n\nKurz + Beschreibung, bei Issue-Fix mit Nummer z. B.:\n  Fix Mapiary crash (#26313)" "$msg") || return 1
    if [[ -z "${msg// }" ]]; then ui_msgbox "Commit" "Die Nachricht ist leer — bitte etwas eingeben." "OK"; continue; fi
    sel=$(ui_menu "$(step_dtitle 6)" "Nachricht:\n\n${C_C}$msg${C_N}\n\nSo committen?" \
      "c" "6a) ✔ Commit mit dieser Nachricht" \
      "e" "6b) Mehrzeilige Nachricht im Editor schreiben (git commit -F)" \
      "d" "6c) Gestagten Diff nochmal ansehen" \
      "r" "6d) Nachricht neu eingeben" \
      "z" "6e) ↩ Zurück") || return 1
    case $sel in
      d) git --no-pager diff --cached --color=never >"$out"; ui_textbox "Gestagter Diff" "$out"; continue ;;
      r) continue ;;
      z) return 1 ;;
      e)
        printf '%s\n' "$msg" >"$msgfile"
        open_editor "$msgfile"
        if [[ ! -s "$msgfile" || -z "$(tr -d '[:space:]' <"$msgfile")" ]]; then
          ui_msgbox "Commit" "Die Nachrichtendatei ist leer — abgebrochen." "OK"; continue
        fi
        : >"$out"
        cap "$out" git commit -F "$msgfile" ;;
      c)
        : >"$out"
        cap "$out" git commit -m "$msg" ;;
    esac
    ui_textbox "$(step_dtitle 6) — Commit-Ausgabe" "$out"
    if has_staged; then
      ui_msgbox "Commit" "${C_Y}Der Commit ist offenbar fehlgeschlagen${C_N} (Änderungen sind noch gestaged).\n\nHäufig: Hooks (z. B. spotless) haben gemeckert — lies die Ausgabe und versuche es erneut." "OK"
      continue
    fi
    refresh_state
    { echo "══ Neuester Commit ══"; git --no-pager log -1 --stat --decorate --color=never; } >"$out"
    ui_textbox "$(step_dtitle 6) — geschafft!" "$out"
    if ui_yesno "Commit rückgängig machen? (git reset --soft HEAD~1 — Änderungen bleiben gestaged)" "Undo" "Undo" "Nein, passt"; then
      git reset --soft HEAD~1 2>/dev/null
      refresh_state
      continue
    fi
    return 0
  done
}

